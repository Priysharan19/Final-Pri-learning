node_modules/
client/dist/
.venv/
.venv-ink/
.venv-ink-export/
server/data/*.db
# SQLite writes these beside the database whenever the server or its tests run.
# They are runtime state, never source, and they were committed once by accident.
server/data/*.db-shm
server/data/*.db-wal
.DS_Store
*.log
Pri-learning-final-production/
scripts/.lan-cert/

# Real Apple Pencil corpus is local/private training data.
# Keep the corpus README tracked, but never commit participant JSON sessions.
client/test/ink-corpus/*.json

# Local real-writer calibration derived from that corpus. Vite copies the
# client/public file into client/dist, which stays gitignored.
client/public/ink-bootstrap-profile.js

# Generated iOS web bundles (decision D28, 1 November 2026). `npm run build &&
# npm run sync:ios` copies client/dist into both native packages; Vite gives
# every asset a content hash, so tracking the copies made every client merge
# conflict every open client PR on ~300 generated files. Only the placeholder
# README that keeps the folder in git (Package.swift declares
# .copy("Resources/Web")) is tracked; tools/generated-bundles-untracked-check.mjs
# fails CI if anything else under these folders is ever committed again.
ios/PriLearning.swiftpm/Resources/Web/*
!ios/PriLearning.swiftpm/Resources/Web/README.md
ios/PriLearning 2.swiftpm/Resources/Web/*
!ios/PriLearning 2.swiftpm/Resources/Web/README.md

# Local neural-training outputs are large/private development artifacts.
tools/ink-foundation/runs/

# Development bootstrap models are installed locally for DEBUG testing only.
ios/PriLearning.swiftpm/Resources/Models/PriInkFoundation.mlpackage/
ios/PriLearning\ 2.swiftpm/Resources/Models/PriInkFoundation.mlpackage/
marketing/reel/export/

# macOS, Finder and iCloud all copy a file as "name 2.ext" when it is written
# over itself, and then "name 3.ext", "name 4.ext" and on. Eight were committed
# by mistake in acf58d3; since then a "sw 3.js", a set of KaTeX faces and app
# icons at " 2." and " 3.", and finally twenty files at " 4." and " 5." have
# each broken the iPad bundle-match gate, which compares the tracked bundle
# against a fresh build file by file.
#
# Enumerating the numbers was the mistake — every round found a higher one. This
# matches any single-digit copy of any file type the build emits.
*[ ][2-9].*
# ...but ios/PriLearning 2.swiftpm is a real Swift package whose name happens to
# fit the pattern, and an ignored directory excludes everything beneath it. That
# silently dropped 23 freshly-hashed bundle assets from `git add -A` — they were
# never staged, CI built the real thing and found the tracked bundle stale.
# git cannot re-include a file under an excluded directory, so the directory
# itself has to be let back in.
!*[ ][2-9].swiftpm/

# Python interpreter caches are generated artifacts, never release source.
__pycache__/
*.pyc
*.pyo

# Official exam-authority PDFs are fetched into a local, hash-verified cache and
# never committed; review work-in-progress stays local too.
tools/jee-question-department/cache/
tools/jee-question-department/work/
