node_modules/
client/dist/
.venv/
.venv-ink/
.venv-ink-export/
server/data/*.db
# SQLite writes these beside the database whenever the server or its tests run.
# They are runtime state, never source, and they were committed once by accident.
server/data/*.db-shm
server/data/*.db-wal
.DS_Store
*.log
Pri-learning-final-production/
scripts/.lan-cert/

# Real Apple Pencil corpus is local/private training data.
# Keep the corpus README tracked, but never commit participant JSON sessions.
client/test/ink-corpus/*.json

# Local real-writer calibration derived from that corpus. Vite copies the
# client/public file into the iPad web bundle; every copy stays gitignored.
client/public/ink-bootstrap-profile.js
ios/PriLearning.swiftpm/Resources/Web/ink-bootstrap-profile.js
ios/PriLearning\ 2.swiftpm/Resources/Web/ink-bootstrap-profile.js

# Local neural-training outputs are large/private development artifacts.
tools/ink-foundation/runs/

# Development bootstrap models are installed locally for DEBUG testing only.
ios/PriLearning.swiftpm/Resources/Models/PriInkFoundation.mlpackage/
ios/PriLearning\ 2.swiftpm/Resources/Models/PriInkFoundation.mlpackage/
marketing/reel/export/

# macOS duplicates a file as "name 2.ext" when it is copied over itself. Eight
# of these were committed by mistake in acf58d3 — byte-identical copies of files
# already tracked beside them. Ignored so it cannot happen again.
*[ ]2.py
*[ ]2.mjs
*[ ]2.sh
*[ ]2.js
*[ ]2.jsx
*[ ]2.css
# The same tool went on to make " 3." copies, and two of them — both `sw 3.js`
# inside the generated iPad bundles — were committed and broke the bundle-match
# gate, which compares the tracked bundle against a fresh build file by file.
*[ ]3.py
*[ ]3.mjs
*[ ]3.sh
*[ ]3.js
*[ ]3.jsx
*[ ]3.css
# And again with the fonts and icons the build emits into the iPad bundles —
# a KaTeX face copied as "… 2.ttf" is an extra file, and the bundle-match gate
# compares tracked against freshly built file by file.
*[ ]2.ttf
*[ ]2.woff
*[ ]2.woff2
*[ ]2.png
*[ ]2.svg
*[ ]3.ttf
*[ ]3.woff
*[ ]3.woff2
*[ ]3.png
*[ ]3.svg
