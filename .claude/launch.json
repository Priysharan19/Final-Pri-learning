{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "app",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "server/index.js"
      ],
      "port": 4000
    },
    {
      "name": "dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "reel",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4173",
        "-d",
        "marketing/reel"
      ],
      "port": 4173
    },
    {
      "name": "reel-export",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "marketing/reel/tools/serve.mjs"
      ],
      "port": 4174
    },
    {
      "name": "claim",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "4175",
        "-d",
        "marketing/a2z-claim-page"
      ],
      "port": 4175
    }
  ]
}