<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext to the emulator host / loopback, so the
     instrumented cloud journey can reach a local Pri server. Release builds
     have no network security config overlay and refuse all cleartext. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
