{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pri-learning/examiner-certification-record/v1",
  "title": "Pri Learning — signed examiner certification record",
  "description": "A transcription of a signed examiner decision form (docs/marking/packets/<jurisdiction>/decision-form.md). One file per certification under docs/marking/certifications/. Verified by tools/verify-examiner-certification.mjs, which also enforces rules JSON Schema cannot express: the digest must equal the current dossier digest, every item in the packet's items.json must have a decision, and no unknown item may appear.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "jurisdiction", "syllabusVersions", "dossierDigest", "commit", "examiners", "decisions", "signedOriginal", "recordedBy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "fixture": { "description": "Test fixtures only. A record carrying this field is always refused, whatever its value.", "type": "boolean" },
    "jurisdiction": { "enum": ["cbse", "nsw-hsc"] },
    "syllabusVersions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "dossierDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "examiners": {
      "type": "array",
      "minItems": 1,
      "description": "CBSE needs at least 1; NSW HSC at least 2 (research §8.3). The minimum is in the packet's items.json.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "qualification", "affiliation", "date", "independent", "independenceStatement", "conflicts"],
        "properties": {
          "name": { "type": "string", "minLength": 2 },
          "qualification": { "type": "string", "minLength": 2 },
          "affiliation": { "type": "string", "minLength": 2 },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "independent": { "const": true },
          "independenceStatement": { "type": "string", "minLength": 20 },
          "conflicts": { "type": "string", "minLength": 2 }
        }
      }
    },
    "decisions": {
      "type": "object",
      "description": "Item id (from items.json) → that item's verdict. Every item must be present.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verdict"],
        "properties": {
          "verdict": { "enum": ["approved", "approved-with-changes", "rejected"] },
          "notes": { "type": "string" }
        }
      }
    },
    "signedOriginal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["heldBy", "location", "receivedOn"],
      "properties": {
        "heldBy": { "type": "string", "minLength": 2 },
        "location": { "type": "string", "minLength": 2 },
        "receivedOn": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "recordedBy": { "type": "string", "minLength": 2, "description": "The human who transcribed the signed original. An automation identity is refused." }
  }
}
