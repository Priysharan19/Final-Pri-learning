{
  "name": "pri-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pri Learning — Years 7–12 maths practice with HSC-style marking and on-device handwriting recognition. Runs entirely offline; nothing leaves the iPad.",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "npm run test:engine && npm run test:gateway && npm run test:outbox && npm run test:backend && npm run test:security && npm run test:diagnose && npm run test:india && npm run test:ncert:rational && npm run test:ncert:linear && npm run test:explain && npm run test:ink && npm run test:calculus && npm run test:jee && npm run test:hard && npm run test:lines && npm run test:holdout && npm run test:holdout2 && npm run test:holdout3 && npm run test:ink:collector && npm run test:ink:feedback && npm run test:ink:structure && npm run test:ink:corpus && npm run test:context && npm run test:ink:bridge && npm run test:photo:bridge && npm run test:ink:interaction && npm run test:ink:personal && npm run test:ink:hybrid && npm run test:ink:arbitration && npm run test:ink:sets && npm run test:ink:stability",
    "test:engine": "node server/test/selfcheck.mjs",
    "test:engine:quick": "node server/test/selfcheck.mjs --quick",
    "test:engine:thorough": "node server/test/selfcheck.mjs --thorough",
    "test:gateway": "node client/test/gateway-check.mjs",
    "test:outbox": "node client/test/outbox-check.mjs",
    "test:backend": "node client/test/backend-check.mjs",
    "test:security": "node client/test/security-check.mjs",
    "test:diagnose": "node client/test/diagnose-check.mjs",
    "test:india": "node client/test/india-check.mjs",
    "test:ncert:rational": "node client/test/ncert-rational-numbers-check.mjs",
    "test:ncert:linear": "node client/test/ncert-linear-equations-check.mjs",
    "india:coverage": "node tools/india-coverage.mjs",
    "test:ink": "node client/test/inkcheck.mjs 40",
    "test:calculus": "node client/test/inkcheck-calculus.mjs",
    "test:jee": "node client/test/inkcheck-jee.mjs",
    "test:hard": "node client/test/inkcheck-hard.mjs",
    "test:lines": "node client/test/inkcheck-lines.mjs 40",
    "test:holdout": "node client/test/inkcheck-holdout.mjs 24",
    "test:holdout2": "node client/test/inkcheck-holdout2.mjs 40",
    "test:holdout3": "node client/test/inkcheck-holdout3-gate.mjs 40",
    "test:context": "node client/test/inkcheck-context.mjs",
    "test:real": "node client/test/inkcheck-real.mjs",
    "test:ink:collector": "node client/test/ink-collector-check.mjs",
    "test:ink:feedback": "node client/test/ink-feedback-geometry-check.mjs",
    "test:ink:structure": "node client/test/ink-structural-annotator-check.mjs",
    "test:ink:structure:joint": "python3 tools/ink-foundation/test_structural_joint_decode.py",
    "test:ink:corpus": "node client/test/ink-corpus-audit.mjs",
    "test:ink:corpus:strict": "node client/test/ink-corpus-audit.mjs --strict",
    "test:ink:bridge": "node client/test/native-ink-check.mjs",
    "test:photo:bridge": "node client/test/photo-ocr-bridge-check.mjs",
    "test:ink:interaction": "node client/test/ink-interaction-guard-check.mjs",
    "test:ink:personal": "node client/test/ink-personal-metric-check.mjs",
    "test:ink:hybrid": "node client/test/ink-hybrid-check.mjs",
    "test:ink:native": "node scripts/ink-native-check.mjs",
    "test:browser": "npm run test:e2e && npm run test:a11y",
    "test:e2e": "node client/test/e2e.mjs && node client/test/tour-explain-v2.js --no-build",
    "test:a11y": "node client/test/a11y-gate.mjs",
    "sync:ios": "node scripts/sync-ios.mjs",
    "check:ios": "node scripts/sync-ios.mjs --check",
    "serve:lan": "node scripts/serve-lan.mjs",
    "test:ipad:native": "node scripts/test-ipad-native.mjs",
    "serve:lan:v4": "node scripts/serve-lan.mjs --v4-dev 4196",
    "ink:collect": "node scripts/serve-lan.mjs --collector",
    "ink:annotate": "node scripts/serve-lan.mjs --annotator",
    "ink:structure:preannotate": "node scripts/ink-structure-preannotate.mjs",
    "ink:structure:audit": "python3 tools/ink-foundation/audit_structural.py client/test/ink-corpus-structural --require-all",
    "ink:structure:train": "npm run ink:structure:audit && python3 tools/ink-foundation/train_structural.py --corpus client/test/ink-corpus-structural --out tools/ink-foundation/runs/pri-ink-structural-v4.pt",
    "ink:structure:evaluate": "python3 tools/ink-foundation/evaluate_structural.py tools/ink-foundation/runs/pri-ink-structural-v4.pt --corpus client/test/ink-corpus-structural --split validation --out tools/ink-foundation/runs/pri-ink-structural-v4-validation.json",
    "ink:structure:evaluate:joint": "python3 tools/ink-foundation/evaluate_structural.py tools/ink-foundation/runs/pri-ink-structural-v4.pt --corpus client/test/ink-corpus-structural --split validation --decoder joint --out tools/ink-foundation/runs/pri-ink-structural-v4-validation-joint.json",
    "ink:structure:compare": "python3 tools/ink-foundation/compare_structural_decoders.py tools/ink-foundation/runs/pri-ink-structural-v4-validation.json tools/ink-foundation/runs/pri-ink-structural-v4-validation-joint.json --out tools/ink-foundation/runs/pri-ink-structural-v4-decoder-comparison.json",
    "ink:structure:pretrain:dev": "bash scripts/ink-structural-pretrain-dev.sh",
    "ink:structure:train:dev": "npm run ink:structure:audit && python3 tools/ink-foundation/train_structural_dev.py --corpus client/test/ink-corpus-structural --out tools/ink-foundation/runs/pri-ink-structural-v4-dev.pt",
    "ink:structure:train:dev:pretrained": "npm run ink:structure:audit && python3 tools/ink-foundation/train_structural_dev.py --corpus client/test/ink-corpus-structural --init tools/ink-foundation/runs/pri-ink-structural-v4-synthetic.pt --replay-corpus /tmp/pri-ink-v4-synth-structural --replay-weight 0.20 --out tools/ink-foundation/runs/pri-ink-structural-v4-dev.pt --lr 8e-5 --weight-decay 0.04 --epochs 40 --patience 12",
    "ink:structure:evaluate:dev": "python3 tools/ink-foundation/evaluate_structural_dev.py tools/ink-foundation/runs/pri-ink-structural-v4-dev.pt --corpus client/test/ink-corpus-structural --out tools/ink-foundation/runs/pri-ink-structural-v4-dev-validation.json",
    "ink:structure:evaluate:dev:joint": "python3 tools/ink-foundation/evaluate_structural_dev.py tools/ink-foundation/runs/pri-ink-structural-v4-dev.pt --corpus client/test/ink-corpus-structural --decoder joint --out tools/ink-foundation/runs/pri-ink-structural-v4-dev-validation-joint.json",
    "ink:structure:compare:dev": "python3 tools/ink-foundation/compare_structural_decoders.py tools/ink-foundation/runs/pri-ink-structural-v4-dev-validation.json tools/ink-foundation/runs/pri-ink-structural-v4-dev-validation-joint.json --out tools/ink-foundation/runs/pri-ink-structural-v4-dev-decoder-comparison.json",
    "ink:structure:diagnose:grouping:dev": "python3 tools/ink-foundation/diagnose_structural_grouping_dev.py",
    "ink:structure:diagnose:joint-grouping:dev": "python3 tools/ink-foundation/diagnose_structural_joint_grouping_dev.py",
    "ink:structure:rebuild:dev": "bash scripts/ink-structural-rebuild-dev.sh",
    "ink:status": "node client/test/ink-corpus-status.mjs",
    "ink:personalize": "node scripts/ink-personalize.mjs",
    "ink:next-attempt": "npm run test:ink:corpus:strict && npm run ink:personalize && npm run test:ink:personal && npm run test:ink:hybrid && npm run test:context && npm run build && npm run sync:ios && npm run check:ios",
    "ink:bootstrap": "bash scripts/ink-bootstrap-one-writer.sh",
    "ink:bootstrap:strong": "PRI_INK_SYNTH_TRAIN_WRITERS=192 PRI_INK_SYNTH_VAL_WRITERS=48 PRI_INK_SYNTH_SAMPLES_PER_WRITER=40 PRI_INK_PERSONAL_SYNTH_SAMPLES=1600 PRI_INK_PRETRAIN_EPOCHS=24 PRI_INK_BOOTSTRAP_EPOCHS=50 PRI_INK_D_MODEL=256 PRI_INK_STROKE_LAYERS=8 PRI_INK_DECODER_LAYERS=6 PRI_INK_REAL_REPLAY_FRACTION=0.30 PRI_INK_VISUAL_LR_MULTIPLIER=2.0 PRI_INK_STROKE_LR_MULTIPLIER=0.45 PRI_INK_DECODER_LR_MULTIPLIER=1.0 bash scripts/ink-bootstrap-one-writer.sh",
    "ink:next-attempt:strong": "npm run ink:bootstrap:strong && npm run ink:personalize && npm run test:ink:personal && npm run test:ink:hybrid && npm run test:context && npm run build && npm run sync:ios && npm run check:ios",
    "ink:bootstrap:export": "bash scripts/ink-bootstrap-export.sh",
    "test:ink:arbitration": "node client/test/native-ink-arbitration-check.mjs",
    "test:ink:sets": "node client/test/ink-set-notation-check.mjs",
    "test:ink:stability": "node client/test/ink-real-page-stability-check.mjs",
    "test:explain": "node client/test/pri-explain-check.mjs"
  }
}
