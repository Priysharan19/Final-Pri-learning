{
  "name": "pri-learning",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Pri Learning — Years 7–12 maths practice with HSC-style marking and on-device handwriting recognition. Runs entirely offline; nothing leaves the iPad.",
  "scripts": {
    "setup": "npm install --prefix server && npm install --prefix client",
    "dev": "node scripts/dev.js",
    "build": "npm run build --prefix client",
    "start": "node server/index.js",
    "seed": "node server/seed.js",
    "test": "npm run test:engine && npm run test:gateway && npm run test:outbox && npm run test:backend && npm run test:security && npm run test:ink && npm run test:hard && npm run test:lines && npm run test:holdout && npm run test:holdout2 && npm run test:holdout3 && npm run test:ink:corpus && npm run test:context && npm run test:ink:bridge",
    "test:engine": "node server/test/selfcheck.mjs",
    "test:engine:quick": "node server/test/selfcheck.mjs --quick",
    "test:engine:thorough": "node server/test/selfcheck.mjs --thorough",
    "test:gateway": "node client/test/gateway-check.mjs",
    "test:outbox": "node client/test/outbox-check.mjs",
    "test:backend": "node client/test/backend-check.mjs",
    "test:security": "node client/test/security-check.mjs",
    "test:ink": "node client/test/inkcheck.mjs 40",
    "test:hard": "node client/test/inkcheck-hard.mjs",
    "test:lines": "node client/test/inkcheck-lines.mjs 40",
    "test:holdout": "node client/test/inkcheck-holdout.mjs 24",
    "test:holdout2": "node client/test/inkcheck-holdout2.mjs 40",
    "test:holdout3": "node client/test/inkcheck-holdout3-gate.mjs 40",
    "test:context": "node client/test/inkcheck-context.mjs",
    "test:real": "node client/test/inkcheck-real.mjs",
    "test:ink:corpus": "node client/test/ink-corpus-audit.mjs",
    "test:ink:corpus:strict": "node client/test/ink-corpus-audit.mjs --strict",
    "test:ink:bridge": "node client/test/native-ink-check.mjs",
    "test:ink:native": "node scripts/ink-native-check.mjs",
    "test:ios:device-evidence": "node scripts/ipad-device-evidence-check.mjs",
    "test:ios:device-evidence:strict": "node scripts/ipad-device-evidence-check.mjs --strict",
    "test:browser": "npm run test:e2e && npm run test:a11y",
    "test:e2e": "node client/test/e2e.mjs",
    "test:a11y": "node client/test/a11y-gate.mjs",
    "sync:ios": "node scripts/sync-ios.mjs",
    "check:ios": "node scripts/sync-ios.mjs --check",
    "serve:lan": "node scripts/serve-lan.mjs"
  }
}
