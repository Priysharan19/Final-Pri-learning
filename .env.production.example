NODE_ENV=production
PORT=4000

# Exact public browser origin. Production rejects non-HTTPS or dirty origins.
PRI_PUBLIC_ORIGIN=https://learn.example.com

# Generate deployment-only secrets. Never commit real values.
PRI_CSRF_SECRET=replace-with-a-high-entropy-secret
PRI_AUTH_DELIVERY_KEY=replace-with-64-hex-characters

# Must be an absolute path on a persistent mounted volume.
PRI_PLATFORM_DB=/data/pri-learning-platform.db

# How many reverse proxies sit between the internet and this process. There is
# no default and production will not start without it, because this number is
# what turns X-Forwarded-For into the client address the rate limiters count.
# Set it too high and a client can send its own X-Forwarded-For to get a fresh
# identity for every request, so the registration and password-reset limits stop
# working. Set it too low and everyone behind the proxy shares one bucket, so
# one busy school locks out the rest. Neither shows up in a response.
#   0  the process is reachable directly (a bare container, a LAN box)
#   1  one load balancer, CDN or platform router in front (Railway, Fly, Render,
#      a single nginx) — the usual answer
#   2  two, e.g. Cloudflare in front of a platform router
PRI_TRUSTED_PROXY_HOPS=1

# Verification and password-reset email delivery.
PRI_AUTH_EMAIL_PROVIDER=resend
PRI_RESEND_API_KEY=replace-with-resend-api-key
PRI_AUTH_EMAIL_FROM=Pri Learning <noreply@example.com>

# Optional OIDC providers.
PRI_GOOGLE_CLIENT_IDS=
PRI_APPLE_CLIENT_IDS=

# Optional Razorpay web subscriptions. If a plan id is configured,
# production also requires provider secrets and subscription counts.
PRI_RAZORPAY_MONTHLY_PLAN_ID=
PRI_RAZORPAY_ANNUAL_PLAN_ID=
PRI_RAZORPAY_MONTHLY_TOTAL_COUNT=
PRI_RAZORPAY_ANNUAL_TOTAL_COUNT=
PRI_RAZORPAY_KEY_ID=
PRI_RAZORPAY_KEY_SECRET=
PRI_RAZORPAY_WEBHOOK_SECRET=

# Optional Apple subscription verification.
PRI_APPLE_MONTHLY_PRODUCT_ID=
PRI_APPLE_ANNUAL_PRODUCT_ID=
PRI_APPLE_APP_ID=
PRI_APPLE_ROOT_CA_FILE=

# Optional server-side handwriting reading. Without an API key the /v1/handwriting
# routes report themselves unavailable, the app hides the setting, and every
# reading happens on the device — which is the default and a supported way to run.
# Reading is billed per request and is rate limited to 240 per account per hour.
PRI_HANDWRITING_API_KEY=
PRI_HANDWRITING_ENDPOINT=
PRI_HANDWRITING_MODEL=
# Consulted only when the first read comes back unsure, so the usual request
# costs one call and a hard page costs two.
PRI_HANDWRITING_FALLBACK_MODEL=
PRI_HANDWRITING_TIMEOUT_MS=
# Below this confidence a reading is offered to the student for confirmation
# rather than applied. Default 0.82.
PRI_HANDWRITING_CONFIDENCE_FLOOR=

# Optional server-side step checking ("which line did my working go wrong on").
# Shares PRI_HANDWRITING_API_KEY: a deployment that can read ink can check
# working, and one key is one thing to configure and one to rotate. Without that
# key the /v1/working routes report themselves unavailable and marking happens
# entirely on the device. Reasoning costs more than transcription, so this route
# allows 120 requests per account per hour against handwriting's 240.
PRI_WORKING_MODEL=
PRI_WORKING_ENDPOINT=
PRI_WORKING_TIMEOUT_MS=
# Below this confidence the check is shown as a suggestion in words rather than
# as a ✗ on a line. Default 0.75.
PRI_WORKING_CONFIDENCE_FLOOR=
# ── Display pricing ─────────────────────────────────────────────────────────
# What the app SHOWS. Checkout and the store remain authoritative; these only
# stop the account panel saying "public pricing has not been configured for
# this deployment yet", which is what it says today.
#
# Prices are a business decision and are deliberately not defaulted in code.
# For an Indian student audience the comparable products sit far below Western
# subscription maths: Leibniz charges about A$9.99/month, which is roughly
# ₹550, and that is priced for Australian households. Indian ed-tech at this
# level generally lands between ₹199 and ₹399 a month, with the annual price
# set at roughly seven to eight months of the monthly one. Pick your own
# numbers; these are only the shape of the market.
PRI_DISPLAY_CURRENCY=INR
PRI_DISPLAY_MONTHLY_PRICE=
PRI_DISPLAY_ANNUAL_PRICE=
# Days of free trial to advertise. Leave empty for none. A trial is only
# actually granted when the billing provider is configured to grant it.
PRI_DISPLAY_TRIAL_DAYS=

# ── The ceiling on what the paid reader may cost ────────────────────────────
# REQUIRED whenever PRI_HANDWRITING_API_KEY is set, with no default, because a
# default is a guess about somebody else's budget: too low kills the feature
# quietly under load, too high is not a ceiling, and neither failure shows up in
# a response. The server refuses to start without them.
#
# These count paid provider calls across the WHOLE deployment, shared by
# /v1/handwriting and /v1/working because they share one key and one bill. The
# per-account limits (240 and 120 an hour) bound one student; only these bound
# the invoice. A thousand students at their own limits is 360,000 calls an hour.
#
# When the ceiling is reached both routes refuse and every student falls back to
# reading on their own device, which is the default anyway — so set these to
# what you are willing to pay in a day, not to what you hope nobody reaches.
PRI_PAID_CALLS_PER_HOUR=
PRI_PAID_CALLS_PER_DAY=
