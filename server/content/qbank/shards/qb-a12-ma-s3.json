nswer":true}]},{"id":"A12-S3-092","group":"A12-S3-092","dp":"S3.1b","authored":4,"level":4,"marks":1,"title":"Upper quartile of a density","prompt":"For $f(x)=\\tfrac x2$ on $0\\le x\\le2$, find the upper quartile exactly.","answerType":"numeric","answer":{"value":1.7320508075688772},"hints":["F(x) = x²/4.","Set ¾.","Root."],"ladder":{"nudge":"F(x) = x²/4.","method":"Set ¾.","worked":"Root."},"steps":[{"h":"CDF","d":"$\\tfrac{x^{2}}{4}=\\tfrac34$"}],"traps":[{"value":1.5,"why":"Solve the CDF."}],"criteria":[{"marks":1,"point":"√3","answer":true}]},{"id":"A12-S3-094","group":"A12-S3-094","dp":"S3.1b","authored":3,"level":3,"marks":1,"title":"Expected value of a cosine density","prompt":"For $f(x)=\\tfrac12\\sin x$ on $[0,\\pi]$, find $E(X)$.","answerType":"numeric","answer":{"value":1.5707963267948966},"hints":["Graph symmetric.","Mean at centre.","π/2."],"ladder":{"nudge":"Graph symmetric.","method":"Mean at centre.","worked":"π/2."},"steps":[{"h":"Symmetry","d":"Symmetric about $\\tfrac{\\pi}{2}$"}],"traps":[{"value":1,"why":"Use symmetry."}],"criteria":[{"marks":1,"point":"π/2","answer":true}]},{"id":"A12-S3-097","group":"A12-S3-097","dp":"S3.1c","authored":2,"level":2,"marks":1,"title":"Uniform distribution percentile","prompt":"$X$ is uniform on $[10,30]$. Find the $80$th percentile.","answerType":"numeric","answer":{"value":26},"hints":["Width 20.","80% of the way.","Add 10."],"ladder":{"nudge":"Width 20.","method":"80% of the way.","worked":"Add 10."},"steps":[{"h":"Linear","d":"$10+0.8\\times20$"}],"traps":[{"value":24,"why":"Start from 10."}],"criteria":[{"marks":1,"point":"26","answer":true}]},{"id":"A12-S3-098","group":"A12-S3-098","dp":"S3.1c","authored":3,"level":3,"marks":1,"title":"Exponential time exceedance","prompt":"Bulb lifetimes have $f(t)=0.001e^{-0.001t}$ hours. Find the probability a bulb lasts more than $2000$ hours.","answerType":"expression","answer":{"expr":"exp(-2)"},"answerPrefix":"P =","hints":["P(T > t) = e^{−λt}.","λt = 2.","e⁻²."],"ladder":{"nudge":"P(T > t) = e^{−λt}.","method":"λt = 2.","worked":"e⁻²."},"steps":[{"h":"Tail","d":"$e^{-0.001\\times2000}$"}],"traps":[{"expr":"1-exp(-2)","why":"That is P(T < 2000)."}],"criteria":[{"marks":1,"point":"e⁻²","answer":true}]},{"id":"A12-S3-102","group":"A12-S3-102","dp":"S3.1c","authored":4,"level":4,"marks":2,"title":"Uniform waiting time conditional","prompt":"A bus arrives uniformly in $[0,20]$ minutes. Given it has not come in the first $5$ minutes, find the probability it comes in the next $5$.","answerType":"numeric","answer":{"value":0.3333333333333333},"hints":["P(5 < X < 10).","Divide by P(X > 5).","Simplify."],"ladder":{"nudge":"P(5 < X < 10).","method":"Divide by P(X > 5).","worked":"Simplify."},"steps":[{"h":"Conditional","d":"$\\dfrac{5/20}{15/20}$"}],"traps":[{"value":0.25,"why":"Condition on the remaining 15 minutes.","expr":"1/4"}],"criteria":[{"marks":1,"point":"Ratio","manual":true},{"marks":1,"point":"⅓","answer":true}]},{"id":"A12-S3-108","group":"A12-S3-108","dp":"S3.2b","authored":2,"level":2,"marks":1,"title":"Two-tail probability from a table","prompt":"Given $P(Z<1.96)=0.975$, find $P(|Z|>1.96)$.","answerType":"numeric","answer":{"value":0.05},"hints":["Upper tail 0.025.","Symmetric.","Double."],"ladder":{"nudge":"Upper tail 0.025.","method":"Symmetric.","worked":"Double."},"steps":[{"h":"Tails","d":"$2(0.025)$"}],"traps":[{"value":0.025,"why":"Both tails."}],"criteria":[{"marks":1,"point":"0.05","answer":true}]},{"id":"A12-S3-110","group":"A12-S3-110","dp":"S3.2b","authored":3,"level":3,"marks":2,"title":"Number of items within limits","prompt":"$2000$ bolts have lengths $N(40,0.5^{2})$ mm. Given $P(Z<1.2)=0.8849$, how many lie between $39.4$ and $40.6$ mm?","answerType":"numeric","answer":{"value":1540},"hints":["z = ±1.2.","Middle area.","Times 2000."],"ladder":{"nudge":"z = ±1.2.","method":"Middle area.","worked":"$2(0.8849)-1=0.7698$"},"steps":[{"h":"Probability","d":"$2(0.8849)-1=0.7698$"},{"h":"Count","d":"$0.7698\\times2000$"}],"traps":[{"value":1770,"why":"Subtract both tails."}],"criteria":[{"marks":1,"point":"0.7698","line":"0.7698"},{"marks":1,"point":"1540","answer":true}]},{"id":"A12-S3-111","group":"A12-S3-111","dp":"S3.2b","authored":4,"level":4,"marks":2,"title":"Mean shift to meet a specification","prompt":"A machine fills bottles with SD $5$ mL. Given $P(Z<-2.33)=0.01$, find the mean needed so only $1\\%$ contain less than $500$ mL.","answerType":"numeric","answer":{"value":511.65},"hints":["z = −2.33.","Solve for μ.","Above 500."],"ladder":{"nudge":"z = −2.33.","method":"Solve for μ.","worked":"$\\dfrac{500-\\mu}{5}=-2.33$"},"steps":[{"h":"Equation","d":"$\\dfrac{500-\\mu}{5}=-2.33$"},{"h":"Solve","d":"$\\mu=500+11.65$"}],"traps":[{"value":488.35,"why":"The mean must be above 500."}],"criteria":[{"marks":1,"point":"Equation","manual":true},{"marks":1,"point":"511.65","answer":true}]},{"id":"A12-S3-114","group":"A12-S3-114","dp":"S3.2b","authored":3,"level":3,"marks":2,"title":"Probability of two independent normal events","prompt":"$X\\sim N(30,4)$. Given $P(Z>1.5)=0.0668$, find the probability that two independent observations both exceed $33$.","answerType":"numeric","answer":{"value":0.004462,"tol":0.00001},"hints":["σ = 2.","z = 1.5.","Square."],"ladder":{"nudge":"σ = 2.","method":"z = 1.5.","worked":"Square."},"steps":[{"h":"One","d":"$z=1.5$, $0.0668$"},{"h":"Both","d":"$0.0668^{2}$"}],"traps":[{"value":0.1336,"why":"Multiply, do not add."}],"criteria":[{"marks":1,"point":"0.0668","line":"0.0668"},{"marks":1,"point":"0.00446","answer":true}]},{"id":"A12-S3-115","group":"A12-S3-115","dp":"S3.2b","authored":3,"level":3,"marks":1,"title":"Finding SD from a percentile and mean","prompt":"$X$ is normal with mean $80$ and $P(X>92)=0.0228$. Given $P(Z<2)=0.9772$, find $\\sigma$.","answerType":"numeric","answer":{"value":6},"hints":["Upper tail 0.0228 means z = 2.","80 + 2σ = 92.","Solve."],"ladder":{"nudge":"Upper tail 0.0228 means z = 2.","method":"80 + 2σ = 92.","worked":"Solve."},"steps":[{"h":"z","d":"$92=80+2\\sigma$"}],"traps":[{"value":12,"why":"92 is 2 SD above."}],"criteria":[{"marks":1,"point":"6","answer":true}]},{"id":"A12-S3-116","group":"A12-S3-116","dp":"S3.2a","authored":2,"level":2,"marks":1,"title":"Z-score of a test mark","prompt":"Marks have mean $70$ and standard deviation $8$. Find the $z$-score of $82$ and interpret it.","answerType":"numeric","answer":{"value":1.5},"hints":["Subtract the mean.","Divide by σ.","Interpret."],"ladder":{"nudge":"Subtract the mean.","method":"Divide by σ.","worked":"Interpret."},"steps":[{"h":"Standardise","d":"$\\tfrac{82-70}{8}$"}],"traps":[{"value":12,"why":"Divide by the standard deviation."}],"criteria":[{"marks":1,"point":"1.5","answer":true}]},{"id":"A12-S3-118","group":"A12-S3-118","dp":"S3.2b","authored":3,"level":3,"marks":2,"title":"Probability within symmetric limits","prompt":"$X\\sim N(50,4^{2})$. Given $P(Z<1.5)=0.9332$, find $P(44<X<56)$.","answerType":"numeric","answer":{"value":0.8664},"hints":["Standardise both.","Symmetric.","2Φ(z) − 1."],"ladder":{"nudge":"Standardise both.","method":"Symmetric.","worked":"$\\pm1.5$"},"steps":[{"h":"z","d":"$\\pm1.5$"},{"h":"Middle","d":"$2(0.9332)-1$"}],"traps":[{"value":0.9332,"why":"Subtract the lower tail."}],"criteria":[{"marks":1,"point":"z-values","manual":true},{"marks":1,"point":"0.8664","answer":true}]},{"id":"A12-S3-120","group":"A12-S3-120","dp":"S3.1c","authored":3,"level":3,"marks":1,"title":"Exponential survival probability","prompt":"The life $T$ (years) of a component has density $0.2e^{-0.2t}$. Find $P(T>5)$ exactly.","answerType":"expression","answer":{"expr":"exp(-1)"},"answerPrefix":"P =","hints":["P(T > t) = e^{−λt}.","λt = 1.","Exact."],"ladder":{"nudge":"P(T > t) = e^{−λt}.","method":"λt = 1.","worked":"Exact."},"steps":[{"h":"Tail","d":"$e^{-0.2\\times5}$"}],"traps":[{"expr":"1-exp(-1)","why":"That is P(T < 5)."}],"criteria":[{"marks":1,"point":"e⁻¹","answer":true}]},{"id":"A12-S3-122","group":"A12-