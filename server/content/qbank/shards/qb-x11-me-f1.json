{"family":"qb-x11-me-f1","course":"EXT1","year":11,"topic":"ME-F1","questions":[{"id":"X11-F1-001","group":"X11-F1-001","dp":"F1.3a","authored":2,"level":2,"marks":3,"title":"Inverse of a rational function","prompt":"Find the inverse function of $f(x)=\\dfrac{2x+1}{x-3}$, and state its domain.","answerType":"expression","answer":{"expr":"(3*x+1)/(x-2)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Multiply out and collect y.","The domain of f⁻¹ is the range of f."],"ladder":{"nudge":"Swap x and y.","method":"Multiply out and collect y.","worked":"The domain of f⁻¹ is the range of f."},"steps":[{"h":"Swap","d":"$x=\\dfrac{2y+1}{y-3}$"},{"h":"Solve","d":"$xy-3x=2y+1\\Rightarrow y(x-2)=3x+1$"},{"h":"Answer","d":"$f^{-1}(x)=\\dfrac{3x+1}{x-2}$, $x\\ne2$"}],"traps":[{"expr":"(x-3)/(2*x+1)","why":"That is the reciprocal, not the inverse."}],"criteria":[{"marks":1,"point":"Swaps x and y","line":"x = (2*y+1)/(y-3)"},{"marks":1,"point":"Collects y terms","line":"y*(x-2) = 3*x+1"},{"marks":1,"point":"Inverse with domain x ≠ 2","answer":true}]},{"id":"X11-F1-014","group":"X11-F1-014","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of an exponential","prompt":"Find the inverse of $f(x)=e^{2x}-3$ and state its domain and range.","answerType":"expression","answer":{"expr":"ln(x+3)/2"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Domain of f⁻¹ = range of f."],"ladder":{"nudge":"Swap x and y.","method":"Domain of f⁻¹ = range of f."},"steps":[{"h":"Swap","d":"$x+3=e^{2y}\\Rightarrow y=\\tfrac12\\ln(x+3)$"},{"h":"Domain and range","d":"Domain $x>-3$, range all real $y$."}],"traps":[{"expr":"ln(x)/2+3","why":"Undo −3 before the log."}],"criteria":[{"marks":1,"point":"½ ln(x + 3)","line":"y = ln(x+3)/2"},{"marks":1,"point":"Domain and range","answer":true}]},{"id":"X11-F1-019","group":"X11-F1-019","dp":"F1.1a","authored":3,"level":3,"marks":2,"title":"A quadratic that is always positive","prompt":"Find the values of $k$ for which $x^{2}-kx+k+3>0$ for all real $x$.","answerType":"interval","answer":{"region":"-2 < k < 6","variable":"k"},"hints":["Positive definite needs Δ < 0.","a = 1 > 0 already.","Solve the quadratic inequality."],"ladder":{"nudge":"Positive definite needs Δ < 0.","method":"a = 1 > 0 already.","worked":"Solve the quadratic inequality."},"steps":[{"h":"Discriminant","d":"$k^{2}-4(k+3)<0\\Rightarrow(k-6)(k+2)<0$"}],"traps":[{"region":"k < -2 or k > 6","why":"That gives two real roots."}],"criteria":[{"marks":1,"point":"Δ < 0","line":"k^2-4*k-12 < 0"},{"marks":1,"point":"−2 < k < 6","answer":true}]},{"id":"X11-F1-021","group":"X11-F1-021","dp":"F1.3a","authored":1,"level":1,"marks":1,"title":"Inverse of a cubic","prompt":"Find the inverse function of $f(x)=x^{3}+1$.","answerType":"expression","answer":{"expr":"(x-1)^(1/3)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Subtract 1.","Take the cube root."],"ladder":{"nudge":"Swap x and y.","method":"Subtract 1.","worked":"Take the cube root."},"steps":[{"h":"Swap and solve","d":"$x=y^{3}+1\\Rightarrow y=\\sqrt[3]{x-1}$"}],"traps":[{"expr":"x^(1/3)-1","why":"Undo the +1 before the cube."}],"criteria":[{"marks":1,"point":"Correct inverse","answer":true}]},{"id":"X11-F1-022","group":"X11-F1-022","dp":"F1.2a","authored":2,"level":2,"marks":3,"title":"Fraction compared with one","prompt":"Solve $\\dfrac{2x}{x+1}\\le1$.","answerType":"interval","answer":{"region":"-1 < x <= 1","variable":"x"},"hints":["Bring everything to one side.","Use a sign diagram."],"ladder":{"nudge":"Bring everything to one side.","method":"Use a sign diagram."},"steps":[{"h":"Rearrange","d":"$\\dfrac{2x-(x+1)}{x+1}\\le0\\Rightarrow\\dfrac{x-1}{x+1}\\le0$"},{"h":"Signs","d":"Critical values $-1$ (excluded) and $1$"},{"h":"Solve","d":"$-1<x\\le1$"}],"traps":[{"region":"x <= 1","why":"Multiplied by x + 1 without knowing its sign."}],"criteria":[{"marks":1,"point":"Single fraction","line":"(x-1)/(x+1) <= 0"},{"marks":1,"point":"Critical values","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-024","group":"X11-F1-024","dp":"F1.1a","authored":1,"level":1,"marks":1,"title":"Eliminating the parameter","prompt":"Find the Cartesian equation of the curve $x=t+1$, $y=t^{2}$.","answerType":"expression","answer":{"expr":"(x-1)^2"},"answerPrefix":"y =","hints":["Make t the subject of x."],"ladder":{"nudge":"Make t the subject of x."},"steps":[{"h":"Eliminate","d":"$t=x-1\\Rightarrow y=(x-1)^{2}$"}],"traps":[{"expr":"(x+1)^2","why":"t = x − 1, not x + 1."}],"criteria":[{"marks":1,"point":"y = (x − 1)²","answer":true}]},{"id":"X11-F1-027","group":"X11-F1-027","dp":"F1.1b","authored":2,"level":2,"marks":2,"title":"When the absolute value changes nothing","prompt":"Solve $\\left|x^{2}-x-6\\right|=x^{2}-x-6$.","answerType":"interval","answer":{"region":"x <= -2 or x >= 3","variable":"x"},"hints":["|u| = u exactly when u ≥ 0."],"ladder":{"nudge":"|u| = u exactly when u ≥ 0."},"steps":[{"h":"Condition","d":"$|u|=u\\iff u\\ge0$"},{"h":"Solve","d":"$(x-3)(x+2)\\ge0$"}],"traps":[{"region":"-2 <= x <= 3","why":"That is where the quadratic is ≤ 0."}],"criteria":[{"marks":1,"point":"Needs x² − x − 6 ≥ 0","line":"(x-3)*(x+2) >= 0"},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-028","group":"X11-F1-028","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of a shifted exponential","prompt":"Find the inverse of $f(x)=e^{x}+2$ and state its domain.","answerType":"expression","answer":{"expr":"ln(x-2)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Domain of f⁻¹ = range of f."],"ladder":{"nudge":"Swap x and y.","method":"Domain of f⁻¹ = range of f."},"steps":[{"h":"Swap","d":"$x=e^{y}+2\\Rightarrow y=\\ln(x-2)$"},{"h":"Domain","d":"Range of $f$: $x>2$"}],"traps":[{"expr":"ln(x)-2","why":"Subtract 2 before taking logs."}],"criteria":[{"marks":1,"point":"Domain x > 2","manual":true},{"marks":1,"point":"ln(x − 2)","answer":true}]},{"id":"X11-F1-030","group":"X11-F1-030","dp":"F1.2a","authored":2,"level":2,"marks":2,"title":"Cubic against a line","prompt":"Solve $x^{3}>4x$.","answerType":"interval","answer":{"region":"-2 < x < 0 or x > 2","variable":"x"},"hints":["Do not divide by x.","Bring to one side and factorise.","Sign diagram for a cubic."],"ladder":{"nudge":"Do not divide by x.","method":"Bring to one side and factorise.","worked":"Sign diagram for a cubic."},"steps":[{"h":"Factor","d":"$x(x-2)(x+2)>0$"},{"h":"Signs","d":"$-2<x<0$ or $x>2$"}],"traps":[{"region":"x > 2","why":"Divided by x and lost −2 < x < 0."}],"criteria":[{"marks":1,"point":"Factorises","line":"x*(x-2)*(x+2) > 0"},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-033","group":"X11-F1-033","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of a composite","prompt":"Let $f(x)=2x-1$ and $g(x)=\\dfrac x3$. Find $(g\\circ f)^{-1}(x)$.","answerType":"expression","answer":{"expr":"(3*x+1)/2"},"hints":["Swap x and y."],"ladder":{"nudge":"Swap x and y."},"steps":[{"h":"Compose","d":"$g(f(x))=\\dfrac{2x-1}{3}$"},{"h":"Invert","d":"$x=\\dfrac{2y-1}{3}\\Rightarrow y=\\dfrac{3x+1}{2}$"}],"traps":[{"expr":"(2*x-1)/3","why":"That is g ∘ f, not its inverse."}],"criteria":[{"marks":1,"point":"g(f(x)) = (2x − 1)/3","line":"(2*x-1)/3"},{"marks":1,"point":"Inverse","answer":true}]},{"id":"X11-F1-035","group":"X11-F1-035","dp":"F1.2a","authored":2,"level":2,"marks":2,"title":"A fraction that is non-negative","prompt":"Solve $\\dfrac{x-2}{x+3}\\ge0$.","answerType":"interval","answer":{"region":"x < -3 or x >= 2","variable":"x"},"hints":["Find where the top and bottom are zero.","Exclude the denominator zero."],"ladder":{"nudge":"Find where the top and bottom are zero.","method":"Exclude the denominator zero."},"steps":[{"h":"Critical values","d":"$x=2$ (allowed), $x=-3$ (excluded)"},{"h":"Signs","d":"Positive outside, zero at $2$"}],"traps":[{"region":"x <= -3 or x >= 2","why":"x = −3 makes the fraction undefined."}],"criteria":[{"marks":1,"point":"Critical values","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-036","group":"X11-F1-036","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of the left half of a parabola","prompt":"Find the inverse of $f(x)=(x-1)^{2}$, $x\\le1$.","answerType":"expression","answer":{"expr":"1-sqrt(x)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","The range of f⁻¹ is x ≤ 1."],"ladder":{"nudge":"Swap x and y.","method":"The range of f⁻¹ is x ≤ 1."},"steps":[{"h":"Swap","d":"$x=(y-1)^{2}$, $y\\le1$"},{"h":"Root","d":"$y-1=-\\sqrt x$"}],"traps":[{"expr":"1+sqrt(x)","why":"The inverse must have y ≤ 1."}],"criteria":[{"marks":1,"point":"Chooses the negative root","manual":true},{"marks":1,"point":"1 − √x","answer":true}]},{"id":"X11-F1-039","group":"X11-F1-039","dp":"F1.1a","authored":3,"level":3,"marks":3,"title":"Comparing two reciprocals","prompt":"Solve $\\dfrac{1}{x-1}<\\dfrac{1}{x+1}$.","answerType":"interval","answer":{"region":"-1 < x < 1","variable":"x"},"hints":["Bring to one side.","The numerator 2 is positive."],"ladder":{"nudge":"Bring to one side.","method":"The numerator 2 is positive."},"steps":[{"h":"One side","d":"$\\dfrac{1}{x-1}-\\dfrac{1}{x+1}=\\dfrac{2}{(x-1)(x+1)}<0$"},{"h":"Signs","d":"$(x-1)(x+1)<0$"},{"h":"Solve","d":"$-1<x<1$"}],"traps":[{"region":"x < -1 or x > 1","why":"Reversed the sign condition."}],"criteria":[{"marks":1,"point":"Single fraction","line":"2/((x-1)*(x+1)) < 0"},{"marks":1,"point":"Sign of denominator","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-044","group":"X11-F1-044","dp":"F1.2a","authored":3,"level":3,"marks":3,"title":"Fraction greater than two","prompt":"Solve $\\dfrac{x}{x-2}>2$.","answerType":"interval","answer":{"region":"2 < x < 4","variable":"x"},"hints":["Combine into one fraction."],"ladder":{"nudge":"Combine into one fraction."},"steps":[{"h":"One side","d":"$\\dfrac{x-2(x-2)}{x-2}=\\dfrac{4-x}{x-2}>0$"},{"h":"Signs","d":"Critical values $2$ and $4$"},{"h":"Solve","d":"$2<x<4$"}],"traps":[{"region":"x > 4","why":"Multiplied by x − 2 assuming it is positive."}],"criteria":[{"marks":1,"point":"Single fraction","line":"(4-x)/(x-2) > 0"},{"marks":1,"point":"Critical values","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-047","group":"X11-F1-047","dp":"F1.1a","authored":2,"level":2,"marks":2,"title":"Reciprocal at least one","prompt":"Solve $\\dfrac{3}{x+1}\\ge1$.","answerType":"interval","answer":{"region":"-1 < x <= 2","variable":"x"},"hints":[],"ladder":{},"steps":[{"h":"One side","d":"$\\dfrac{2-x}{x+1}\\ge0$"},{"h":"Signs","d":"$-1<x\\le2$"}],"traps":[{"region":"x <= 2","why":"x + 1 may be negative."}],"criteria":[{"marks":1,"point":"Single fraction","line":"(2-x)/(x+1) >= 0"},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-048","group":"X11-F1-048","dp":"F1.1b","authored":1,"level":1,"marks":2,"title":"Absolute value greater than four","prompt":"Solve $|3x-2|>4$.","answerType":"interval","answer":{"region":"x < -2/3 or x > 2","variable":"x"},"hints":["|u| > 4 means u > 4 or u < −4."],"ladder":{"nudge":"|u| > 4 means u > 4 or u < −4."},"steps":[{"h":"Split","d":"$3x-2>4$ or $3x-2<-4$"}],"traps":[{"region":"-2/3 < x < 2","why":"That is |3x − 2| < 4."}],"criteria":[{"marks":1,"point":"Both cases","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-049","group":"X11-F1-049","dp":"F1.4a","authored":1,"level":1,"marks":1,"title":"Parametric parabola","prompt":"Find the Cartesian equation of $x=2t-1$, $y=4t^{2}$.","answerType":"expression","answer":{"expr":"(x+1)^2"},"answerPrefix":"y =","hints":["Solve for 2t.","y = (2t)²."],"ladder":{"nudge":"Solve for 2t.","method":"y = (2t)²."},"steps":[{"h":"Eliminate","d":"$2t=x+1\\Rightarrow y=(2t)^{2}$"}],"traps":[{"expr":"(x+1)^2/4","why":"4t² = (2t)²."}],"criteria":[{"marks":1,"point":"Correct equation","answer":true}]},{"id":"X11-F1-051","group":"X11-F1-051","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of the right half of a parabola","prompt":"Find the inverse of $f(x)=x^{2}-2x$, $x\\ge1$, and state its domain.","answerType":"expression","answer":{"expr":"1+sqrt(x+1)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Choose the positive root."],"ladder":{"nudge":"Swap x and y.","method":"Choose the positive root."},"steps":[{"h":"Complete the square","d":"$x=(y-1)^{2}-1$"},{"h":"Solve","d":"$y=1+\\sqrt{x+1}$"}],"traps":[{"expr":"1-sqrt(x+1)","why":"Need y ≥ 1."}],"criteria":[{"marks":1,"point":"Completes the square","line":"x = (y-1)^2-1"},{"marks":1,"point":"Inverse with domain","answer":true}]},{"id":"X11-F1-052","group":"X11-F1-052","dp":"F1.1b","authored":2,"level":2,"marks":2,"title":"Absolute value inside a quadratic","prompt":"Solve $x^{2}-|x|-6=0$.","answerType":"set","answer":{"values":[-3,3]},"answerPrefix":"x =","hints":["x² = |x|².","Let u = |x|."],"ladder":{"nudge":"x² = |x|².","method":"Let u = |x|."},"steps":[{"h":"Substitute","d":"$u=|x|$: $u^{2}-u-6=0\\Rightarrow u=3$ (reject $-2$)"},{"h":"Solve","d":"$|x|=3$"}],"traps":[{"values":[3,-2],"why":"|x| cannot be −2."}],"criteria":[{"marks":1,"point":"u = 3 only","line":"u = 3"},{"marks":1,"point":"x = ±3","answer":true}]},{"id":"X11-F1-054","group":"X11-F1-054","dp":"F1.1a","authored":3,"level":3,"marks":3,"title":"Reciprocal greater than x","prompt":"Solve $\\dfrac1x>x$.","answerType":"interval","answer":{"region":"x < -1 or 0 < x < 1","variable":"x"},"hints":["Do not multiply by x.","Combine into one fraction."],"ladder":{"nudge":"Do not multiply by x.","method":"Combine into one fraction."},"steps":[{"h":"One side","d":"$\\dfrac{1-x^{2}}{x}>0$"},{"h":"Critical values","d":"$-1,0,1$"},{"h":"Signs","d":"$x<-1$ or $0<x<1$"}],"traps":[{"region":"-1 < x < 1","why":"Multiplied by x without considering its sign."}],"criteria":[{"marks":1,"point":"Single fraction","line":"(1-x^2)/x > 0"},{"marks":1,"point":"Critical values","manual":true},{"marks":1,"point":"Correct solution","answer":true}]},{"id":"X11-F1-056","group":"X11-F1-056","dp":"F1.2a","authored":2,"level":2,"marks":2,"title":"Fraction less than one","prompt":"Solve $\\dfrac{x+3}{x-1}<1$.","answerType":"interval","answer":{"region":"x < 1","variable":"x"},"hints":["Bring everything to one side."],"ladder":{"nudge":"Bring everything to one side."},"steps":[{"h":"Rearrange","d":"$\\dfrac{x+3-(x-1)}{x-1}<0$"},{"h":"Simplify","d":"$\\dfrac{4}{x-1}<0$"}],"traps":[{"region":"x > 1","why":"4/(x − 1) is negative only when x < 1."}],"criteria":[{"marks":1,"point":"Single fraction","line":"4/(x-1) < 0"},{"marks":1,"point":"x < 1","answer":true}]},{"id":"X11-F1-057","group":"X11-F1-057","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Inverse of an exponential with a shift","prompt":"Find the inverse of $f(x)=e^{x}+2$ and state its domain.","answerType":"expression","answer":{"expr":"ln(x-2)"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Range of f becomes domain of f⁻¹."],"ladder":{"nudge":"Swap x and y.","method":"Range of f becomes domain of f⁻¹."},"steps":[{"h":"Swap","d":"$x=e^{y}+2$"},{"h":"Solve","d":"$y=\\ln(x-2)$, domain $x>2$"}],"traps":[{"expr":"ln(x)-2","why":"Subtract 2 before taking the log."}],"criteria":[{"marks":1,"point":"Domain x > 2","manual":true},{"marks":1,"point":"Correct inverse","answer":true}]},{"id":"X11-F1-058","group":"X11-F1-058","dp":"F1.4a","authored":1,"level":1,"marks":1,"title":"Parametric line to Cartesian","prompt":"Find the Cartesian equation of the curve $x=2t+1$, $y=4t-3$.","answerType":"equation","answer":{"lhs":"y","rhs":"2*x-5"},"hints":["Make t the subject."],"ladder":{"nudge":"Make t the subject."},"steps":[{"h":"Eliminate","d":"$t=\\tfrac{x-1}{2}$"}],"traps":[{"eq":"y = 2*x-3","why":"Substitute t carefully."}],"criteria":[{"marks":1,"point":"y = 2x − 5","answer":true}]},{"id":"X11-F1-059","group":"X11-F1-059","dp":"F1.1b","authored":3,"level":3,"marks":2,"title":"Absolute value against a line","prompt":"Solve $|x-3|\\ge 2x$.","answerType":"interval","answer":{"region":"x <= 1","variable":"x"},"hints":["Split at x = 3.","Keep solutions inside each case."],"ladder":{"nudge":"Split at x = 3.","method":"Keep solutions inside each case."},"steps":[{"h":"Case x ≥ 3","d":"$x-3\\ge2x\\Rightarrow x\\le-3$: none"},{"h":"Case x < 3","d":"$3-x\\ge2x\\Rightarrow x\\le1$"}],"traps":[{"region":"x <= -3","why":"That case has no solutions with x ≥ 3."}],"criteria":[{"marks":1,"point":"Both cases considered","manual":true},{"marks":1,"point":"x ≤ 1","answer":true}]},{"id":"X11-F1-063","group":"X11-F1-063","dp":"F1.4a","authored":2,"level":2,"marks":1,"title":"Parametric circle with a shifted centre","prompt":"Find the Cartesian equation of $x=3+2\\cos\\theta$, $y=-1+2\\sin\\theta$.","answerType":"equation","answer":{"lhs":"(x-3)^2+(y+1)^2","rhs":"4"},"hints":["Isolate cos θ and sin θ."],"ladder":{"nudge":"Isolate cos θ and sin θ."},"steps":[{"h":"Eliminate","d":"$\\cos^{2}\\theta+\\sin^{2}\\theta=1$"}],"traps":[{"eq":"(x+3)^2+(y-1)^2 = 4","why":"Signs of the centre."}],"criteria":[{"marks":1,"point":"Correct equation","answer":true}]},{"id":"X11-F1-064","group":"X11-F1-064","dp":"F1.3a","authored":2,"level":2,"marks":1,"title":"Inverse of a reciprocal function","prompt":"Find the inverse of $f(x)=\\dfrac{2}{x-1}$.","answerType":"expression","answer":{"expr":"1+2/x"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Make y the subject."],"ladder":{"nudge":"Swap x and y.","method":"Make y the subject."},"steps":[{"h":"Swap","d":"$x=\\dfrac{2}{y-1}\\Rightarrow y-1=\\dfrac2x$"}],"traps":[{"expr":"(x-1)/2","why":"That is the reciprocal."}],"criteria":[{"marks":1,"point":"Correct inverse","answer":true}]},{"id":"X11-F1-068","group":"X11-F1-068","dp":"F1.4a","authored":2,"level":2,"marks":1,"title":"Parametric parabola to Cartesian","prompt":"Find the Cartesian equation of $x=2t$, $y=t^{2}-1$.","answerType":"equation","answer":{"lhs":"y","rhs":"x^2/4-1"},"hints":["t = x/2."],"ladder":{"nudge":"t = x/2."},"steps":[{"h":"Eliminate","d":"$t=\\tfrac x2$"}],"traps":[{"eq":"y = x^2/2-1","why":"(x/2)² = x²/4."}],"criteria":[{"marks":1,"point":"Correct equation","answer":true}]},{"id":"X11-F1-073","group":"X11-F1-073","dp":"F1.1a","authored":2,"level":2,"marks":1,"title":"Composite domain","prompt":"For $f(x)=\\sqrt{x}$ and $g(x)=4-x^{2}$, find the domain of $f(g(x))$.","answerType":"interval","answer":{"region":"-2 <= x <= 2","variable":"x"},"hints":["Inside must be ≥ 0.","Solve 4 − x² ≥ 0."],"ladder":{"nudge":"Inside must be ≥ 0.","method":"Solve 4 − x² ≥ 0."},"steps":[{"h":"Need","d":"$4-x^{2}\\ge0$"}],"traps":[{"region":"x >= 0","why":"That is the domain of f only."}],"criteria":[{"marks":1,"point":"−2 ≤ x ≤ 2","answer":true}]},{"id":"X11-F1-077","group":"X11-F1-077","dp":"F1.2a","authored":3,"level":3,"marks":2,"title":"Inequality with absolute values on both sides","prompt":"Solve $|x+1|>|x-3|$.","answerType":"interval","answer":{"region":"x > 1","variable":"x"},"hints":["Both sides non-negative."],"ladder":{"nudge":"Both sides non-negative."},"steps":[{"h":"Square","d":"$(x+1)^{2}>(x-3)^{2}$"},{"h":"Simplify","d":"$8x>8$"}],"traps":[{"region":"x < 1","why":"Closer to 3 than to −1."}],"criteria":[{"marks":1,"point":"Squares both sides","manual":true},{"marks":1,"point":"x > 1","answer":true}]},{"id":"X11-F1-078","group":"X11-F1-078","dp":"F1.3a","authored":2,"level":2,"marks":1,"title":"Inverse of a log function with a shift","prompt":"Find the inverse of $f(x)=\\ln(2x)+1$.","answerType":"expression","answer":{"expr":"exp(x-1)/2"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Subtract 1.","Exponentiate and divide by 2."],"ladder":{"nudge":"Swap x and y.","method":"Subtract 1.","worked":"Exponentiate and divide by 2."},"steps":[{"h":"Swap","d":"$x-1=\\ln2y$"}],"traps":[{"expr":"exp(x)/2-1","why":"Subtract 1 before exponentiating."}],"criteria":[{"marks":1,"point":"Correct inverse","answer":true}]},{"id":"X11-F1-079","group":"X11-F1-079","dp":"F1.4a","authored":2,"level":2,"marks":1,"title":"Parametric curve with trig and a scale","prompt":"Find the Cartesian equation of $x=3\\cos t$, $y=2\\sin t$.","answerType":"equation","answer":{"lhs":"x^2/9+y^2/4","rhs":"1"},"hints":["cos t = x/3.","sin t = y/2."],"ladder":{"nudge":"cos t = x/3.","method":"sin t = y/2."},"steps":[{"h":"Eliminate","d":"$\\cos^{2}t+\\sin^{2}t=1$"}],"traps":[{"eq":"x^2+y^2 = 13","why":"Divide by each scale first."}],"criteria":[{"marks":1,"point":"Correct equation","answer":true}]},{"id":"X11-F1-081","group":"X11-F1-081","dp":"F1.2a","authored":3,"level":3,"marks":1,"title":"Rational inequality with a squared denominator","prompt":"Solve $\\dfrac{x+2}{(x-1)^{2}}\\le0$.","answerType":"interval","answer":{"region":"x <= -2","variable":"x"},"hints":["(x − 1)² > 0.","Exclude x = 1."],"ladder":{"nudge":"(x − 1)² > 0.","method":"Exclude x = 1."},"steps":[{"h":"Sign","d":"Denominator positive for $x\\ne1$"}],"traps":[{"region":"x < 1","why":"Only the numerator controls the sign."}],"criteria":[{"marks":1,"point":"x ≤ −2","answer":true}]},{"id":"X11-F1-083","group":"X11-F1-083","dp":"F1.3a","authored":3,"level":3,"marks":1,"title":"Inverse function intersection","prompt":"Find where $f(x)=x^{3}$ meets its inverse.","answerType":"set","answer":{"values":[-1,0,1]},"answerPrefix":"x =","hints":["Increasing function meets its inverse on y = x.","Solve x³ = x."],"ladder":{"nudge":"Increasing function meets its inverse on y = x.","method":"Solve x³ = x."},"steps":[{"h":"On y = x","d":"$x^{3}=x$"}],"traps":[{"values":[0,1],"why":"x = −1 also works."}],"criteria":[{"marks":1,"point":"All three","answer":true}]},{"id":"X11-F1-084","group":"X11-F1-084","dp":"F1.4a","authored":2,"level":2,"marks":1,"title":"Parametric equations to a hyperbola","prompt":"Find the Cartesian equation of $x=t+1$, $y=\\dfrac{2}{t}$.","answerType":"equation","answer":{"lhs":"y","rhs":"2/(x-1)"},"hints":["Make t the subject."],"ladder":{"nudge":"Make t the subject."},"steps":[{"h":"Eliminate","d":"$t=x-1$"}],"traps":[{"eq":"y = 2/(x+1)","why":"t = x − 1."}],"criteria":[{"marks":1,"point":"Correct equation","answer":true}]},{"id":"X11-F1-087","group":"X11-F1-087","dp":"F1.3a","authored":2,"level":2,"marks":2,"title":"Composite and inverse check","prompt":"Given $f(x)=3x-2$, find $f^{-1}(x)$ and verify that $f\\left(f^{-1}(x)\\right)=x$.","answerType":"expression","answer":{"expr":"(x+2)/3"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Make y the subject."],"ladder":{"nudge":"Swap x and y.","method":"Make y the subject."},"steps":[{"h":"Swap","d":"$x=3y-2$"},{"h":"Verify","d":"$3\\cdot\\tfrac{x+2}{3}-2=x$"}],"traps":[{"expr":"(x-2)/3","why":"Add 2 before dividing."}],"criteria":[{"marks":1,"point":"Verification","manual":true},{"marks":1,"point":"Correct inverse","answer":true}]},{"id":"X11-F1-089","group":"X11-F1-089","dp":"F1.1b","authored":3,"level":3,"marks":2,"title":"Region between absolute value and a line","prompt":"Solve $|2x-3|\\le x$.","answerType":"interval","answer":{"region":"1 <= x <= 3","variable":"x"},"hints":["|u| ≤ x means −x ≤ u ≤ x."],"ladder":{"nudge":"|u| ≤ x means −x ≤ u ≤ x."},"steps":[{"h":"Double inequality","d":"$-x\\le2x-3\\le x$"},{"h":"Solve","d":"$x\\ge1$ and $x\\le3$"}],"traps":[{"region":"x <= 3","why":"Also need x ≥ 1."}],"criteria":[{"marks":1,"point":"Double inequality","manual":true},{"marks":1,"point":"1 ≤ x ≤ 3","answer":true}]},{"id":"X11-F1-098","group":"X11-F1-098","dp":"F1.4a","authored":2,"level":2,"marks":1,"title":"Parametric line segment length","prompt":"Find the length of the curve $x=1+3t$, $y=2-4t$ for $0\\le t\\le2$.","answerType":"numeric","answer":{"value":10},"hints":["It is a line segment."],"ladder":{"nudge":"It is a line segment."},"steps":[{"h":"Endpoints","d":"$(1,2)$ to $(7,-6)$"}],"traps":[{"value":5,"why":"That is for 0 ≤ t ≤ 1."}],"criteria":[{"marks":1,"point":"10","answer":true}]},{"id":"X11-F1-104","group":"X11-F1-104","dp":"F1.4a","authored":4,"level":4,"marks":1,"title":"Parametric tangent gradient","prompt":"For $x=t^{2}$, $y=2t$, find the gradient at the point where $t=3$ using $\\dfrac{dy}{dx}=\\dfrac{dy/dt}{dx/dt}$.","answerType":"numeric","answer":{"value":0.3333333333333333},"hints":["dy/dt = 2.","dx/dt = 2t."],"ladder":{"nudge":"dy/dt = 2.","method":"dx/dt = 2t."},"steps":[{"h":"Ratio","d":"$\\dfrac{2}{2t}$ at $3$"}],"traps":[{"value":3,"why":"Inverted."}],"criteria":[{"marks":1,"point":"⅓","answer":true}]},{"id":"X11-F1-108","group":"X11-F1-108","dp":"F1.1b","authored":4,"level":4,"marks":2,"title":"Number of solutions of an absolute value equation","prompt":"By sketching $y=|x^{2}-4|$, find the number of solutions of $|x^{2}-4|=3$ and find them all.","answerType":"numeric","answer":{"value":4},"answerPrefix":"number =","hints":["Reflect the part below the axis."],"ladder":{"nudge":"Reflect the part below the axis."},"steps":[{"h":"Cases","d":"$x^{2}-4=3$ or $x^{2}-4=-3$"},{"h":"Solve","d":"$x=\\pm\\sqrt7$, $x=\\pm1$"}],"traps":[{"value":2,"why":"The reflected section also meets y = 3."}],"criteria":[{"marks":1,"point":"Both cases","manual":true},{"marks":1,"point":"4 solutions","answer":true}]},{"id":"X11-F1-112","group":"X11-F1-112","dp":"F1.4a","authored":3,"level":3,"marks":2,"title":"Parametric parabola to Cartesian form","prompt":"Find the Cartesian equation of the curve $x=2t$, $y=t^{2}-1$ and state its vertex.","answerType":"expression","answer":{"expr":"x^2/4-1"},"answerPrefix":"y =","hints":["Make t the subject."],"ladder":{"nudge":"Make t the subject."},"steps":[{"h":"Eliminate","d":"$t=\\tfrac x2$"},{"h":"Substitute","d":"$y=\\tfrac{x^{2}}{4}-1$"}],"traps":[{"expr":"x^2/2-1","why":"Square x/2 correctly."}],"criteria":[{"marks":1,"point":"Eliminate t","manual":true},{"marks":1,"point":"Equation","answer":true}]},{"id":"X11-F1-141","group":"X11-F1-141","dp":"F1.4a","authored":3,"level":3,"marks":2,"title":"Eliminating a reciprocal parameter","prompt":"A curve has $x=\\dfrac1t$, $y=t-\\dfrac1t$ ($t\\ne0$). Find its Cartesian equation.","answerType":"expression","answer":{"expr":"1/x-x"},"answerPrefix":"y =","hints":[],"ladder":{},"steps":[{"h":"Parameter","d":"$t=\\tfrac1x$"},{"h":"Substitute","d":"$y=\\tfrac1x-x$"}],"traps":[{"expr":"x-1/x","why":"t = 1/x and 1/t = x."}],"criteria":[{"marks":1,"point":"t in x","manual":true},{"marks":1,"point":"Equation","answer":true}]}]}
