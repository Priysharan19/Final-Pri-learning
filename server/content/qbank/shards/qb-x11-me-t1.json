ade1b5","bytes":6913}},{"id":"X11-T1-053","group":"X11-T1-053","dp":"T1.1a","authored":1,"level":1,"marks":1,"title":"Derivative-free inverse value","prompt":"Evaluate $\\sin^{-1}\\left(\\tfrac{\\sqrt2}{2}\\right)-\\cos^{-1}\\left(\\tfrac{\\sqrt2}{2}\\right)$.","answerType":"numeric","answer":{"value":0},"hints":["sin⁻¹(√2/2) = π/4."],"ladder":{"nudge":"sin⁻¹(√2/2) = π/4."},"steps":[{"h":"Values","d":"$\\tfrac{\\pi}{4}-\\tfrac{\\pi}{4}$"}],"traps":[{"value":1.5707963267948966,"why":"Both equal π/4.","expr":"pi/2"}],"criteria":[{"marks":1,"point":"0","answer":true}]},{"id":"X11-T1-056","group":"X11-T1-056","dp":"T1.1a","authored":2,"level":2,"marks":1,"title":"Exact value of a cosine of an inverse tangent","prompt":"Find the exact value of $\\cos\\left(\\tan^{-1}\\tfrac{3}{4}\\right)$.","answerType":"numeric","answer":{"value":0.8},"hints":["Draw the triangle.","Adjacent/hypotenuse."],"ladder":{"nudge":"Draw the triangle.","method":"Adjacent/hypotenuse."},"steps":[{"h":"Triangle","d":"Opposite $3$, adjacent $4$, hypotenuse $5$"}],"traps":[{"value":0.6,"why":"That is the sine.","expr":"3/5"}],"criteria":[{"marks":1,"point":"4/5","answer":true}]},{"id":"X11-T1-057","group":"X11-T1-057","dp":"T1.1c","authored":2,"level":2,"marks":1,"title":"Inverse cosine equation","prompt":"Solve $2\\cos^{-1}x=\\dfrac{2\\pi}{3}$.","answerType":"numeric","answer":{"value":0.5},"answerPrefix":"x =","hints":["Divide by 2.","Take cos."],"ladder":{"nudge":"Divide by 2.","method":"Take cos."},"steps":[{"h":"Halve","d":"$\\cos^{-1}x=\\tfrac{\\pi}{3}$"}],"traps":[{"value":-0.5,"why":"cos(π/3) = ½.","expr":"-1/2"}],"criteria":[{"marks":1,"point":"½","answer":true}]},{"id":"X11-T1-060","group":"X11-T1-060","dp":"T1.1a","authored":3,"level":3,"marks":1,"title":"Inverse cosine of cosine of a large angle","prompt":"Evaluate $\\cos^{-1}\\left(\\cos\\dfrac{7\\pi}{6}\\right)$.","answerType":"numeric","answer":{"value":2.6179938779914944},"hints":["Evaluate the inside.","Range [0, π]."],"ladder":{"nudg