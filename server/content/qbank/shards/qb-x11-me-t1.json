ide by 2.","method":"Take sine."},"steps":[{"h":"Solve","d":"$\\sin^{-1}x=\\tfrac{\\pi}{6}\\Rightarrow x=\\tfrac12$"}],"traps":[{"value":0.8660254037844386,"why":"Used π/3 without halving.","expr":"sqrt(3)/2"}],"criteria":[{"marks":1,"point":"x = ½","answer":true}]},{"id":"X11-T1-020","group":"X11-T1-020","dp":"T1.1b","authored":3,"level":3,"marks":3,"title":"Inverse of a reflected inverse cosine","prompt":"Let $f(x)=\\pi-\\cos^{-1}(2x)$. Find $f^{-1}(x)$ and its domain.","answerType":"expression","answer":{"expr":"-cos(x)/2"},"answerPrefix":"f⁻¹(x) =","hints":["Swap x and y.","Take cosine of both sides."],"ladder":{"nudge":"Swap x and y.","method":"Take cosine of both sides."},"steps":[{"h":"Swap","d":"$x=\\pi-\\cos^{-1}(2y)\\Rightarrow\\cos^{-1}(2y)=\\pi-x$"},{"h":"Solve","d":"$y=\\tfrac12\\cos(\\pi-x)=-\\tfrac12\\cos x$"},{"h":"Domain","d":"Range of $f$: $[0,\\pi]$"}],"traps":[{"expr":"cos(x)/2","why":"cos(π − x) = −cos x."}],"criteria":[{"marks":1,"point":"Isolates cos⁻¹","manual":true},{"marks":1,"point":"Domain [0, π]","manual":true},{"marks":1,"point":"−½ cos x","answer":true}]},{"id":"X11-T1-024","group":"X11-T1-024","dp":"T1.1a","authored":2,"level":2,"marks":2,"title":"Two negative inverse values","prompt":"Find the exact value of $\\sin^{-1}\\!\\left(-\\tfrac{\\sqrt3}{2}\\right)+\\tan^{-1}(-1)$.","answerType":"numeric","answer":{"value":-1.8325957145940461},"hints":["Both functions are odd.","sin⁻¹(√3/2) = π/3.","tan⁻¹ 1 = π/4."],"ladder":{"nudge":"Both functions are odd.","method":"sin⁻¹(√3/2) = π/3.","worked":"tan⁻¹ 1 = π/4."},"steps":[{"h":"Values","d":"$-\\tfrac{\\pi}{3}$ and $-\\tfrac{\\pi}{4}$"}],"traps":[{"value":-0.2617993877991494,"why":"Subtracted instead of adding.","expr":"-pi/12"}],"criteria":[{"marks":1,"point":"Both values","line":"-pi/3-pi/4"},{"marks":1,"point":"−7π/12","answer":true}]},{"id":"X11-T1-025","group":"X11-T1-025","dp":"T1.1c","authored":4,"level":4,"marks":3,"title":"Equation in two inverse tangents","prompt":"Solve $\\tan^{-1}x+\\tan^{-1}2x=\\dfrac{\\pi}{4}$.","answerType":"numeric","answer":{"value":0.28077640640441515},"answerPrefix":"x =","hints":["Take tan of both sides.","Solve the quadratic.","Check each root in the original equation."],"ladder":{"nudge":"Take tan of both sides.","method":"Solve the quadratic.","worked":"Check each root in the original equation."},"steps":[{"h":"Tangent of both sides","d":"$\\dfrac{3x}{1-2x^{2}}=1\\Rightarrow2x^{2}+3x-1=0$"},{"h":"Roots","d":"$x=\\dfrac{-3\\pm\\sqrt{17}}{4}$"},{"h":"Reject","d":"The negative root makes both inverse tangents negative, so the sum is negative: reject."}],"traps":[{"value":-1.7807764064044151,"why":"That root gives a negative sum, −3π/4.","expr":"(-3-sqrt(17))/4"}],"criteria":[{"marks":1,"point":"2x² + 3x − 1 = 0","line":"2*x^2+3*x-1 = 0"},{"marks":1,"point":"Both roots","manual":true},{"marks":1,"point":"Rejects the negative root","answer":true}]},{"id":"X11-T1-027","group":"X11-T1-027","dp":"T1.1a","authored":2,"level":2,"marks":2,"title":"Cosine of a negative inverse sine","prompt":"Find the exact value of $\\cos\\left(\\sin^{-1}\\left(-\\tfrac13\\right)\\right)$.","answerType":"numeric","answer":{"value":0.9428090415820634},"hints":["Find the quadrant of θ.","Use Pythagoras.","Choose the sign."],"ladder":{"nudge":"Find the quadrant of θ.","method":"Use Pythagoras.","worked":"Choose the sign."},"steps":[{"h":"Angle","d":"$\\theta\\in\\left[-\\tfrac{\\pi}{2},0\\right)$ with $\\sin\\theta=-\\tfrac13$"},{"h":"Cosine","d":"$\\cos\\theta=\\sqrt{1-\\tfrac19}>0$"}],"traps":[{"value":-0.9428090415820635,"why":"Cosine is positive in quadrant 4.","expr":"-2*sqrt(2)/3"}],"criteria":[{"marks":1,"point":"Cosine is positive in this range","manual":true},{"marks":1,"point":"2√2/3","answer":true}]},{"id":"X11-T1-029","group":"X11-T1-029","dp":"T1.1c","authored":1,"level":1,"marks":1,"title":"Solving an inverse sine equation","prompt":"Solve $\\sin^{-1}(2x-1)=\\dfrac{\\pi}{6}$.","answerType":"numeric","answer":{"value":0.75},"answ