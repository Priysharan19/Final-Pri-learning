oth","answer":true}]},{"id":"A11-T2-092","group":"A11-T2-092","dp":"T2.1e","authored":3,"level":3,"marks":1,"title":"Number of solutions of a sine equation on a wide domain","prompt":"How many solutions does $\\sin x=0.7$ have for $0\\le x\\le6\\pi$?","answerType":"numeric","answer":{"value":6},"hints":["Period 2π.","Two per period.","Three periods."],"steps":[{"h":"Count","d":"Two per period, three periods"}],"traps":[{"value":2,"why":"Three periods."}],"criteria":[{"marks":1,"point":"6","answer":true}]},{"id":"A11-T2-093","group":"A11-T2-093","dp":"T2.1e","authored":4,"level":4,"marks":2,"title":"Graph of an absolute sine","prompt":"The graph of $y=|\\sin x|$ for $0\\le x\\le2\\pi$ is shown. Solve $|\\sin x|=\\tfrac12$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,3.6651914291880923,5.759586531581288]},"answerPrefix":"x =","hints":["Absolute value gives ±.","Four solutions.","Read the graph."],"steps":[{"h":"Cases","d":"$\\sin x=\\pm\\tfrac12$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"The reflected arch gives two more."}],"criteria":[{"marks":1,"point":"Both cases","manual":true},{"marks":1,"point":"All four","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Labels shown: pi, 2 pi. Marked on the horizontal axis: pi, 2 pi; vertical axis: 0.5, 1. Read the question for what it asks.","w":245.65,"h":101.03,"sha256":"3b4f6e3bd37f0f53201efa93054e1d934c796beb2f7fbc3edd2ab85052846c41","bytes":11394}},{"id":"A11-T2-095","group":"A11-T2-095","dp":"T2.1a","authored":3,"level":3,"marks":1,"title":"Exact value of a large angle","prompt":"Find the exact value of $\\cos\\dfrac{17\\pi}{6}$.","answerType":"numeric","answer":{"value":-0.8660254037844386},"hints":["Subtract 2π.","Second quadrant.","Related π/6."],"steps":[{"h":"Reduce","d":"$\\tfrac{17\\pi}{6}-2\\pi=\\tfrac{5\\pi}{6}$"}],"traps":[{"value":0.8660254037844386,"why":"Second quadrant cosine is negative.","expr":"sqrt(3)/2"}],"criteria":[{"marks":1,"point":"Exact value","answer":true}]},{"id":"A11-T2-097","group":"A11-T2-097","dp":"T2.1a","authored":3,"level":3,"marks":2,"title":"Exact value expression with mixed angles","prompt":"Evaluate $\\sin\\dfrac{2\\pi}{3}\\cos\\dfrac{5\\pi}{6}-\\tan\\dfrac{3\\pi}{4}$.","answerType":"numeric","answer":{"value":0.25},"hints":["Each exact value.","Watch the signs.","Simplify."],"steps":[{"h":"Values","d":"$\\tfrac{\\sqrt3}{2}\\cdot\\left(-\\tfrac{\\sqrt3}{2}\\right)-(-1)$"}],"traps":[{"value":-1.75,"why":"tan(3π/4) = −1.","expr":"-7/4"}],"criteria":[{"marks":1,"point":"Each value","manual":true},{"marks":1,"point":"¼","answer":true}]},{"id":"A11-T2-098","group":"A11-T2-098","dp":"T2.1a","authored":4,"level":4,"marks":2,"title":"Unit circle symmetry relation","prompt":"Given $\\sin\\alpha=0.6$ with $\\alpha$ acute, find $\\sin(\\pi+\\alpha)+\\cos(\\pi-\\alpha)+\\tan(2\\pi-\\alpha)$.","answerType":"numeric","answer":{"value":-2.15},"hints":["cos α = 0.8, tan α = 0.75.","Related-angle signs.","Add."],"steps":[{"h":"Related angles","d":"$-\\sin\\alpha-\\cos\\alpha-\\tan\\alpha$"},{"h":"Values","d":"$-0.6-0.8-0.75$"}],"traps":[{"value":-0.65,"why":"Each term is negative."}],"criteria":[{"marks":1,"point":"Signs","manual":true},{"marks":1,"point":"−2.15","answer":true}]},{"id":"A11-T2-099","group":"A11-T2-099","dp":"T2.1a","authored":4,"level":4,"marks":1,"title":"Angle from two sign conditions","prompt":"Find $\\theta$ in $[0,2\\pi)$ with $\\sin\\theta=-\\tfrac{\\sqrt2}{2}$ and $\\cos\\theta>0$.","answerType":"numeric","answer":{"value":5.497787143782138},"hints":["sin negative, cos positive.","Fourth quadrant.","Related π/4."],"steps":[{"h":"Quadrant","d":"Fourth"}],"traps":[{"value":3.9269908169872414,"why":"Cosine is negative there.","expr":"5*pi/4"}],"criteria":[{"marks":1,"point":"7π/4","answer":true}]},{"id":"A11-T2-100","group":"A11-T2-100","dp":"T2.1a","authored":4,"level":4,"marks":2,"title":"Exact value of a sum of squares of sines","prompt":"Evaluate $\\sin^{2}\\dfrac{\\pi}{6}+\\sin^{2}\\dfrac{\\pi}{3}+\\sin^{2}\\dfrac{\\pi}{2}+\\sin^{2}\\dfrac{2\\pi}{3}+\\sin^{2}\\dfrac{5\\pi}{6}$.","answerType":"numeric","answer":{"value":3},"hints":["Each exact value.","Square.","Add."],"steps":[{"h":"Values","d":"$\\tfrac14+\\tfrac34+1+\\tfrac34+\\tfrac14$"}],"traps":[{"value":2,"why":"Include sin²(π/2) = 1."}],"criteria":[{"marks":1,"point":"Values","manual":true},{"marks":1,"point":"3","answer":true}]},{"id":"A11-T2-101","group":"A11-T2-101","dp":"T2.1b","authored":3,"level":3,"marks":1,"title":"Secant equation in degrees","prompt":"Solve $\\sec\\theta=-2$ for $0^\\circ\\le\\theta\\le360^\\circ$.","answerType":"set","answer":{"values":[120,240]},"answerPrefix":"θ =","hints":["Invert.","Related 60°.","Q2 and Q3."],"steps":[{"h":"Reciprocal","d":"$\\cos\\theta=-\\tfrac12$"}],"traps":[{"values":[60,300],"why":"cos is negative."}],"criteria":[{"marks":1,"point":"Both","answer":true}]},{"id":"A11-T2-104","group":"A11-T2-104","dp":"T2.1b","authored":4,"level":4,"marks":2,"title":"Equation with cotangent","prompt":"Solve $\\cot^{2}x=3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,3.6651914291880923,5.759586531581288]},"answerPrefix":"x =","hints":["Invert.","Both signs.","Four quadrants."],"steps":[{"h":"Tangent","d":"$\\tan x=\\pm\\tfrac{1}{\\sqrt3}$"}],"traps":[{"values":["pi/6","7*pi/6"],"why":"Negative root too."}],"criteria":[{"marks":1,"point":"tan x = ±1/√3","manual":true},{"marks":1,"point":"All four","answer":true}]},{"id":"A11-T2-106","group":"A11-T2-106","dp":"T2.1b","authored":2,"level":2,"marks":1,"title":"Reciprocal ratio expression","prompt":"Evaluate $\\sec^{2}\\dfrac{\\pi}{3}-\\tan^{2}\\dfrac{\\pi}{3}$.","answerType":"numeric","answer":{"value":1},"hints":["sec(π/3) = 2.","tan(π/3) = √3.","Subtract squares."],"steps":[{"h":"Values","d":"$4-3$"}],"traps":[{"value":7,"why":"Subtract."}],"criteria":[{"marks":1,"point":"1","answer":true}]},{"id":"A11-T2-112","group":"A11-T2-112","dp":"T2.1d","authored":4,"level":4,"marks":3,"title":"Equation with a squared cosine and sine","prompt":"Solve $2\\cos^{2}x=3\\sin x+3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[3.6651914291880923,4.71238898038469,5.759586531581288]},"answerPrefix":"x =","hints":["cos² = 1 − sin².","Rearrange.","Factor."],"steps":[{"h":"Pythagoras","d":"$2-2\\sin^{2}x=3\\sin x+3$"},{"h":"Factor","d":"$(2\\sin x+1)(\\sin x+1)=0$"}],"traps":[{"values":["7*pi/6","11*pi/6"],"why":"sin x = −1 too."}],"criteria":[{"marks":1,"point":"Quadratic in sin","line":"2*sin(x)^2+3*sin(x)+1 = 0"},{"marks":1,"point":"sin x = −½, −1","manual":true},{"marks":1,"point":"All three","answer":true}]},{"id":"A11-T2-113","group":"A11-T2-113","dp":"T2.1d","authored":4,"level":4,"marks":2,"title":"Equation with tan and sin","prompt":"Solve $\\tan x=2\\sin x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,1.0471975511965979,3.141592653589793,5.235987755982989,6.283185307179586]},"answerPrefix":"x =","hints":["Write tan as sin/cos.","Factor sin x.","Do not divide by sin x."],"steps":[{"h":"Factor","d":"$\\sin x\\left(\\tfrac{1}{\\cos x}-2\\right)=0$"},{"h":"Solve","d":"$\\sin x=0$ or $\\cos x=\\tfrac12$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"sin x = 0 too."}],"criteria":[{"marks":1,"point":"Factorises","manual":true},{"marks":1,"point":"All five","answer":true}]},{"id":"A11-T2-116","group":"A11-T2-116","dp":"T2.1e","authored":3,"level":3,"marks":1,"title":"Number of intersections of two trig graphs","prompt":"How many solutions does $\\cos x=\\sin x$ have in $0\\le x\\le4\\pi$?","answerType":"numeric","answer":{"value":4},"hints":["tan x = 1.","Period π.","Count in 4π."],"steps":[{"h":"Count","d":"Two per $2\\pi$"}],"traps":[{"value":2,"why":"Two periods."}],"criteria":[{"marks":1,"point":"4","answer":true}]},{"id":"A11-T2-119","group":"A11-T2-119","dp":"T2.1e","authored":4,"level":4,"marks":2,"title":"Graphical count of sine equal to a small line","prompt":"The graphs of $y=\\sin x$ and $y=\\tfrac{x}{10}$ are drawn. How many solutions does $\\sin x=\\tfrac{x}{10}$ have for $x\\ge0$?","answerType":"numeric","answer":{"value":4},"hints":["Line reaches 1 at x = 10.","Check each positive arch before 10.","Include x = 0."],"steps":[{"h":"Count","d":"Origin; once in $(\\tfrac{\\pi}{2},\\pi)$; twice in $(2\\pi,3\\pi)$ since the line is below $1$ until $x=10$"}],"traps":[{"value":3,"why":"The arch from 2π to 3π gives two crossings."}],"criteria":[{"marks":1,"point":"Counting argument","manual":true},{"marks":1,"point":"4","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Marked on the horizontal axis: 10; vertical axis: 1. Read the question for what it asks.","w":255,"h":102.38,"sha256":"d8cee67077343cb9f839c3d765e489852e52db94c05fb3978d928305c2c8d14a","bytes":10158}},{"id":"A11-T2-144","group":"A11-T2-144","dp":"T2.1e","authored":3,"level":3,"marks":2,"title":"Cosine graph with a dilation","prompt":"Sketch $y=\\cos2x$ for $0\\le x\\le2\\pi$ and find the number of solutions of $\\cos2x=-\\tfrac12$ in this interval.","answerType":"numeric","answer":{"value":4},"hints":["Period π.","Two cycles.","Count crossings."],"steps":[{"h":"Period","d":"$\\pi$, so two cycles"},{"h":"Count","d":"Two crossings per cycle"}],"traps":[],"criteria":[{"marks":1,"point":"Period","manual":true},{"marks":1,"point":"4","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Labels shown: pi, 2 pi. Marked on the horizontal axis: pi, 2 pi; vertical axis: minus 0.5, 1. Read the question for what it asks.","w":224.98,"h":87.25,"sha256":"0ebb3e2968c14e3b6b9e18add1cc6d58b80d0e3181614fc367b12417ef0b70d3","bytes":10873}},{"id":"A11-T2-164","group":"A11-T2-164","dp":"T2.1e","authored":2,"level":2,"marks":1,"title":"Intersection of a sine curve and a horizontal line","prompt":"How many solutions does $2\\sin x=1$ have for $0\\le x\\le4\\pi$?","answerType":"numeric","answer":{"value":4},"hints":["sin x = ½.","Two per 2π.","Two periods."],"steps":[{"h":"Count","d":"Two per period, two periods"}],"traps":[],"criteria":[{"marks":1,"point":"4","answer":true}]}]}
