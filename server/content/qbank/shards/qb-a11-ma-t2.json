{"family":"qb-a11-ma-t2","course":"ADV","year":11,"topic":"MA-T2","questions":[{"id":"A11-T2-001","group":"A11-T2-001","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Exact values beyond 90 degrees","prompt":"Find the exact value of $\\sin150^\\circ+\\cos225^\\circ\\tan300^\\circ$.","answerType":"numeric","answer":{"value":1.724744871391589},"hints":["Find the quadrant of each angle.","Use ASTC for the signs.","Use exact values for the related acute angles."],"ladder":{"nudge":"Find the quadrant of each angle.","method":"Use ASTC for the signs.","worked":"Use exact values for the related acute angles."},"steps":[{"h":"Related angles","d":"$\\sin150^\\circ = \\tfrac12$, $\\cos225^\\circ = -\\tfrac{\\sqrt2}{2}$, $\\tan300^\\circ = -\\sqrt3$"},{"h":"Combine","d":"$\\tfrac12+\\left(-\\tfrac{\\sqrt2}{2}\\right)\\left(-\\sqrt3\\right) = \\dfrac{1+\\sqrt6}{2}$"}],"traps":[{"value":-0.7247448713915889,"why":"Sign error: cos 225° and tan 300° are both negative, so their product is positive.","expr":"(1-sqrt(6))/2"}],"criteria":[{"marks":1,"point":"All three exact values with correct signs","line":"tan(300°) = -sqrt(3)"},{"marks":1,"point":"Correct exact value","answer":true}]},{"id":"A11-T2-005","group":"A11-T2-005","dp":"T2.1d","authored":3,"level":3,"marks":3,"title":"Quadratic in cosine","prompt":"Solve $2\\sin^{2}x=1+\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793,5.235987755982989]},"answerPrefix":"x =","hints":["Replace $\\sin^2x$ with $1-\\cos^2x$.","Solve each factor over $[0,2\\pi]$."],"ladder":{"nudge":"Replace $\\sin^2x$ with $1-\\cos^2x$.","method":"Solve each factor over $[0,2\\pi]$."},"steps":[{"h":"Write in cosine","d":"$2(1-\\cos^{2}x) = 1+\\cos x \\Rightarrow 2\\cos^{2}x+\\cos x-1 = 0$"},{"h":"Factorise","d":"$(2\\cos x-1)(\\cos x+1) = 0$"},{"h":"Solve","d":"$\\cos x = \\tfrac12 \\Rightarrow x = \\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$; $\\cos x = -1 \\Rightarrow x = \\pi$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"Missed the solution from cos x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2+cos(x)-1 = 0"},{"marks":1,"point":"Correct factorisation","line":"(2*cos(x)-1)*(cos(x)+1) = 0"},{"marks":1,"point":"All three solutions","answer":true}]},{"id":"A11-T2-006","group":"A11-T2-006","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Tangent squared","prompt":"Solve $\\tan^{2}\\theta=3$ for $0^\\circ\\le\\theta\\le360^\\circ$.","answerType":"set","answer":{"values":[60,120,240,300]},"answerPrefix":"θ =","hints":["$\\tan60^\\circ = \\sqrt3$.","Tangent has period 180°."],"ladder":{"nudge":"$\\tan60^\\circ = \\sqrt3$.","method":"Tangent has period 180°."},"steps":[{"h":"Square root","d":"$\\tan\\theta = \\pm\\sqrt3$"},{"h":"All quadrants","d":"$\\theta = 60^\\circ, 120^\\circ, 240^\\circ, 300^\\circ$"}],"traps":[{"values":[60,240],"why":"Took only tan θ = +√3."}],"criteria":[{"marks":1,"point":"tan θ = ±√3","line":"tan(θ) = sqrt(3)"},{"marks":1,"point":"All four solutions","answer":true}]},{"id":"A11-T2-007","group":"A11-T2-007","dp":"T2.1d","authored":3,"level":3,"marks":3,"title":"Equation in 2x","prompt":"Solve $\\sin2x=\\dfrac{\\sqrt3}{2}$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,1.0471975511965979,3.6651914291880923,4.188790204786391]},"answerPrefix":"x =","hints":["Let $u = 2x$ and find its range.","Solve $\\sin u = \\tfrac{\\sqrt3}{2}$ over two cycles.","Divide by 2 at the end."],"ladder":{"nudge":"Let $u = 2x$ and find its range.","method":"Solve $\\sin u = \\tfrac{\\sqrt3}{2}$ over two cycles.","worked":"Divide by 2 at the end."},"steps":[{"h":"Extend the range","d":"For $0 \\le x \\le 2\\pi$, $0 \\le 2x \\le 4\\pi$."},{"h":"Solve for 2x","d":"$2x = \\tfrac{\\pi}{3},\\tfrac{2\\pi}{3},\\tfrac{7\\pi}{3},\\tfrac{8\\pi}{3}$"},{"h":"Halve","d":"$x = \\tfrac{\\pi}{6},\\tfrac{\\pi}{3},\\tfrac{7\\pi}{6},\\tfrac{4\\pi}{3}$"}],"traps":[{"values":["pi/6","pi/3"],"why":"Did not extend the range to 4π for 2x."}],"criteria":[{"marks":1,"point":"Uses the range 0 ≤ 2x ≤ 4π","manual":true},{"marks":1,"point":"All four values of 2x","line":"2*x = pi/3"},{"marks":1,"point":"All four solutions","answer":true}]},{"id":"A11-T2-009","group":"A11-T2-009","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Third quadrant ratios","prompt":"Given $\\cos\\theta=-\\tfrac23$ and $\\pi<\\theta<\\tfrac{3\\pi}{2}$, find the exact value of $\\tan\\theta+\\sec\\theta$.","answerType":"numeric","answer":{"value":-0.38196601125010515},"hints":["Find $\\sin\\theta$ with the correct sign.","Tangent is positive in quadrant III.","$\\sec\\theta = \\dfrac1{\\cos\\theta}$."],"ladder":{"nudge":"Find $\\sin\\theta$ with the correct sign.","method":"Tangent is positive in quadrant III.","worked":"$\\sec\\theta = \\dfrac1{\\cos\\theta}$."},"steps":[{"h":"Sine","d":"Quadrant III: $\\sin\\theta = -\\sqrt{1-\\tfrac49} = -\\tfrac{\\sqrt5}{3}$"},{"h":"Ratios","d":"$\\tan\\theta = \\dfrac{\\sin\\theta}{\\cos\\theta} = \\tfrac{\\sqrt5}{2}$, $\\sec\\theta = -\\tfrac32$"},{"h":"Add","d":"$\\dfrac{\\sqrt5}{2}-\\dfrac32 = \\dfrac{\\sqrt5-3}{2}$"}],"traps":[{"value":-2.618033988749895,"why":"Tangent is positive in the third quadrant.","expr":"(-sqrt(5)-3)/2"}],"criteria":[{"marks":1,"point":"tan θ = √5/2 and sec θ = −3/2","line":"tan(θ) = sqrt(5)/2"},{"marks":1,"point":"Correct value","answer":true}]},{"id":"A11-T2-012","group":"A11-T2-012","dp":"T2.1d","authored":3,"level":3,"marks":2,"title":"Shifted cosine equation","prompt":"Solve $2\\cos\\!\\left(x-\\tfrac{\\pi}{6}\\right)=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,5.759586531581288]},"answerPrefix":"x =","hints":["Let $u = x-\\tfrac{\\pi}{6}$ and find its range.","Solve $\\cos u = \\tfrac12$.","Convert back to x."],"ladder":{"nudge":"Let $u = x-\\tfrac{\\pi}{6}$ and find its range.","method":"Solve $\\cos u = \\tfrac12$.","worked":"Convert back to x."},"steps":[{"h":"Isolate","d":"$\\cos\\left(x-\\tfrac{\\pi}{6}\\right) = \\tfrac12$, with $-\\tfrac{\\pi}{6} \\le x-\\tfrac{\\pi}{6} \\le \\tfrac{11\\pi}{6}$"},{"h":"Solve","d":"$x-\\tfrac{\\pi}{6} = \\tfrac{\\pi}{3}$ or $\\tfrac{5\\pi}{3}$, so $x = \\tfrac{\\pi}{2}$ or $\\tfrac{11\\pi}{6}$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"Forgot to add π/6 back."}],"criteria":[{"marks":1,"point":"Adjusts the range for x − π/6","line":"x-pi/6 = pi/3"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A11-T2-014","group":"A11-T2-014","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Related angles","prompt":"Simplify $\\sin(180^\\circ-\\theta)\\cos(90^\\circ-\\theta)+\\cos(180^\\circ+\\theta)\\cos(180^\\circ-\\theta)$.","answerType":"numeric","answer":{"value":1},"hints":["Use the quadrant of each related angle.","$\\cos(90^\\circ-\\theta) = \\sin\\theta$.","Finish with the Pythagorean identity."],"ladder":{"nudge":"Use the quadrant of each related angle.","method":"$\\cos(90^\\circ-\\theta) = \\sin\\theta$.","worked":"Finish with the Pythagorean identity."},"steps":[{"h":"Related angles","d":"$\\sin(180^\\circ-\\theta) = \\sin\\theta$, $\\cos(90^\\circ-\\theta) = \\sin\\theta$, $\\cos(180^\\circ+\\theta) = -\\cos\\theta$, $\\cos(180^\\circ-\\theta) = -\\cos\\theta$"},{"h":"Combine","d":"$\\sin^{2}\\theta+\\cos^{2}\\theta = 1$"}],"traps":[{"value":0,"why":"Sign slip: the product of two negative cosines is positive."}],"criteria":[{"marks":1,"point":"All four related-angle results","line":"sin(θ)^2+cos(θ)^2"},{"marks":1,"point":"Simplifies to 1","answer":true}]},{"id":"A11-T2-016","group":"A11-T2-016","dp":"T2.1a","authored":1,"level":1,"marks":2,"title":"Exact values that cancel","prompt":"Find the exact value of $\\sin\\dfrac{5\\pi}{6}+\\cos\\dfrac{4\\pi}{3}$.","answerType":"numeric","answer":{"value":0},"hints":["Find each related angle.","Use ASTC for the sign."],"ladder":{"nudge":"Find each related angle.","method":"Use ASTC for the sign."},"steps":[{"h":"Related angles","d":"$\\sin\\tfrac{5\\pi}{6}=\\tfrac12$, $\\cos\\tfrac{4\\pi}{3}=-\\tfrac12$"}],"traps":[{"value":1,"why":"cos(4π/3) is negative (third quadrant)."}],"criteria":[{"marks":1,"point":"Both exact values","line":"1/2-1/2"},{"marks":1,"point":"0","answer":true}]},{"id":"A11-T2-018","group":"A11-T2-018","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Negative sine equation","prompt":"Solve $2\\sin x=-\\sqrt3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[4.188790204786391,5.235987755982989]},"answerPrefix":"x =","hints":["Divide by 2."],"ladder":{"nudge":"Divide by 2."},"steps":[{"h":"Related angle","d":"$\\sin x=-\\tfrac{\\sqrt3}{2}$, related angle $\\tfrac{\\pi}{3}$"},{"h":"Quadrants 3 and 4","d":"$\\pi+\\tfrac{\\pi}{3}$, $2\\pi-\\tfrac{\\pi}{3}$"}],"traps":[{"values":["pi/3","2*pi/3"],"why":"Those have sin x positive."}],"criteria":[{"marks":1,"point":"Related angle π/3","line":"sin(x) = -sqrt(3)/2"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A11-T2-020","group":"A11-T2-020","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Tangent squared equals three","prompt":"Solve $\\tan^{2}x=3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,2.0943951023931957,4.188790204786391,5.235987755982989]},"answerPrefix":"x =","hints":["Take both square roots.","tan(π/3) = √3.","One solution in each quadrant."],"ladder":{"nudge":"Take both square roots.","method":"tan(π/3) = √3.","worked":"One solution in each quadrant."},"steps":[{"h":"Roots","d":"$\\tan x=\\pm\\sqrt3$"},{"h":"Solve","d":"Related angle $\\tfrac{\\pi}{3}$ in all four quadrants"}],"traps":[{"values":["pi/3","4*pi/3"],"why":"Missed tan x = −√3."}],"criteria":[{"marks":1,"point":"tan x = ±√3","line":"tan(x) = sqrt(3)"},{"marks":1,"point":"All four","answer":true}]},{"id":"A11-T2-023","group":"A11-T2-023","dp":"T2.1d","authored":3,"level":3,"marks":3,"title":"Quadratic in cosine with endpoints","prompt":"Solve $2\\cos^{2}x-\\cos x-1=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,2.0943951023931957,4.188790204786391,6.283185307179586]},"answerPrefix":"x =","hints":["Treat it as a quadratic in cos x.","Include both endpoints."],"ladder":{"nudge":"Treat it as a quadratic in cos x.","method":"Include both endpoints."},"steps":[{"h":"Factorise","d":"$(2\\cos x+1)(\\cos x-1)=0$"},{"h":"Solve","d":"$\\cos x=1$: $0,2\\pi$; $\\cos x=-\\tfrac12$: $\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3}$"}],"traps":[{"values":["2*pi/3","4*pi/3"],"why":"Missed cos x = 1 at both endpoints."}],"criteria":[{"marks":1,"point":"Factorises","line":"(2*cos(x)+1)*(cos(x)-1) = 0"},{"marks":1,"point":"cos x = 1 solutions","manual":true},{"marks":1,"point":"All four","answer":true}]},{"id":"A11-T2-024","group":"A11-T2-024","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Related angles that cancel","prompt":"Simplify $\\sin(180^\\circ-\\theta)+\\cos(90^\\circ+\\theta)$.","answerType":"numeric","answer":{"value":0},"hints":["Use related angles.","90° + θ is in quadrant 2 for acute θ.","Cosine is negative there."],"ladder":{"nudge":"Use related angles.","method":"90° + θ is in quadrant 2 for acute θ.","worked":"Cosine is negative there."},"steps":[{"h":"Each term","d":"$\\sin(180^\\circ-\\theta)=\\sin\\theta$, $\\cos(90^\\circ+\\theta)=-\\sin\\theta$"},{"h":"Sum","d":"$0$"}],"traps":[{"value":2,"why":"cos(90° + θ) = −sin θ, not sin θ."}],"criteria":[{"marks":1,"point":"Both simplified","line":"sin(θ)-sin(θ)"},{"marks":1,"point":"0","answer":true}]},{"id":"A11-T2-029","group":"A11-T2-029","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Sine squared equals a quarter","prompt":"Solve $\\sin^{2}x=\\tfrac14$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,3.6651914291880923,5.759586531581288]},"answerPrefix":"x =","hints":["Take both square roots.","One answer per quadrant."],"ladder":{"nudge":"Take both square roots.","method":"One answer per quadrant."},"steps":[{"h":"Roots","d":"$\\sin x=\\pm\\tfrac12$"},{"h":"Solve","d":"Related angle $\\tfrac{\\pi}{6}$ in all four quadrants"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed the negative root."}],"criteria":[{"marks":1,"point":"sin x = ±½","line":"sin(x) = 1/2"},{"marks":1,"point":"All four","answer":true}]},{"id":"A11-T2-030","group":"A11-T2-030","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Tangent in the third quadrant","prompt":"Find the exact value of $\\tan\\dfrac{7\\pi}{6}$.","answerType":"numeric","answer":{"value":0.5773502691896257},"hints":["7π/6 = π + π/6."],"ladder":{"nudge":"7π/6 = π + π/6."},"steps":[{"h":"Related angle","d":"$\\tfrac{\\pi}{6}$ in quadrant 3, where tan is positive"}],"traps":[{"value":-0.5773502691896257,"why":"Tangent is positive in quadrant 3.","expr":"-sqrt(3)/3"}],"criteria":[{"marks":1,"point":"1/√3","answer":true}]},{"id":"A11-T2-035","group":"A11-T2-035","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Tangent equation over a symmetric domain","prompt":"Solve $\\tan x=-1$ for $-\\pi\\le x\\le\\pi$.","answerType":"set","answer":{"values":[-0.7853981633974483,2.356194490192345]},"answerPrefix":"x =","hints":["tan(π/4) = 1.","Negative in quadrants 2 and 4.","Stay inside [−π, π]."],"ladder":{"nudge":"tan(π/4) = 1.","method":"Negative in quadrants 2 and 4.","worked":"Stay inside [−π, π]."},"steps":[{"h":"Principal","d":"$-\\tfrac{\\pi}{4}$"},{"h":"Period","d":"Add $\\pi$: $\\tfrac{3\\pi}{4}$"}],"traps":[{"values":["3*pi/4","7*pi/4"],"why":"7π/4 lies outside [−π, π]."}],"criteria":[{"marks":1,"point":"One solution","line":"x = -pi/4"},{"marks":1,"point":"Both","answer":true}]},{"id":"A11-T2-036","group":"A11-T2-036","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Cosine in the fourth quadrant","prompt":"Find the exact value of $\\cos\\dfrac{5\\pi}{3}$.","answerType":"numeric","answer":{"value":0.5},"hints":["5π/3 = 2π − π/3."],"ladder":{"nudge":"5π/3 = 2π − π/3."},"steps":[{"h":"Related angle","d":"$\\tfrac{\\pi}{3}$ in quadrant 4, cosine positive"}],"traps":[{"value":-0.5,"why":"Cosine is positive in quadrant 4.","expr":"-1/2"}],"criteria":[{"marks":1,"point":"½","answer":true}]},{"id":"A11-T2-037","group":"A11-T2-037","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Sine of 240 degrees","prompt":"Find the exact value of $\\sin240^\\circ$.","answerType":"numeric","answer":{"value":-0.8660254037844386},"hints":["240 = 180 + 60.","sin 60° = √3/2."],"ladder":{"nudge":"240 = 180 + 60.","method":"sin 60° = √3/2."},"steps":[{"h":"Related angle","d":"$60^\\circ$ in quadrant 3, sine negative"}],"traps":[{"value":0.8660254037844386,"why":"Sine is negative in quadrant 3.","expr":"sqrt(3)/2"}],"criteria":[{"marks":1,"point":"−√3/2","answer":true}]},{"id":"A11-T2-038","group":"A11-T2-038","dp":"T2.1d","authored":1,"level":1,"marks":2,"title":"Negative cosine equation","prompt":"Solve $\\cos x=-\\dfrac{\\sqrt3}{2}$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.6179938779914944,3.6651914291880923]},"answerPrefix":"x =","hints":["Write both."],"ladder":{"nudge":"Write both."},"steps":[{"h":"Quadrants 2 and 3","d":"$\\pi\\mp\\tfrac{\\pi}{6}$"}],"traps":[{"values":["pi/6","11*pi/6"],"why":"Those have cos x positive."}],"criteria":[{"marks":1,"point":"Related angle π/6","manual":true},{"marks":1,"point":"Both","answer":true}]},{"id":"A11-T2-040","group":"A11-T2-040","dp":"T2.1d","authored":2,"level":2,"marks":3,"title":"Factorising a sine equation","prompt":"Solve $2\\sin^{2}x-\\sin x=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,0.5235987755982989,2.6179938779914944,3.141592653589793,6.283185307179586]},"answerPrefix":"x =","hints":["Factor out sin x.","Do not divide.","Include endpoints."],"ladder":{"nudge":"Factor out sin x.","method":"Do not divide.","worked":"Include endpoints."},"steps":[{"h":"Factor","d":"$\\sin x(2\\sin x-1)=0$"},{"h":"Solve","d":"$\\sin x=0$: $0,\\pi,2\\pi$; $\\sin x=\\tfrac12$: $\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$"}],"traps":[{"values":["