sitive in quadrants 1 and 2.","worked":"Write both."},"steps":[{"h":"Complement","d":"$\\cos40^\\circ=\\sin50^\\circ$"},{"h":"Solve","d":"$50^\\circ$ and $180^\\circ-50^\\circ$"}],"traps":[{"values":[40,140],"why":"sin 40° ≠ cos 40°."}],"criteria":[{"marks":1,"point":"cos 40° = sin 50°","manual":true},{"marks":1,"point":"Both angles","answer":true}]},{"id":"A11-T2-047","group":"A11-T2-047","dp":"T2.1d","authored":3,"level":3,"marks":3,"title":"Cosine equals sine squared form","prompt":"Solve $2\\sin^{2}x=1+\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793,5.235987755982989]},"answerPrefix":"x =","hints":["sin² = 1 − cos².","Rearrange to a quadratic."],"ladder":{"nudge":"sin² = 1 − cos².","method":"Rearrange to a quadratic."},"steps":[{"h":"Pythagoras","d":"$2-2\\cos^{2}x=1+\\cos x$"},{"h":"Factor","d":"$(2\\cos x-1)(\\cos x+1)=0$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"cos x = −1 gives π."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2+cos(x)-1 = 0"},{"marks":1,"point":"cos x = ½ or −1","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"A11-T2-048","group":"A11-T2-048","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Sine from a cosine in the second quadrant","prompt":"Given $\\cos\\theta=-\\tfrac{3}{5}$ and $\\theta$ is obtuse, find $\\tan\\theta$.","answerType":"numeric","answer":{"value":-1.3333333333333333},"hints":["Draw the 3-4-5 triangle.","sin is positive.","tan is negative."],"ladder":{"nudge":"Draw the 3-4-5 triangle.","method":"sin is positive.","worked":"tan is negative."},"steps":[{"h":"Triangle","d":"$\\sin\\theta=\\tfrac45$"}],"traps":[{"value":1.3333333333333333,"why":"tan is negative in the second quadrant.","expr":"4/3"}],"criteria":[{"marks":1,"point":"−4/3","answer":true}]},{"id":"A11-T2-049","group":"A11-T2-049","dp":"T2.1d","authored":2,"level":2,"marks":2,"title":"Counting tangent solutions","prompt":"Solve $\\tan2x=1$ for 