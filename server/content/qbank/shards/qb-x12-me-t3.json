{"family":"qb-x12-me-t3","course":"EXT1","year":12,"topic":"ME-T3","questions":[{"id":"X12-T3-008","group":"X12-T3-008","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in sine","prompt":"Solve $2\\cos^{2}x+3\\sin x=3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,1.5707963267948966,2.6179938779914944]},"answerPrefix":"x =","hints":["cos² = 1 − sin²."],"ladder":{"nudge":"cos² = 1 − sin²."},"steps":[{"h":"Quadratic","d":"$2\\sin^{2}x-3\\sin x+1=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x-1)=0$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed sin x = 1."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2-3*sin(x)+1 = 0"},{"marks":1,"point":"Factorises","line":"(2*sin(x)-1)*(sin(x)-1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-010","group":"X12-T3-010","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Difference with root three","prompt":"Solve $\\sin x-\\sqrt3\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,3.6651914291880923]},"answerPrefix":"x =","hints":["R = 2."],"ladder":{"nudge":"R = 2."},"steps":[{"h":"Auxiliary","d":"$2\\sin(x-\\tfrac{\\pi}{3})=1$"},{"h":"Solve","d":"$x-\\tfrac{\\pi}{3}=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Forgot to add π/3."}],"criteria":[{"marks":1,"point":"2 sin(x − π/3)","line":"2*sin(x-pi/3)"},{"marks":1,"point":"Shifted equation","line":"sin(x-pi/3) = 1/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-016(ii)","group":"X12-T3-016","label":"(ii)","dp":"T3.1b","authored":2,"level":2,"marks":2,"title":"Auxiliary angle with a cosine form","prompt":"Hence solve $\\sqrt3\\cos x-\\sin x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,4.71238898038469]},"answerPrefix":"x =","hints":["Divide by 2.","Subtract π/6."],"ladder":{"nudge":"Divide by 2.","method":"Subtract π/6."},"steps":[{"h":"Equation","d":"$\\cos\\left(x+\\tfrac{\\pi}{6}\\right)=\\tfrac12$, with $x+\\tfrac{\\pi}{6}\\in\\left[\\tfrac{\\pi}{6},\\tfrac{13\\pi}{6}\\right]$"},{"h":"Solve","d":"$x+\\tfrac{\\pi}{6}=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$"}],"traps":[{"values":["pi/6"],"why":"Missed 5π/3 for the shifted angle."}],"criteria":[{"marks":1,"point":"Shifted angles","line":"x+pi/6 = pi/3"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-020","group":"X12-T3-020","dp":"T3.1c","authored":3,"level":3,"marks":3,"title":"Equation equal to root two","prompt":"Solve $\\sin x+\\sqrt3\\cos x=\\sqrt2$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.3089969389957472,6.021385919380437]},"answerPrefix":"x =","hints":["R = 2 and α = π/3.","Include 9π/4."],"ladder":{"nudge":"R = 2 and α = π/3.","method":"Include 9π/4."},"steps":[{"h":"Auxiliary","d":"$2\\sin\\left(x+\\tfrac{\\pi}{3}\\right)=\\sqrt2$"},{"h":"Shifted range","d":"$x+\\tfrac{\\pi}{3}\\in\\left[\\tfrac{\\pi}{3},\\tfrac{7\\pi}{3}\\right]$: $\\tfrac{3\\pi}{4},\\tfrac{9\\pi}{4}$"},{"h":"Solve","d":"$\\tfrac{5\\pi}{12},\\tfrac{23\\pi}{12}$"}],"traps":[{"values":["5*pi/12"],"why":"π/4 is outside the shifted range, but 9π/4 is inside."}],"criteria":[{"marks":1,"point":"2 sin(x + π/3)","line":"2*sin(x+pi/3)"},{"marks":1,"point":"Shifted angles","line":"x+pi/3 = 3*pi/4"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-023","group":"X12-T3-023","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in cosine from sine squared","prompt":"Solve $2\\sin^{2}x=1+\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793,5.235987755982989]},"answerPrefix":"x =","hints":["sin² = 1 − cos²."],"ladder":{"nudge":"sin² = 1 − cos²."},"steps":[{"h":"Substitute","d":"$2-2\\cos^{2}x=1+\\cos x\\Rightarrow2\\cos^{2}x+\\cos x-1=0$"},{"h":"Factor","d":"$(2\\cos x-1)(\\cos x+1)=0$"},{"h":"Solve","d":"$\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3},\\pi$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"Missed cos x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2+cos(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*cos(x)-1)*(cos(x)+1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-024","group":"X12-T3-024","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"Reciprocal of an auxiliary expression","prompt":"Find the least value of $\\dfrac{1}{6\\sin x+8\\cos x+15}$.","answerType":"numeric","answer":{"value":0.04},"hints":["R = √(36 + 64).","Denominator lies in [5, 25].","Least reciprocal from the largest denominator."],"ladder":{"nudge":"R = √(36 + 64).","method":"Denominator lies in [5, 25].","worked":"Least reciprocal from the largest denominator."},"steps":[{"h":"Range","d":"$6\\sin x+8\\cos x\\in[-10,10]$"},{"h":"Least","d":"Largest denominator $25$: $\\tfrac1{25}$"}],"traps":[{"value":0.2,"why":"That is the greatest value.","expr":"1/5"}],"criteria":[{"marks":1,"point":"R = 10","manual":true},{"marks":1,"point":"1/25","answer":true}]},{"id":"X12-T3-027","group":"X12-T3-027","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Double angle against single angle","prompt":"Solve $\\cos2x=\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,2.0943951023931957,4.188790204786391,6.283185307179586]},"answerPrefix":"x =","hints":["cos 2x = 2cos²x − 1."],"ladder":{"nudge":"cos 2x = 2cos²x − 1."},"steps":[{"h":"Quadratic","d":"$2\\cos^{2}x-\\cos x-1=0$"},{"h":"Factor","d":"$(2\\cos x+1)(\\cos x-1)=0$"},{"h":"Solve","d":"$0,2\\pi$ and $\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3}$"}],"traps":[{"values":["2*pi/3","4*pi/3"],"why":"Missed cos x = 1 at both ends."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2-cos(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*cos(x)+1)*(cos(x)-1) = 0"},{"marks":1,"point":"All four","answer":true}]},{"id":"X12-T3-029","group":"X12-T3-029","dp":"T3.1c","authored":3,"level":3,"marks":3,"title":"Root three sine minus cosine","prompt":"Solve $\\sqrt3\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793]},"answerPrefix":"x =","hints":["R = 2, α = π/6.","Add π/6."],"ladder":{"nudge":"R = 2, α = π/6.","method":"Add π/6."},"steps":[{"h":"Auxiliary","d":"$2\\sin\\left(x-\\tfrac{\\pi}{6}\\right)=1$"},{"h":"Shifted angles","d":"$x-\\tfrac{\\pi}{6}=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$"},{"h":"Solve","d":"$\\tfrac{\\pi}{3},\\pi$"}],"traps":[{"values":["pi/3"],"why":"Missed 5π/6 for the shifted angle."}],"criteria":[{"marks":1,"point":"2 sin(x − π/6)","line":"2*sin(x-pi/6)"},{"marks":1,"point":"Shifted angles","line":"x-pi/6 = pi/6"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-032","group":"X12-T3-032","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Counting solutions of an auxiliary equation","prompt":"How many solutions does $3\\sin x+4\\cos x=4.5$ have for $0\\le x<2\\pi$? Explain.","answerType":"numeric","answer":{"value":2},"hints":["Compare 4.5 with R."],"ladder":{"nudge":"Compare 4.5 with R."},"steps":[{"h":"Amplitude","d":"$R=5>4.5$"},{"h":"Count","d":"One cycle crosses a level below its maximum twice"}],"traps":[{"value":0,"why":"4.5 is less than 5, so it is reached."}],"criteria":[{"marks":1,"point":"Compares with R = 5","manual":true},{"marks":1,"point":"2","answer":true}]},{"id":"X12-T3-035","group":"X12-T3-035","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in sine from cosine squared","prompt":"Solve $2\\cos^{2}x=\\sin x+1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,4.71238898038469]},"answerPrefix":"x =","hints":["cos² = 1 − sin²."],"ladder":{"nudge":"cos² = 1 − sin²."},"steps":[{"h":"Substitute","d":"$2\\sin^{2}x+\\sin x-1=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x+1)=0$"},{"h":"Solve","d":"$\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6},\\tfrac{3\\pi}{2}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed sin x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2+sin(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*sin(x)-1)*(sin(x)+1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-036","group":"X12-T3-036","dp":"T3.1b","authored":3,"level":3,"marks":3,"title":"Sine minus cosine equals one","prompt":"Solve $\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$ using the auxiliary angle method.","answerType":"set","answer":{"values":[1.5707963267948966,3.141592653589793]},"answerPrefix":"x =","hints":["R = √2, α = π/4.","sin = 1/√2.","Add π/4."],"ladder":{"nudge":"R = √2, α = π/4.","method":"sin = 1/√2.","worked":"Add π/4."},"steps":[{"h":"Form","d":"$\\sqrt2\\sin\\left(x-\\tfrac{\\pi}{4}\\right)=1$"},{"h":"Shifted","d":"$x-\\tfrac{\\pi}{4}=\\tfrac{\\pi}{4},\\tfrac{3\\pi}{4}$"},{"h":"Solve","d":"$\\tfrac{\\pi}{2},\\pi$"}],"traps":[{"values":["pi/2"],"why":"Missed 3π/4 for the shifted angle."}],"criteria":[{"marks":1,"point":"√2 sin(x − π/4)","line":"sqrt(2)*sin(x-pi/4)"},{"marks":1,"point":"Shifted angles","line":"x-pi/4 = pi/4"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-037","group":"X12-T3-037","dp":"T3.1a","authored":3,"level":3,"marks":2,"title":"Greatest value of a reciprocal","prompt":"Find the greatest value of $\\dfrac{1}{6+3\\cos x+4\\sin x}$.","answerType":"numeric","answer":{"value":1},"hints":["Smallest denominator gives the largest value."],"ladder":{"nudge":"Smallest denominator gives the largest value."},"steps":[{"h":"Range","d":"$3\\cos x+4\\sin x\\in[-5,5]$"},{"h":"Least denominator","d":"$6-5=1$"}],"traps":[{"value":0.09090909090909091,"why":"That is the least value.","expr":"1/11"}],"criteria":[{"marks":1,"point":"R = 5","manual":true},{"marks":1,"point":"1","answer":true}]},{"id":"X12-T3-044","group":"X12-T3-044","dp":"T3.1c","authored":1,"level":1,"marks":2,"title":"Sine squared equals three quarters","prompt":"Solve $4\\sin^{2}x=3$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,2.0943951023931957]},"answerPrefix":"x =","hints":["Sine is non-negative on [0, π]."],"ladder":{"nudge":"Sine is non-negative on [0, π]."},"steps":[{"h":"Root","d":"$\\sin x=\\tfrac{\\sqrt3}{2}$ (non-negative on $[0,\\pi]$)"}],"traps":[{"values":["pi/3"],"why":"Sine is positive in quadrant 2 too."}],"criteria":[{"marks":1,"point":"sin x = √3/2","line":"sin(x) = sqrt(3)/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-045","group":"X12-T3-045","dp":"T3.1b","authored":1,"level":1,"marks":1,"title":"Amplitude of eight sine plus six cosine","prompt":"Find the maximum value of $8\\sin x+6\\cos x$.","answerType":"numeric","answer":{"value":10},"hints":["R = √(a² + b²).","The maximum is R."],"ladder":{"nudge":"R = √(a² + b²).","method":"The maximum is R."},"steps":[{"h":"R","d":"$\\sqrt{64+36}$"}],"traps":[{"value":14,"why":"Added the coefficients."}],"criteria":[{"marks":1,"point":"10","answer":true}]},{"id":"X12-T3-046","group":"X12-T3-046","dp":"T3.1c","authored":1,"level":1,"marks":2,"title":"Sine plus cosine equals zero","prompt":"Solve $\\sin x+\\cos x=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.356194490192345,5.497787143782138]},"answerPrefix":"x =","hints":["Divide by cos x.","Quadrants 2 and 4."],"ladder":{"nudge":"Divide by cos x.","method":"Quadrants 2 and 4."},"steps":[{"h":"Tangent","d":"$\\tan x=-1$"}],"traps":[{"values":["pi/4","5*pi/4"],"why":"tan x = +1 there."}],"criteria":[{"marks":1,"point":"tan x = −1","line":"tan(x) = -1"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-050","group":"X12-T3-050","dp":"T3.1b","authored":2,"level":2,"marks":2,"title":"Auxiliary angle as a cosine with a minus","prompt":"Express $\\cos x-\\sqrt3\\sin x$ in the form $R\\cos(x+\\alpha)$ with $0<\\alpha<\\tfrac{\\pi}{2}$.","answerType":"expression","answer":{"expr":"2*cos(x+pi/3)"},"hints":["Expand R cos(x + α).","tan α = √3."],"ladder":{"nudge":"Expand R cos(x + α).","method":"tan α = √3."},"steps":[{"h":"R","d":"$\\sqrt{1+3}=2$"},{"h":"Angle","d":"$\\tan\\alpha=\\sqrt3$"}],"traps":[{"expr":"2*cos(x-pi/3)","why":"The minus sign gives x + α."}],"criteria":[{"marks":1,"point":"R = 2","manual":true},{"marks":1,"point":"Correct form","answer":true}]},{"id":"X12-T3-053","group":"X12-T3-053","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"Solving with an auxiliary sine form","prompt":"Solve $\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,3.141592653589793]},"answerPrefix":"x =","hints":["R = √2, α = π/4.","sin(θ) = 1/√2."],"ladder":{"nudge":"R = √2, α = π/4.","method":"sin(θ) = 1/√2."},"steps":[{"h":"Rewrite","d":"$\\sqrt2\\sin\\left(x-\\tfrac{\\pi}{4}\\right)=1$"},{"h":"Solve","d":"$x-\\tfrac{\\pi}{4}=\\tfrac{\\pi}{4},\\tfrac{3\\pi}{4}$"}],"traps":[{"values":["pi/2"],"why":"The second angle gives π."}],"criteria":[{"marks":1,"point":"Auxiliary form","line":"sqrt(2)*sin(x-pi/4) = 1"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-058","group":"X12-T3-058","dp":"T3.1c","authored":3,"level":3,"marks":2,"title":"Triple angle cosine equation","prompt":"Using $\\cos3\\theta=4\\cos^{3}\\theta-3\\cos\\theta$, solve $4\\cos^{3}\\theta-3\\cos\\theta=\\tfrac12$ for $0\\le\\theta\\le\\pi$.","answerType":"set","answer":{"values":[0.3490658503988659,1.7453292519943295,2.443460952792061]},"answerPrefix":"θ =","hints":["Recognise cos 3θ.","3θ in [0, 3π].","Divide by 3."],"ladder":{"nudge":"Recognise cos 3θ.","method":"3θ in [0, 3π].","worked":"Divide by 3."},"steps":[{"h":"Rewrite","d":"$\\cos3\\theta=\\tfrac12$"},{"h":"Solve","d":"$3\\theta=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3},\\tfrac{7\\pi}{3}$"}],"traps":[{"values":["pi/9"],"why":"3θ ranges over [0, 3π]."}],"criteria":[{"marks":1,"point":"cos 3θ = ½","line":"cos(3*theta) = 1/2"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-063","group":"X12-T3-063","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Cosine equation from an identity","prompt":"Solve $\\cos2x+3\\cos x+2=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.0943951023931957,3.141592653589793,4.188790204786391]},"answerPrefix":"x =","hints":["cos 2x = 2cos²x − 1."],"ladder":{"nudge":"cos 2x = 2cos²x − 1."},"steps":[{"h":"Identity","d":"$2\\cos^{2}x+3\\cos x+1=0$"},{"h":"Factor","d":"$(2\\cos x+1)(\\cos x+1)=0$"}],"traps":[{"values":["2*pi/3","4*pi/3"],"why":"cos x = −1 gives π."}],"criteria":[{"marks":1,"point":"Quadratic","line":"2*cos(x)^2+3*cos(x)+1 = 0"},{"marks":1,"point":"cos x = −½, −1","manual":true},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-072","group":"X12-T3-072","dp":"T3.1c","authored":3,"level":3,"marks":2,"title":"Sum of solutions of a trig equation","prompt":"Find the sum of all solutions of $\\cos2x=\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":12.566370614359172},"hints":["cos 2x = 2cos²x − 1."],"ladder":{"nudge":"cos 2x = 2cos²x − 1."},"steps":[{"h":"Quadratic","d":"$(2\\cos x+1)(\\cos x-1)=0$"},{"h":"Solutions","d":"$0,\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3},2\\pi$"}],"traps":[{"value":6.283185307179586,"why":"Include 0 and 2π.","expr":"2*pi"}],"criteria":[{"marks":1,"point":"All solutions","manual":true},{"marks":1,"point":"4π","answer":true}]},{"id":"X12-T3-077","group":"X12-T3-077","dp":"T3.1c","authored":4,"level":4,"marks":3,"title":"Equation with a triple angle identity","prompt":"Solve $\\sin3x=\\sin x$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[0,0.7853981633974483,2.356194490192345,3.141592653589793]},"answerPrefix":"x =","hints":["sin 3x = 3 sin x − 4 sin³x."],"ladder":{"nudge":"sin 3x = 3 sin x − 4 sin³x."},"steps":[{"h":"Identity","d":"$3\\sin x-4\\sin^{3}x=\\sin x$"},{"h":"Factor","d":"$2\\sin x(1-2\\sin^{2}x)=0$"}],"traps":[{"values":["pi/4","3*pi/4"],"why":"sin x = 0 gives 0 and π."}],"criteria":[{"marks":1,"point":"Uses identity","manual":true},{"marks":1,"point":"Factorises","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X12-T3-078","group":"X12-T3-078","dp":"T3.1c","authored":5,"level":4,"marks":3,"title":"Equation in tan with a double angle","prompt":"Solve $\\tan2x=3\\tan x$ for $0\\le x<\\pi$.","answerType":"set","answer":{"values":[0,0.5235987755982989,2.6179938779914944]},"answerPrefix":"x =","hints":["Let t = tan x."],"ladder":{"nudge":"Let t = tan x."},"steps":[{"h":"Formula","d":"$\\dfrac{2t}{1-t^{2}}=3t$"},{"h":"Factor","d":"$t(3t^{2}-1)=0$"},{"h":"Solve","d":"$t=0,\\pm\\tfrac{1}{\\sqrt3}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"t = 0 gives x = 0."}],"criteria":[{"marks":1,"point":"Equation in t","manual":true},{"marks":1,"point":"t values","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X12-T3-079","group":"X12-T3-079","dp":"T3.1c","authored":4,"level":4,"marks":2,"title":"Sum of solutions of a sine equation","prompt":"Find the sum of the solutions of $\\sin2x=\\tfrac12$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":9.42477796076938},"hints":["2x in [0, 4π]."],"ladder":{"nudge":"2x in [0, 4π]."},"steps":[{"h":"Solutions","d":"$\\tfrac{\\pi}{12},\\tfrac{5\\pi}{12},\\tfrac{13\\pi}{12},\\tfrac{17\\pi}{12}$"},{"h":"Sum","d":"$\\tfrac{36\\pi}{12}$"}],"traps":[{"value":1.5707963267948966,"why":"Add all four solutions.","expr":"pi/2"}],"criteria":[{"marks":1,"point":"All four","manual":true},{"marks":1,"point":"Sum","answer":true}]}]}
