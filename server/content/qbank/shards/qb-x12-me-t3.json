{"family":"qb-x12-me-t3","course":"EXT1","year":12,"topic":"ME-T3","questions":[{"id":"X12-T3-008","group":"X12-T3-008","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in sine","prompt":"Solve $2\\cos^{2}x+3\\sin x=3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,1.5707963267948966,2.6179938779914944]},"answerPrefix":"x =","hints":["cos² = 1 − sin².","Rearrange to zero.","Factorise."],"steps":[{"h":"Quadratic","d":"$2\\sin^{2}x-3\\sin x+1=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x-1)=0$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed sin x = 1."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2-3*sin(x)+1 = 0"},{"marks":1,"point":"Factorises","line":"(2*sin(x)-1)*(sin(x)-1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-010","group":"X12-T3-010","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Difference with root three","prompt":"Solve $\\sin x-\\sqrt3\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,3.6651914291880923]},"answerPrefix":"x =","hints":["R = 2.","α = π/3.","Shift back."],"steps":[{"h":"Auxiliary","d":"$2\\sin(x-\\tfrac{\\pi}{3})=1$"},{"h":"Solve","d":"$x-\\tfrac{\\pi}{3}=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Forgot to add π/3."}],"criteria":[{"marks":1,"point":"2 sin(x − π/3)","line":"2*sin(x-pi/3)"},{"marks":1,"point":"Shifted equation","line":"sin(x-pi/3) = 1/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-013","group":"X12-T3-013","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"Trig inequality with an auxiliary angle","prompt":"Solve $\\sqrt3\\sin x+\\cos x>1$ for $0\\le x\\le2\\pi$. The graph of $y=\\sqrt3\\sin x+\\cos x$ is shown.","answerType":"interval","answer":{"region":"0 < x < 2*pi/3","variable":"x"},"hints":["Use part of T3-001.","Solve the equality first.","Read the graph."],"steps":[{"h":"Auxiliary","d":"$2\\sin(x+\\tfrac{\\pi}{6})>1$"},{"h":"Read","d":"$\\tfrac{\\pi}{6}<x+\\tfrac{\\pi}{6}<\\tfrac{5\\pi}{6}$"}],"traps":[{"region":"0 <= x <= 2*pi/3","why":"Strict inequality."}],"criteria":[{"marks":1,"point":"Boundary values 0 and 2π/3","line":"x = 2*pi/3"},{"marks":1,"point":"0 < x < 2π/3","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 3 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed; a region is shaded. Labels shown: (2 pi over 3), 2 pi. Marked on the horizontal axis: (2 pi over 3), 2 pi; vertical axis: 2. Read the question for what it asks.","w":273.89,"h":140.17,"sha256":"b12c10ebb38dfae7528d4c4ac2a32c9671f81b91c4f03de70d9c0e435a0e8a2b","bytes":14949}},{"id":"X12-T3-016(ii)","group":"X12-T3-016","label":"(ii)","dp":"T3.1b","authored":2,"level":2,"marks":2,"title":"Auxiliary angle with a cosine form","prompt":"Hence solve $\\sqrt3\\cos x-\\sin x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,4.71238898038469]},"answerPrefix":"x =","hints":["Divide by 2.","Adjust the domain.","Subtract π/6."],"steps":[{"h":"Equation","d":"$\\cos\\left(x+\\tfrac{\\pi}{6}\\right)=\\tfrac12$, with $x+\\tfrac{\\pi}{6}\\in\\left[\\tfrac{\\pi}{6},\\tfrac{13\\pi}{6}\\right]$"},{"h":"Solve","d":"$x+\\tfrac{\\pi}{6}=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$"}],"traps":[{"values":["pi/6"],"why":"Missed 5π/3 for the shifted angle."}],"criteria":[{"marks":1,"point":"Shifted angles","line":"x+pi/6 = pi/3"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-023","group":"X12-T3-023","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in cosine from sine squared","prompt":"Solve $2\\sin^{2}x=1+\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793,5.235987755982989]},"answerPrefix":"x =","hints":["sin² = 1 − cos².","Rearrange.","Factorise."],"steps":[{"h":"Substitute","d":"$2-2\\cos^{2}x=1+\\cos x\\Rightarrow2\\cos^{2}x+\\cos x-1=0$"},{"h":"Factor","d":"$(2\\cos x-1)(\\cos x+1)=0$"},{"h":"Solve","d":"$\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3},\\pi$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"Missed cos x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2+cos(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*cos(x)-1)*(cos(x)+1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-024","group":"X12-T3-024","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"Reciprocal of an auxiliary expression","prompt":"Find the least value of $\\dfrac{1}{6\\sin x+8\\cos x+15}$.","answerType":"numeric","answer":{"value":0.04},"hints":["R = √(36 + 64).","Denominator lies in [5, 25].","Least reciprocal from the largest denominator."],"steps":[{"h":"Range","d":"$6\\sin x+8\\cos x\\in[-10,10]$"},{"h":"Least","d":"Largest denominator $25$: $\\tfrac1{25}$"}],"traps":[{"value":0.2,"why":"That is the greatest value.","expr":"1/5"}],"criteria":[{"marks":1,"point":"R = 10","manual":true},{"marks":1,"point":"1/25","answer":true}]},{"id":"X12-T3-027","group":"X12-T3-027","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Double angle against single angle","prompt":"Solve $\\cos2x=\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,2.0943951023931957,4.188790204786391,6.283185307179586]},"answerPrefix":"x =","hints":["cos 2x = 2cos²x − 1.","Factorise.","Include both endpoints."],"steps":[{"h":"Quadratic","d":"$2\\cos^{2}x-\\cos x-1=0$"},{"h":"Factor","d":"$(2\\cos x+1)(\\cos x-1)=0$"},{"h":"Solve","d":"$0,2\\pi$ and $\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3}$"}],"traps":[{"values":["2*pi/3","4*pi/3"],"why":"Missed cos x = 1 at both ends."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2-cos(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*cos(x)+1)*(cos(x)-1) = 0"},{"marks":1,"point":"All four","answer":true}]},{"id":"X12-T3-029","group":"X12-T3-029","dp":"T3.1c","authored":3,"level":3,"marks":3,"title":"Root three sine minus cosine","prompt":"Solve $\\sqrt3\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793]},"answerPrefix":"x =","hints":["R = 2, α = π/6.","sin = ½.","Add π/6."],"steps":[{"h":"Auxiliary","d":"$2\\sin\\left(x-\\tfrac{\\pi}{6}\\right)=1$"},{"h":"Shifted angles","d":"$x-\\tfrac{\\pi}{6}=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$"},{"h":"Solve","d":"$\\tfrac{\\pi}{3},\\pi$"}],"traps":[{"values":["pi/3"],"why":"Missed 5π/6 for the shifted angle."}],"criteria":[{"marks":1,"point":"2 sin(x − π/6)","line":"2*sin(x-pi/6)"},{"marks":1,"point":"Shifted angles","line":"x-pi/6 = pi/6"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-031","group":"X12-T3-031","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"First peak of an auxiliary wave","prompt":"The graph of $y=3\\sin x+4\\cos x$ is shown. Find, to two decimal places, the first positive $x$ at which it reaches its maximum.","answerType":"numeric","answer":{"value":0.64,"tol":0.005},"hints":["Write as R sin(x + α).","Max when x + α = π/2.","Subtract α."],"steps":[{"h":"Form","d":"$5\\sin(x+\\alpha)$, $\\alpha=\\tan^{-1}\\tfrac43$"},{"h":"Peak","d":"$x+\\alpha=\\tfrac{\\pi}{2}$"}],"traps":[{"value":0.93,"why":"That is α."}],"criteria":[{"marks":1,"point":"α = tan⁻¹(4/3)","manual":true},{"marks":1,"point":"0.64","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 1 plotted line, curve or set of points is drawn. Labels shown: x sub 0. Marked on the horizontal axis: x sub 0; vertical axis: minus 5, 5. Read the question for what it asks.","w":255.23,"h":132.61,"sha256":"1eca5f6c890f3053d94d9d8bc91f68d4c8713dc7453cac4dc8ef23fe69aa0675","bytes":7884}},{"id":"X12-T3-032","group":"X12-T3-032","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Counting solutions of an auxiliary equation","prompt":"How many solutions does $3\\sin x+4\\cos x=4.5$ have for $0\\le x<2\\pi$? Explain.","answerType":"numeric","answer":{"value":2},"hints":["Find R.","Compare 4.5 with R.","One full period."],"steps":[{"h":"Amplitude","d":"$R=5>4.5$"},{"h":"Count","d":"One cycle crosses a level below its maximum twice"}],"traps":[{"value":0,"why":"4.5 is less than 5, so it is reached."}],"criteria":[{"marks":1,"point":"Compares with R = 5","manual":true},{"marks":1,"point":"2","answer":true}]},{"id":"X12-T3-035","group":"X12-T3-035","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Quadratic in sine from cosine squared","prompt":"Solve $2\\cos^{2}x=\\sin x+1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,4.71238898038469]},"answerPrefix":"x =","hints":["cos² = 1 − sin².","Rearrange to zero.","Factorise."],"steps":[{"h":"Substitute","d":"$2\\sin^{2}x+\\sin x-1=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x+1)=0$"},{"h":"Solve","d":"$\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6},\\tfrac{3\\pi}{2}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed sin x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2+sin(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*sin(x)-1)*(sin(x)+1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-036","group":"X12-T3-036","dp":"T3.1b","authored":3,"level":3,"marks":3,"title":"Sine minus cosine equals one","prompt":"Solve $\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$ using the auxiliary angle method.","answerType":"set","answer":{"values":[1.5707963267948966,3.141592653589793]},"answerPrefix":"x =","hints":["R = √2, α = π/4.","sin = 1/√2.","Add π/4."],"steps":[{"h":"Form","d":"$\\sqrt2\\sin\\left(x-\\tfrac{\\pi}{4}\\right)=1$"},{"h":"Shifted","d":"$x-\\tfrac{\\pi}{4}=\\tfrac{\\pi}{4},\\tfrac{3\\pi}{4}$"},{"h":"Solve","d":"$\\tfrac{\\pi}{2},\\pi$"}],"traps":[{"values":["pi/2"],"why":"Missed 3π/4 for the shifted angle."}],"criteria":[{"marks":1,"point":"√2 sin(x − π/4)","line":"sqrt(2)*sin(x-pi/4)"},{"marks":1,"point":"Shifted angles","line":"x-pi/4 = pi/4"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-037","group":"X12-T3-037","dp":"T3.1a","authored":3,"level":3,"marks":2,"title":"Greatest value of a reciprocal","prompt":"Find the greatest value of $\\dfrac{1}{6+3\\cos x+4\\sin x}$.","answerType":"numeric","answer":{"value":1},"hints":["R = 5.","Smallest denominator gives the largest value.","6 − 5 = 1."],"steps":[{"h":"Range","d":"$3\\cos x+4\\sin x\\in[-5,5]$"},{"h":"Least denominator","d":"$6-5=1$"}],"traps":[{"value":0.09090909090909091,"why":"That is the least value.","expr":"1/11"}],"criteria":[{"marks":1,"point":"R = 5","manual":true},{"marks":1,"point":"1","answer":true}]},{"id":"X12-T3-044","group":"X12-T3-044","dp":"T3.1c","authored":1,"level":1,"marks":2,"title":"Sine squared equals three quarters","prompt":"Solve $4\\sin^{2}x=3$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,2.0943951023931957]},"answerPrefix":"x =","hints":["sin²x = ¾.","Sine is non-negative on [0, π].","Two angles."],"steps":[{"h":"Root","d":"$\\sin x=\\tfrac{\\sqrt3}{2}$ (non-negative on $[0,\\pi]$)"}],"traps":[{"values":["pi/3"],"why":"Sine is positive in quadrant 2 too."}],"criteria":[{"marks":1,"point":"sin x = √3/2","line":"sin(x) = sqrt(3)/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-045","group":"X12-T3-045","dp":"T3.1b","authored":1,"level":1,"marks":1,"title":"Amplitude of eight sine plus six cosine","prompt":"Find the maximum value of $8\\sin x+6\\cos x$.","answerType":"numeric","answer":{"value":10},"hints":["R = √(a² + b²).","The maximum is R.","Evaluate."],"steps":[{"h":"R","d":"$\\sqrt{64+36}$"}],"traps":[{"value":14,"why":"Added the coefficients."}],"criteria":[{"marks":1,"point":"10","answer":true}]},{"id":"X12-T3-046","group":"X12-T3-046","dp":"T3.1c","authored":1,"level":1,"marks":2,"title":"Sine plus cosine equals zero","prompt":"Solve $\\sin x+\\cos x=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.356194490192345,5.497787143782138]},"answerPrefix":"x =","hints":["Divide by cos x.","tan x = −1.","Quadrants 2 and 4."],"steps":[{"h":"Tangent","d":"$\\tan x=-1$"}],"traps":[{"values":["pi/4","5*pi/4"],"why":"tan x = +1 there."}],"criteria":[{"marks":1,"point":"tan x = −1","line":"tan(x) = -1"},{"marks":1,"point":"Both","answer":true}]},{"id":"X12-T3-048","group":"X12-T3-048","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Counting solutions of an auxiliary equation","prompt":"The graph of $y=2\\sin x-\\cos x$ is shown. How many solutions does $2\\sin x-\\cos x=1$ have for $0\\le x<2\\pi$? Explain.","answerType":"numeric","answer":{"value":2},"hints":["Find R.","Compare 1 with R.","Count crossings in one period."],"steps":[{"h":"Amplitude","d":"$R=\\sqrt5>1$"},{"h":"Count","d":"One period crosses $y=1$ twice"}],"traps":[{"value":1,"why":"1 is below the maximum √5."}],"criteria":[{"marks":1,"point":"R = √5","manual":true},{"marks":1,"point":"2","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Labels shown: 1, (square root of 5). Marked on the vertical axis: 1, (square root of 5). Read the question for what it asks.","w":255.91,"h":125.05,"sha256":"1f74d5f562eb98b81103e9e3c1229c379e443f98de29522624fa31106a60242c","bytes":8458}},{"id":"X12-T3-050","group":"X12-T3-050","dp":"T3.1b","authored":2,"level":2,"marks":2,"title":"Auxiliary angle as a cosine with a minus","prompt":"Express $\\cos x-\\sqrt3\\sin x$ in the form $R\\cos(x+\\alpha)$ with $0<\\alpha<\\tfrac{\\pi}{2}$.","answerType":"expression","answer":{"expr":"2*cos(x+pi/3)"},"hints":["Expand R cos(x + α).","Match coefficients.","tan α = √3."],"steps":[{"h":"R","d":"$\\sqrt{1+3}=2$"},{"h":"Angle","d":"$\\tan\\alpha=\\sqrt3$"}],"traps":[{"expr":"2*cos(x-pi/3)","why":"The minus sign gives x + α."}],"criteria":[{"marks":1,"point":"R = 2","manual":true},{"marks":1,"point":"Correct form","answer":true}]},{"id":"X12-T3-053","group":"X12-T3-053","dp":"T3.1b","authored":3,"level":3,"marks":2,"title":"Solving with an auxiliary sine form","prompt":"Solve $\\sin x-\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,3.141592653589793]},"answerPrefix":"x =","hints":["R = √2, α = π/4.","sin(θ) = 1/√2.","Shift back."],"steps":[{"h":"Rewrite","d":"$\\sqrt2\\sin\\left(x-\\tfrac{\\pi}{4}\\right)=1$"},{"h":"Solve","d":"$x-\\tfrac{\\pi}{4}=\\tfrac{\\pi}{4},\\tfrac{3\\pi}{4}$"}],"traps":[{"values":["pi/2"],"why":"The second angle gives π."}],"criteria":[{"marks":1,"point":"Auxiliary form","line":"sqrt(2)*sin(x-pi/4) = 1"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X12-T3-058","group":"X12-T3-058","dp":"T3.1c","authored":3,"level":3,"marks":2,"title":"Triple angle cosine equation","prompt":"Using $\\cos3\\theta=4\\cos^{3}\\theta-3\\cos\\theta$, solve $4\\cos^{3}\\theta-3\\cos\\theta=\\tfrac12$ for $0\\le\\theta\\le\\pi$.","answerType":"set","answer":{"values":[0.3490658503988659,1.7453292519943295,2.443460952792061]},"answerPrefix":"θ =","hints":["Recognise cos 3θ.","3θ in [0, 3π].","Divide by 3."],"steps":[{"h":"Rewrite","d":"$\\cos3\\theta=\\tfrac12$"},{"h":"Solve","d":"$3\\theta=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3},\\tfrac{7\\pi}{3}$"}],"traps":[{"values":["pi/9"],"why":"3θ ranges over [0, 3π]."}],"criteria":[{"marks":1,"point":"cos 3θ = ½","line":"cos(3*theta) = 1/2"},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-063","group":"X12-T3-063","dp":"T3.1c","authored":2,"level":2,"marks":3,"title":"Cosine equation from an identity","prompt":"Solve $\\cos2x+3\\cos x+2=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.0943951023931957,3.141592653589793,4.188790204786391]},"answerPrefix":"x =","hints":["cos 2x = 2cos²x − 1.","Factorise.","Solve each."],"steps":[{"h":"Identity","d":"$2\\cos^{2}x+3\\cos x+1=0$"},{"h":"Factor","d":"$(2\\cos x+1)(\\cos x+1)=0$"}],"traps":[{"values":["2*pi/3","4*pi/3"],"why":"cos x = −1 gives π."}],"criteria":[{"marks":1,"point":"Quadratic","line":"2*cos(x)^2+3*cos(x)+1 = 0"},{"marks":1,"point":"cos x = −½, −1","manual":true},{"marks":1,"point":"All three","answer":true}]},{"id":"X12-T3-066","group":"X12-T3-066","dp":"T3.1c","authored":3,"level":3,"marks":1,"title":"Intersection count of two waves","prompt":"The graphs of $y=\\sin2x$ and $y=\\sin x$ for $0\\le x\\le2\\pi$ are shown. How many solutions does $\\sin2x=\\sin x$ have here?","answerType":"numeric","answer":{"value":5},"hints":["Factor sin x(2cos x − 1).","Count both cases.","Include the endpoints."],"steps":[{"h":"Solve","d":"$\\sin x=0$: $0,\\pi,2\\pi$; $\\cos x=\\tfrac12$: $\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$"}],"traps":[{"value":3,"why":"Include cos x = ½."}],"criteria":[{"marks":1,"point":"5","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Labels shown: pi, 2 pi. Marked on the horizontal axis: pi, 2 pi; vertical axis: 1. Read the question for what it asks.","w":236.1,"h":109.94,"sha256":"b30838205a5afce15eae56a64f9ad37c7632f8b70dd3e91054c5c05bbce4f7ba","bytes":9334}},{"id":"X12-T3-067","group":"X12-T3-067","dp":"T3.1b","authored":2,"level":2,"marks":2,"title":"Auxiliary form from a graph","prompt":"The graph shown is $y=R\\sin(x-\\alpha)$, with maximum $(\\tfrac{2\\pi}{3},2)$. Write it as $a\\sin x+b\\cos x$.","answerType":"expression","answer":{"expr":"sqrt(3)*sin(x)-cos(x)"},"hints":["Peak at α + π/2.","So α = π/6.","Expand."],"steps":[{"h":"Read","d":"$R=2$, $\\alpha=\\tfrac{\\pi}{6}$"},{"h":"Expand","d":"$2\\left(\\sin x\\cdot\\tfrac{\\sqrt3}{2}-\\cos x\\cdot\\tfrac12\\right)$"}],"traps":[{"expr":"sqrt(3)*sin(x)+cos(x)","why":"sin(x − α) gives a minus."}],"criteria":[{"marks":1,"point":"R and α","manual":true},{"marks":1,"point":"Expanded form","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 1 plotted line, curve or set of points is drawn. Labels shown: (pi over 6), (2 pi over 3). Marked on the horizontal axis: (pi over 6), (2 pi over 3); vertical axis: minus 2, 2. Read the question for what it asks.","w":245.65,"h":109.93,"sha256":"70cd5aac415d992857703a24ec06fdbae7963cb30b55fb2fd3a89ca6f4264d32","bytes":9535}},{"id":"X12-T3-069","group":"X12-T3-069","dp":"T3.1c","authored":3,"level":3,"marks":1,"title":"Count solutions with a shifted line","prompt":"The graph of $y=\\cos2x$ for $0\\le x\\le2\\pi$ and the line $y=\\tfrac{x}{2\\pi}$ are shown. How many solutions does $\\cos2x=\\tfrac{x}{2\\pi}$ have?","answerType":"numeric","answer":{"value":4},"hints":["cos 2x has two periods here.","Line rises from 0 to 1.","Count crossings per period."],"steps":[{"h":"Count","d":"Two crossings in $[0,\\pi]$, one in $(\\pi,2\\pi)$, and $x=2\\pi$ itself"}],"traps":[{"value":2,"why":"There are two periods."}],"criteria":[{"marks":1,"point":"4","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn; some of the plotted lines are dashed. Labels shown: pi, 2 pi. Marked on the horizontal axis: pi, 2 pi; vertical axis: 1. Read the question for what it asks.","w":236.1,"h":109.94,"sha256":"4d3e2d4ee0b66ea8936ec3d5da91fa52464ae7836cd724347bc8eba90e0129e1","bytes":10869}},{"id":"X12-T3-072","group":"X12-T3-072","dp":"T3.1c","authored":3,"level":3,"marks":2,"title":"Sum of solutions of a trig equation","prompt":"Find the sum of all solutions of $\\cos2x=\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":12.566370614359172},"hints":["cos 2x = 2cos²x − 1.","Factor.","Add the solutions."],"steps":[{"h":"Quadratic","d":"$(2\\cos x+1)(\\cos x-1)=0$"},{"h":"Solutions","d":"$0,\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3},2\\pi$"}],"traps":[{"value":6.283185307179586,"why":"Include 0 and 2π.","expr":"2*pi"}],"criteria":[{"marks":1,"point":"All solutions","manual":true},{"marks":1,"point":"4π","answer":true}]},{"id":"X12-T3-077","group":"X12-T3-077","dp":"T3.1c","authored":4,"level":4,"marks":3,"title":"Equation with a triple angle identity","prompt":"Solve $\\sin3x=\\sin x$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[0,0.7853981633974483,2.356194490192345,3.141592653589793]},"answerPrefix":"x =","hints":["sin 3x = 3 sin x − 4 sin³x.","Factor sin x.","cos 2x = 0 too."],"steps":[{"h":"Identity","d":"$3\\sin x-4\\sin^{3}x=\\sin x$"},{"h":"Factor","d":"$2\\sin x(1-2\\sin^{2}x)=0$"}],"traps":[{"values":["pi/4","3*pi/4"],"why":"sin x = 0 gives 0 and π."}],"criteria":[{"marks":1,"point":"Uses identity","manual":true},{"marks":1,"point":"Factorises","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X12-T3-078","group":"X12-T3-078","dp":"T3.1c","authored":5,"level":4,"marks":3,"title":"Equation in tan with a double angle","prompt":"Solve $\\tan2x=3\\tan x$ for $0\\le x<\\pi$.","answerType":"set","answer":{"values":[0,0.5235987755982989,2.6179938779914944]},"answerPrefix":"x =","hints":["Let t = tan x.","Multiply out.","Three t values."],"steps":[{"h":"Formula","d":"$\\dfrac{2t}{1-t^{2}}=3t$"},{"h":"Factor","d":"$t(3t^{2}-1)=0$"},{"h":"Solve","d":"$t=0,\\pm\\tfrac{1}{\\sqrt3}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"t = 0 gives x = 0."}],"criteria":[{"marks":1,"point":"Equation in t","manual":true},{"marks":1,"point":"t values","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X12-T3-079","group":"X12-T3-079","dp":"T3.1c","authored":4,"level":4,"marks":2,"title":"Sum of solutions of a sine equation","prompt":"Find the sum of the solutions of $\\sin2x=\\tfrac12$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":9.42477796076938},"hints":["2x in [0, 4π].","Four solutions.","Add."],"steps":[{"h":"Solutions","d":"$\\tfrac{\\pi}{12},\\tfrac{5\\pi}{12},\\tfrac{13\\pi}{12},\\tfrac{17\\pi}{12}$"},{"h":"Sum","d":"$\\tfrac{36\\pi}{12}$"}],"traps":[{"value":1.5707963267948966,"why":"Add all four solutions.","expr":"pi/2"}],"criteria":[{"marks":1,"point":"All four","manual":true},{"marks":1,"point":"Sum","answer":true}]}]}
