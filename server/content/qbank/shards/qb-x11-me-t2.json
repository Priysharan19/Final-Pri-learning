{"family":"qb-x11-me-t2","course":"EXT1","year":11,"topic":"ME-T2","questions":[{"id":"X11-T2-001","group":"X11-T2-001","dp":"T2.1a","authored":1,"level":1,"marks":2,"title":"Exact cosine of 75 degrees","prompt":"Find the exact value of $\\cos75^\\circ$.","answerType":"numeric","answer":{"value":0.25881904510252074},"hints":["75 = 45 + 30.","cos(A + B) has a minus.","Rationalise."],"steps":[{"h":"Expand","d":"$\\cos45^\\circ\\cos30^\\circ-\\sin45^\\circ\\sin30^\\circ$"},{"h":"Simplify","d":"$\\tfrac{\\sqrt6-\\sqrt2}{4}$"}],"traps":[{"value":0.9659258262890682,"why":"That is cos 15°.","expr":"(sqrt(6)+sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Compound angle expansion","line":"cos(45°)*cos(30°)-sin(45°)*sin(30°)"},{"marks":1,"point":"(√6 − √2)/4","answer":true}]},{"id":"X11-T2-005","group":"X11-T2-005","dp":"T2.1b","authored":3,"level":3,"marks":3,"title":"Double angle quadratic","prompt":"Solve $\\cos2x+\\cos x=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,3.141592653589793,5.235987755982989]},"answerPrefix":"x =","hints":["Use cos 2x = 2cos²x − 1.","Factorise.","Solve each factor."],"steps":[{"h":"Quadratic","d":"$2\\cos^{2}x+\\cos x-1=0$"},{"h":"Factor","d":"$(2\\cos x-1)(\\cos x+1)=0$"},{"h":"Solve","d":"$x=\\tfrac{\\pi}{3},\\pi,\\tfrac{5\\pi}{3}$"}],"traps":[{"values":["pi/3","5*pi/3"],"why":"Missed cos x = −1."}],"criteria":[{"marks":1,"point":"Quadratic in cos x","line":"2*cos(x)^2+cos(x)-1 = 0"},{"marks":1,"point":"Factorises","line":"(2*cos(x)-1)*(cos(x)+1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X11-T2-008","group":"X11-T2-008","dp":"T2.1a","authored":3,"level":3,"marks":3,"title":"Stacked triangles for a compound angle","prompt":"The diagram shows acute angles $\\alpha$ and $\\beta$ with $\\tan\\alpha=\\tfrac34$ and $\\tan\\beta=\\tfrac{5}{12}$. Find the exact value of $\\sin(\\alpha+\\beta)$.","answerType":"numeric","answer":{"value":0.8615384615384616},"hints":["Draw 3-4-5 and 5-12-13 triangles.","sin(A + B) = sin A cos B + cos A sin B.","Multiply out."],"steps":[{"h":"Ratios","d":"$\\sin\\alpha=\\tfrac35,\\cos\\alpha=\\tfrac45$; $\\sin\\beta=\\tfrac{5}{13},\\cos\\beta=\\tfrac{12}{13}$"},{"h":"Expand","d":"$\\tfrac35\\cdot\\tfrac{12}{13}+\\tfrac45\\cdot\\tfrac{5}{13}=\\tfrac{56}{65}$"}],"traps":[{"value":0.24615384615384617,"why":"Used sin(α − β).","expr":"16/65"}],"criteria":[{"marks":1,"point":"All four ratios","manual":true},{"marks":1,"point":"Expansion","line":"3/5*12/13+4/5*5/13"},{"marks":1,"point":"56/65","answer":true}],"diagram":{"alt":"1 closed shape is drawn. Labels shown: alpha, beta, 4, 3, 5. Read the question for what it asks.","w":153.4,"h":155.31,"sha256":"5ab667f76608accf9709eae2cc10ba098d79668dbca3d4db69791322a8ac115a","bytes":5234}},{"id":"X11-T2-013","group":"X11-T2-013","dp":"T2.1b","authored":2,"level":2,"marks":2,"title":"Exact sine of 22.5 degrees","prompt":"Use $\\cos2\\theta=1-2\\sin^{2}\\theta$ to find the exact value of $\\sin22.5^\\circ$.","answerType":"expression","answer":{"expr":"sqrt(2-sqrt(2))/2"},"hints":["Let θ = 22.5°.","cos 45° = 1/√2.","Take the positive root."],"steps":[{"h":"Rearrange","d":"$\\sin^{2}22.5^\\circ=\\tfrac{1-\\cos45^\\circ}{2}=\\tfrac{2-\\sqrt2}{4}$"},{"h":"Root","d":"Positive: $\\tfrac{\\sqrt{2-\\sqrt2}}{2}$"}],"traps":[{"expr":"sqrt(2+sqrt(2))/2","why":"That is cos 22.5°."}],"criteria":[{"marks":1,"point":"sin² = (2 − √2)/4","line":"(1-cos(45°))/2"},{"marks":1,"point":"Positive root","answer":true}]},{"id":"X11-T2-019","group":"X11-T2-019","dp":"T2.1b","authored":2,"level":2,"marks":2,"title":"Double angle of an inverse sine","prompt":"Find the exact value of $\\cos\\!\\left(2\\sin^{-1}\\tfrac13\\right)$.","answerType":"numeric","answer":{"value":0.7777777777777778},"hints":["Let θ = sin⁻¹ ⅓.","Choose the cos 2θ form with sin.","Substitute."],"steps":[{"h":"Double angle","d":"$1-2\\sin^{2}\\theta=1-\\tfrac29=\\tfrac79$"}],"traps":[{"value":0.3333333333333333,"why":"Treated cos(2 sin⁻¹ x) as 2x − 1.","expr":"1/3"}],"criteria":[{"marks":1,"point":"cos 2θ = 1 − 2 sin²θ","line":"1-2*(1/3)^2"},{"marks":1,"point":"7/9","answer":true}]},{"id":"X11-T2-021","group":"X11-T2-021","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Sine of 105 degrees","prompt":"Find the exact value of $\\sin105^\\circ$.","answerType":"numeric","answer":{"value":0.9659258262890683},"hints":["105 = 60 + 45.","Expand sin(A + B).","Simplify."],"steps":[{"h":"Split","d":"$\\sin(60^\\circ+45^\\circ)=\\tfrac{\\sqrt3}{2}\\cdot\\tfrac{\\sqrt2}{2}+\\tfrac12\\cdot\\tfrac{\\sqrt2}{2}$"}],"traps":[{"value":0.2588190451025207,"why":"That is sin 15°.","expr":"(sqrt(6)-sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Compound angle expansion","line":"sin(60°)*cos(45°)+cos(60°)*sin(45°)"},{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-024","group":"X11-T2-024","dp":"T2.1b","authored":3,"level":3,"marks":3,"title":"Double angle becomes a quadratic in sine","prompt":"Solve $\\cos2x=3\\sin x-1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944]},"answerPrefix":"x =","hints":["Use the sin form of cos 2x.","Factorise.","sin x = −2 is impossible."],"steps":[{"h":"Substitute","d":"$1-2\\sin^{2}x=3\\sin x-1\\Rightarrow2\\sin^{2}x+3\\sin x-2=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x+2)=0$"},{"h":"Solve","d":"$\\sin x=\\tfrac12$ only"}],"traps":[{"values":["pi/6"],"why":"Sine is also positive in quadrant 2."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2+3*sin(x)-2 = 0"},{"marks":1,"point":"Rejects sin x = −2","line":"(2*sin(x)-1)*(sin(x)+2) = 0"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X11-T2-026","group":"X11-T2-026","dp":"T2.1c","authored":3,"level":3,"marks":3,"title":"Linear trig equation with t","prompt":"Use $t=\\tan\\dfrac x2$ to solve $2\\sin x+\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,2.214297435588181,6.283185307179586]},"answerPrefix":"x =","hints":["Write in t and clear the denominator.","Solve for t.","x = π is not covered by t; check it."],"steps":[{"h":"Substitute","d":"$4t+1-t^{2}=1+t^{2}\\Rightarrow2t(t-2)=0$"},{"h":"Solve","d":"$t=0$: $x=0,2\\pi$; $t=2$: $x=2\\tan^{-1}2$"},{"h":"Check π","d":"$2(0)+(-1)\\ne1$"}],"traps":[{"values":["2*atan(2)"],"why":"t = 0 gives x = 0 and 2π."}],"criteria":[{"marks":1,"point":"t(t − 2) = 0","line":"t*(t-2) = 0"},{"marks":1,"point":"Checks x = π","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X11-T2-027","group":"X11-T2-027","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Cosine squared of pi on eight","prompt":"Find the exact value of $\\cos^{2}\\dfrac{\\pi}{8}$.","answerType":"numeric","answer":{"value":0.8535533905932737},"hints":["2 × π/8 = π/4.","Use cos² = ½(1 + cos 2θ).","cos(π/4) = √2/2."],"steps":[{"h":"Identity","d":"$\\cos^{2}\\theta=\\tfrac12(1+\\cos2\\theta)$"},{"h":"Evaluate","d":"$\\tfrac12\\left(1+\\tfrac{\\sqrt2}{2}\\right)$"}],"traps":[{"value":0.1464466094067262,"why":"That is sin²(π/8).","expr":"(2-sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Uses the double angle identity","line":"(1+cos(pi/4))/2"},{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-032","group":"X11-T2-032","dp":"T2.1b","authored":2,"level":2,"marks":2,"title":"Angle between two lines","prompt":"Find the acute angle between the lines $y=3x$ and $y=\\tfrac12x$, shown below.","answerType":"numeric","answer":{"value":45},"hints":["Use tan θ = |(m₁ − m₂)/(1 + m₁m₂)|.","Substitute.","Inverse tangent."],"steps":[{"h":"Formula","d":"$\\tan\\theta=\\left|\\dfrac{3-\\frac12}{1+\\frac32}\\right|=1$"}],"traps":[{"value":135,"why":"The question asks for the acute angle."}],"criteria":[{"marks":1,"point":"tan θ = 1","line":"tan(θ) = 1"},{"marks":1,"point":"45°","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn. Labels shown: theta. Read the question for what it asks.","w":184.81,"h":147.73,"sha256":"97a2f9a7c0251c6b457fae02328b043f7987825704141299fbc42da4a6ec1215","bytes":9881}},{"id":"X11-T2-035","group":"X11-T2-035","dp":"T2.1e","authored":3,"level":3,"marks":3,"title":"Sum to product equation","prompt":"Solve $\\sin x+\\sin3x=\\sin2x$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[0,1.0471975511965979,1.5707963267948966,3.141592653589793]},"answerPrefix":"x =","hints":["Combine sin 3x + sin x.","Do not divide by sin 2x.","Solve each factor."],"steps":[{"h":"Sum to product","d":"$\\sin3x+\\sin x=2\\sin2x\\cos x$"},{"h":"Factor","d":"$\\sin2x(2\\cos x-1)=0$"},{"h":"Solve","d":"$\\sin2x=0$: $0,\\tfrac{\\pi}{2},\\pi$; $\\cos x=\\tfrac12$: $\\tfrac{\\pi}{3}$"}],"traps":[{"values":["pi/3"],"why":"Divided by sin 2x."}],"criteria":[{"marks":1,"point":"2 sin 2x cos x","line":"2*sin(2*x)*cos(x) = sin(2*x)"},{"marks":1,"point":"Factorises","line":"sin(2*x)*(2*cos(x)-1) = 0"},{"marks":1,"point":"All four","answer":true}]},{"id":"X11-T2-036","group":"X11-T2-036","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Cosine of fifteen degrees","prompt":"Find the exact value of $\\cos15^\\circ$.","answerType":"numeric","answer":{"value":0.9659258262890683},"hints":["15 = 45 − 30.","cos(A − B) has a plus.","Simplify."],"steps":[{"h":"Split","d":"$\\cos(45^\\circ-30^\\circ)=\\tfrac{\\sqrt2}{2}\\cdot\\tfrac{\\sqrt3}{2}+\\tfrac{\\sqrt2}{2}\\cdot\\tfrac12$"}],"traps":[{"value":0.2588190451025207,"why":"That is cos 75°.","expr":"(sqrt(6)-sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Compound angle expansion","line":"cos(45°)*cos(30°)+sin(45°)*sin(30°)"},{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-040","group":"X11-T2-040","dp":"T2.1b","authored":3,"level":3,"marks":3,"title":"Double angle against root three cosine","prompt":"Solve $\\sin2x=\\sqrt3\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,1.5707963267948966,2.0943951023931957,4.71238898038469]},"answerPrefix":"x =","hints":["sin 2x = 2 sin x cos x.","Bring to one side and factorise.","Solve each factor."],"steps":[{"h":"Factor","d":"$\\cos x(2\\sin x-\\sqrt3)=0$"},{"h":"Solve","d":"$\\cos x=0$: $\\tfrac{\\pi}{2},\\tfrac{3\\pi}{2}$; $\\sin x=\\tfrac{\\sqrt3}{2}$: $\\tfrac{\\pi}{3},\\tfrac{2\\pi}{3}$"}],"traps":[{"values":["pi/3","2*pi/3"],"why":"Divided by cos x."}],"criteria":[{"marks":1,"point":"Factorises","line":"cos(x)*(2*sin(x)-sqrt(3)) = 0"},{"marks":1,"point":"cos x = 0 solutions","manual":true},{"marks":1,"point":"All four","answer":true}]},{"id":"X11-T2-042","group":"X11-T2-042","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"A linear combination equal to zero","prompt":"Solve $3\\cos x-4\\sin x=0$ for $0\\le x\\le2\\pi$, giving exact answers.","answerType":"set","answer":{"values":[0.6435011087932844,3.785093762383078]},"answerPrefix":"x =","hints":["Divide by cos x.","tan x = 3/4.","Add π."],"steps":[{"h":"Divide","d":"$\\tan x=\\tfrac34$"},{"h":"Solve","d":"Quadrants 1 and 3"}],"traps":[{"values":["atan(4/3)","pi+atan(4/3)"],"why":"Inverted the ratio."}],"criteria":[{"marks":1,"point":"tan x = 3/4","line":"tan(x) = 3/4"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"X11-T2-043","group":"X11-T2-043","dp":"T2.1b","authored":2,"level":2,"marks":1,"title":"Cosine of a double angle from a tangent","prompt":"Given $\\tan\\theta=2$, find $\\cos2\\theta$ using $\\cos2\\theta=\\dfrac{1-\\tan^{2}\\theta}{1+\\tan^{2}\\theta}$.","answerType":"numeric","answer":{"value":-0.6},"hints":["t = 2.","1 − t² = −3.","1 + t² = 5."],"steps":[{"h":"Substitute","d":"$\\dfrac{1-4}{1+4}$"}],"traps":[{"value":0.6,"why":"Sign of 1 − 4.","expr":"3/5"}],"criteria":[{"marks":1,"point":"−3/5","answer":true}]},{"id":"X11-T2-045","group":"X11-T2-045","dp":"T2.1e","authored":2,"level":2,"marks":1,"title":"Angle between two steep lines","prompt":"Find the acute angle between the lines $y=\\sqrt3x$ and $y=x$, shown below.","answerType":"numeric","answer":{"value":15},"hints":["tan⁻¹√3 = 60°.","tan⁻¹ 1 = 45°.","Subtract."],"steps":[{"h":"Inclinations","d":"$60^\\circ-45^\\circ$"}],"traps":[{"value":105,"why":"That is the obtuse angle."}],"criteria":[{"marks":1,"point":"15°","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 2 plotted lines, curves or sets of points are drawn. Labels shown: theta. Read the question for what it asks.","w":165.92,"h":147.73,"sha256":"fb355a39daacb12131d081b960d7f2bee298ffe01e4299019710c694b250d1ad","bytes":9833}},{"id":"X11-T2-046","group":"X11-T2-046","dp":"T2.1a","authored":1,"level":1,"marks":2,"title":"Sine of seventy-five degrees","prompt":"Find the exact value of $\\sin75^\\circ$.","answerType":"numeric","answer":{"value":0.9659258262890683},"hints":["75 = 45 + 30.","Expand.","Simplify."],"steps":[{"h":"Split","d":"$\\sin(45^\\circ+30^\\circ)$"}],"traps":[{"value":0.2588190451025207,"why":"That is sin 15°.","expr":"(sqrt(6)-sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Expansion","line":"sin(45°)*cos(30°)+cos(45°)*sin(30°)"},{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-047","group":"X11-T2-047","dp":"T2.1a","authored":2,"level":2,"marks":2,"title":"Tangent of 105 degrees","prompt":"Find the exact value of $\\tan105^\\circ$.","answerType":"numeric","answer":{"value":-3.732050807568877},"hints":["105 = 60 + 45.","tan(A + B).","Rationalise."],"steps":[{"h":"Split","d":"$\\tan(60^\\circ+45^\\circ)=\\dfrac{\\sqrt3+1}{1-\\sqrt3}$"},{"h":"Rationalise","d":"$-(2+\\sqrt3)$"}],"traps":[{"value":3.732050807568877,"why":"105° is obtuse, so tan is negative.","expr":"2+sqrt(3)"}],"criteria":[{"marks":1,"point":"Compound expansion","line":"(sqrt(3)+1)/(1-sqrt(3))"},{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-049","group":"X11-T2-049","dp":"T2.1b","authored":3,"level":3,"marks":3,"title":"Double angle and a sine term","prompt":"Solve $\\cos2x+3\\sin x=2$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,1.5707963267948966,2.6179938779914944]},"answerPrefix":"x =","hints":["cos 2x = 1 − 2sin²x.","Rearrange.","Factorise."],"steps":[{"h":"Substitute","d":"$2\\sin^{2}x-3\\sin x+1=0$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x-1)=0$"},{"h":"Solve","d":"$\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6},\\tfrac{\\pi}{2}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Missed sin x = 1."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2-3*sin(x)+1 = 0"},{"marks":1,"point":"Factorises","line":"(2*sin(x)-1)*(sin(x)-1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"X11-T2-051","group":"X11-T2-051","dp":"T2.1c","authored":2,"level":2,"marks":1,"title":"Tangent from a half-angle value","prompt":"Given $\\tan\\dfrac x2=\\dfrac12$, find $\\tan x$.","answerType":"numeric","answer":{"value":1.3333333333333333},"hints":["tan x = 2t/(1 − t²).","t = ½.","Evaluate."],"steps":[{"h":"Formula","d":"$\\dfrac{2t}{1-t^{2}}=\\dfrac{1}{3/4}$"}],"traps":[{"value":1,"why":"tan x is not 2 tan(x/2)."}],"criteria":[{"marks":1,"point":"4/3","answer":true}]},{"id":"X11-T2-053","group":"X11-T2-053","dp":"T2.1b","authored":3,"level":3,"marks":2,"title":"When tan 2x equals tan x","prompt":"Solve $\\tan2x=\\tan x$ for $0\\le x\\le\\pi$, excluding values where either side is undefined.","answerType":"set","answer":{"values":[0,3.141592653589793]},"answerPrefix":"x =","hints":["Tangents equal means angles differ by nπ.","Solve for x.","Check each is defined."],"steps":[{"h":"Period","d":"$2x=x+n\\pi\\Rightarrow x=n\\pi$"},{"h":"Check","d":"$0$ and $\\pi$ are defined"}],"traps":[{"values":[0,"pi/2","pi"],"why":"tan(π/2) is undefined."}],"criteria":[{"marks":1,"point":"x = nπ","manual":true},{"marks":1,"point":"Both","answer":true}]},{"id":"X11-T2-054","group":"X11-T2-054","dp":"T2.1e","authored":2,"level":2,"marks":1,"title":"Product of sine and cosine of pi on twelve","prompt":"Find the exact value of $\\sin\\dfrac{\\pi}{12}\\cos\\dfrac{\\pi}{12}$.","answerType":"numeric","answer":{"value":0.25},"hints":["sin θ cos θ = ½ sin 2θ.","2θ = π/6.","sin(π/6) = ½."],"steps":[{"h":"Double angle","d":"$\\tfrac12\\sin\\tfrac{\\pi}{6}$"}],"traps":[{"value":0.5,"why":"Forgot the ½.","expr":"1/2"}],"criteria":[{"marks":1,"point":"¼","answer":true}]},{"id":"X11-T2-056","group":"X11-T2-056","dp":"T2.1d","authored":2,"level":2,"marks":1,"title":"Auxiliary angle for a maximum","prompt":"Find the maximum value of $5\\sin x+12\\cos x$.","answerType":"numeric","answer":{"value":13},"hints":["Write as R sin(x + α).","R = √(a² + b²).","Max is R."],"steps":[{"h":"Amplitude","d":"$\\sqrt{25+144}$"}],"traps":[{"value":17,"why":"Amplitude is √(a² + b²), not a + b."}],"criteria":[{"marks":1,"point":"13","answer":true}]},{"id":"X11-T2-057","group":"X11-T2-057","dp":"T2.1d","authored":3,"level":3,"marks":3,"title":"Solving with the auxiliary form","prompt":"Solve $\\sqrt3\\sin x+\\cos x=1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0,2.0943951023931957,6.283185307179586]},"answerPrefix":"x =","hints":["R = 2.","α = π/6.","Watch the shifted interval."],"steps":[{"h":"Rewrite","d":"$2\\sin\\left(x+\\tfrac{\\pi}{6}\\right)=1$"},{"h":"Solve","d":"$x+\\tfrac{\\pi}{6}=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6},\\tfrac{13\\pi}{6}$"}],"traps":[{"values":[0,"2*pi/3"],"why":"Missed 2π."}],"criteria":[{"marks":1,"point":"R = 2, α = π/6","line":"2*sin(x+pi/6) = 1"},{"marks":1,"point":"Solves for the angle","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X11-T2-058","group":"X11-T2-058","dp":"T2.1c","authored":3,"level":3,"marks":3,"title":"Tangent half-angle substitution","prompt":"Using $t=\\tan\\dfrac x2$, solve $3\\sin x+4\\cos x=4$ for $0\\le x<2\\pi$, giving exact answers.","answerType":"set","answer":{"values":[0,1.2870022175865687]},"answerPrefix":"x =","hints":["sin x = 2t/(1 + t²).","cos x = (1 − t²)/(1 + t²).","Solve for t then x."],"steps":[{"h":"Substitute","d":"$\\dfrac{6t}{1+t^{2}}+\\dfrac{4(1-t^{2})}{1+t^{2}}=4$"},{"h":"Simplify","d":"$8t^{2}-6t=0\\Rightarrow t=0,\\tfrac34$"},{"h":"Angles","d":"$x=0$, $x=2\\tan^{-1}\\tfrac34$"}],"traps":[{"values":[0],"why":"t = ¾ gives another angle."}],"criteria":[{"marks":1,"point":"Quadratic in t","line":"8*t^2-6*t = 0"},{"marks":1,"point":"t = 0, ¾","manual":true},{"marks":1,"point":"Both angles","answer":true}]},{"id":"X11-T2-059","group":"X11-T2-059","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Expanding cosine of a difference","prompt":"Find the exact value of $\\cos15^\\circ$.","answerType":"numeric","answer":{"value":0.9659258262890683},"hints":["15 = 45 − 30.","cos(A − B) has a plus.","Multiply out."],"steps":[{"h":"Difference","d":"$\\cos45\\cos30+\\sin45\\sin30$"}],"traps":[{"value":0.2588190451025207,"why":"That is sin 15°.","expr":"(sqrt(6)-sqrt(2))/4"}],"criteria":[{"marks":1,"point":"Exact value","answer":true}]},{"id":"X11-T2-061","group":"X11-T2-061","dp":"T2.1b","authored":2,"level":2,"marks":3,"title":"Cos 2x in terms of sine","prompt":"Solve $\\cos2x=\\sin x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944,4.71238898038469]},"answerPrefix":"x =","hints":["cos 2x = 1 − 2 sin²x.","Rearrange to a quadratic.","Solve each factor."],"steps":[{"h":"Identity","d":"$1-2\\sin^{2}x=\\sin x$"},{"h":"Factor","d":"$(2\\sin x-1)(\\sin x+1)=0$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"sin x = −1 gives 3π/2."}],"criteria":[{"marks":1,"point":"Quadratic in sin x","line":"2*sin(x)^2+sin(x)-1 = 0"},{"marks":1,"point":"sin x = ½ or −1","manual":true},{"marks":1,"point":"All solutions","answer":true}]},{"id":"X11-T2-062","group":"X11-T2-062","dp":"T2.1a","authored":2,"level":2,"marks":1,"title":"Angle between a line and the x-axis via tangent","prompt":"Find the acute angle between the lines $y=3x$ and $y=-x$, to the nearest degree.","answerType":"numeric","answer":{"value":63},"hints":["tan θ = |(m₁ − m₂)/(1 + m₁m₂)|.","Substitute.","Inverse tan of 2."],"steps":[{"h":"Formula","d":"$\\tan\\theta=\\left|\\dfrac{3-(-1)}{1+3(-1)}\\right|=2$"}],"traps":[{"value":117,"why":"Take the acute angle."}],"criteria":[{"marks":1,"point":"63°","answer":true}]},{"id":"X11-T2-064","group":"X11-T2-064","dp":"T2.1c","authored":2,"level":2,"marks":2,"title":"Half-angle formula for tangent","prompt":"Given $\\cos\\theta=\\tfrac{1}{3}$ with $\\theta$ acute, find $\\tan\\dfrac{\\theta}{2}$.","answerType":"numeric","answer":{"value":0.7071067811865476},"hints":["Use the half-angle identity.","Substitute cos θ.","Positive root."],"steps":[{"h":"Identity","d":"$\\tan^{2}\\tfrac{\\theta}{2}=\\dfrac{1-\\cos\\theta}{1+\\cos\\theta}=\\tfrac12$"}],"traps":[{"value":0.5,"why":"Take the square root.","expr":"1/2"}],"criteria":[{"marks":1,"point":"tan² = ½","line":"(1-1/3)/(1+1/3)"},{"marks":1,"point":"1/√2","answer":true}]},{"id":"X11-T2-065","group":"X11-T2-065","dp":"T2.1a","authored":2,"level":2,"marks":1,"title":"Product to sum for an integral-style identity","prompt":"Express $2\\sin3x\\cos x$ as a sum of sines.","answerType":"expression","answer":{"expr":"sin(4*x)+sin(2*x)"},"hints":["2 sin A cos B = sin(A + B) + sin(A − B).","A = 3x, B = x.","Simplify."],"steps":[{"h":"Product to sum","d":"$\\sin(3x+x)+\\sin(3x-x)$"}],"traps":[{"expr":"sin(4*x)-sin(2*x)","why":"Both terms are added."}],"criteria":[{"marks":1,"point":"Correct sum","answer":true}]},{"id":"X11-T2-066","group":"X11-T2-066","dp":"T2.1c","authored":2,"level":2,"marks":1,"title":"t-formula expression","prompt":"Using $t=\\tan\\dfrac{x}{2}$, express $\\dfrac{1-\\cos x}{\\sin x}$ in terms of $t$.","answerType":"expression","answer":{"expr":"t"},"hints":["1 − cos x = 2t²/(1 + t²).","sin x = 2t/(1 + t²).","Divide."],"steps":[{"h":"Substitute","d":"$\\dfrac{2t^{2}/(1+t^{2})}{2t/(1+t^{2})}$"}],"traps":[{"expr":"1/t","why":"Invert correctly."}],"criteria":[{"marks":1,"point":"t","answer":true}]},{"id":"X11-T2-067","group":"X11-T2-067","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Cosine of a sum in degrees","prompt":"Simplify $\\cos50^\\circ\\cos10^\\circ-\\sin50^\\circ\\sin10^\\circ$.","answerType":"numeric","answer":{"value":0.5},"hints":["cos A cos B − sin A sin B.","= cos(A + B).","60°."],"steps":[{"h":"Compound angle","d":"$\\cos60^\\circ$"}],"traps":[{"value":0.8660254037844386,"why":"That is cos 30°.","expr":"sqrt(3)/2"}],"criteria":[{"marks":1,"point":"½","answer":true}]},{"id":"X11-T2-070","group":"X11-T2-070","dp":"T2.1b","authored":2,"level":2,"marks":1,"title":"Double angle for tangent","prompt":"Given $\\tan\\theta=3$, find $\\tan2\\theta$.","answerType":"numeric","answer":{"value":-0.75},"hints":["2t/(1 − t²).","t = 3.","Simplify."],"steps":[{"h":"Formula","d":"$\\dfrac{6}{1-9}$"}],"traps":[{"value":6,"why":"tan 2θ is not 2 tan θ."}],"criteria":[{"marks":1,"point":"−3/4","answer":true}]},{"id":"X11-T2-072","group":"X11-T2-072","dp":"T2.1c","authored":2,"level":2,"marks":2,"title":"Exact value of tangent of a half angle","prompt":"Find the exact value of $\\tan\\dfrac{\\pi}{8}$.","answerType":"numeric","answer":{"value":0.41421356237309503},"hints":["tan(θ/2) = (1 − cos θ)/sin θ.","θ = π/4.","Simplify."],"steps":[{"h":"Half angle","d":"$\\dfrac{1-\\cos\\frac{\\pi}{4}}{\\sin\\frac{\\pi}{4}}$"},{"h":"Simplify","d":"$\\dfrac{1-\\frac{1}{\\sqrt2}}{\\frac{1}{\\sqrt2}}=\\sqrt2-1$"}],"traps":[{"value":2.414213562373095,"why":"That is tan(3π/8).","expr":"sqrt(2)+1"}],"criteria":[{"marks":1,"point":"Half-angle formula","line":"(1-cos(pi/4))/sin(pi/4)"},{"marks":1,"point":"√2 − 1","answer":true}]},{"id":"X11-T2-075","group":"X11-T2-075","dp":"T2.1a","authored":1,"level":1,"marks":1,"title":"Tangent subtraction exact value","prompt":"Find the exact value of $\\tan15^\\circ$.","answerType":"numeric","answer":{"value":0.2679491924311227},"hints":["15 = 45 − 30.","tan(A − B).","Rationalise."],"steps":[{"h":"Difference","d":"$\\dfrac{1-\\frac{1}{\\sqrt3}}{1+\\frac{1}{\\sqrt3}}$"}],"traps":[{"value":3.732050807568877,"why":"That is tan 75°.","expr":"2+sqrt(3)"}],"criteria":[{"marks":1,"point":"2 − √3","answer":true}]},{"id":"X11-T2-076","group":"X11-T2-076","dp":"T2.1b","authored":3,"level":3,"marks":3,"title":"Equation in cos and sin of double angle","prompt":"Solve $\\sin2x=\\cos x$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,1.5707963267948966,2.6179938779914944,4.71238898038469]},"answerPrefix":"x =","hints":["sin 2x = 2 sin x cos x.","Factor cos x.","Do not cancel."],"steps":[{"h":"Factor","d":"$\\cos x(2\\sin x-1)=0$"},{"h":"Solve","d":"$\\cos x=0$ or $\\sin x=\\tfrac12$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Do not divide by cos x."}],"criteria":[{"marks":1,"point":"Factorises","line":"cos(x)*(2*sin(x)-1) = 0"},{"marks":1,"point":"Two cases","manual":true},{"marks":1,"point":"All four","answer":true}]},{"id":"X11-T2-078","group":"X11-T2-078","dp":"T2.1b","authored":3,"level":3,"marks":1,"title":"Angle between a line and its reflection","prompt":"The lines $y=2x$ and $y=\\tfrac12x$ are shown. Find the exact value of $\\tan\\theta$ where $\\theta$ is the acute angle between them.","answerType":"numeric","answer":{"value":0.75},"hints":["tan θ = |(m₁ − m₂)/(1 + m₁m₂)|.","m₁m₂ = 1.","Simplify."],"steps":[{"h":"Formula","d":"$\\left|\\dfrac{2-\\frac12}{1+1}\\right|$"}],"traps":[{"value":1.5,"why":"1 + m₁m₂ = 2.","expr":"3/2"}],"criteria":[{"marks":1,"point":"3/4","answer":true}],"diagram":{"alt":"Diagram. Labels include: theta. Read the question for what it asks.","w":181.02,"h":145.34,"sha256":"5f7bcd970b6ee4a5afb86f4ca24f89fea60ebc624cb3fa4ec3190eaa47c6d167","bytes":6009}},{"id":"X11-T2-079","group":"X11-T2-079","dp":"T2.1a","authored":2,"level":2,"marks":1,"title":"Tangent of a difference to show an angle","prompt":"Find the exact value of $\\tan\\left(\\tan^{-1}3-\\tan^{-1}\\tfrac12\\right)$.","answerType":"numeric","answer":{"value":1},"hints":["tan(A − B).","Substitute 3 and ½.","Simplify."],"steps":[{"h":"Formula","d":"$\\dfrac{3-\\tfrac12}{1+\\tfrac32}$"}],"traps":[{"value":2.5,"why":"Divide by 1 + 3/2.","expr":"5/2"}],"criteria":[{"marks":1,"point":"1","answer":true}]},{"id":"X11-T2-085","group":"X11-T2-085","dp":"T2.1c","authored":3,"level":3,"marks":2,"title":"Tangent half-angle with tangent of the full angle","prompt":"If $t=\\tan\\dfrac\\theta2$ and $\\tan\\theta=\\tfrac34$ with $\\theta$ acute, find $t$.","answerType":"numeric","answer":{"value":0.3333333333333333},"answerPrefix":"t =","hints":["tan θ = 2t/(1 − t²).","Form a quadratic.","Positive root."],"steps":[{"h":"Formula","d":"$\\dfrac{2t}{1-t^{2}}=\\tfrac34$"},{"h":"Solve","d":"$3t^{2}+8t-3=0\\Rightarrow t=\\tfrac13$"}],"traps":[{"value":-3,"why":"θ/2 is acute so t > 0."}],"criteria":[{"marks":1,"point":"Quadratic","line":"3*t^2+8*t-3 = 0"},{"marks":1,"point":"t = ⅓","answer":true}]},{"id":"X11-T2-086","group":"X11-T2-086","dp":"T2.1a","authored":2,"level":2,"marks":1,"title":"Product to sum for a cosine product","prompt":"Express $2\\cos5x\\cos3x$ as a sum.","answerType":"expression","answer":{"expr":"cos(8*x)+cos(2*x)"},"hints":["2cos A cos B.","Sum and difference.","Simplify."],"steps":[{"h":"Formula","d":"$\\cos(A+B)+\\cos(A-B)$"}],"traps":[{"expr":"cos(8*x)-cos(2*x)","why":"Both terms are added."}],"criteria":[{"marks":1,"point":"Correct sum","answer":true}]},{"id":"X11-T2-087","group":"X11-T2-087","dp":"T2.1c","authored":2,"level":2,"marks":1,"title":"Reciprocal of one plus cosine in t","prompt":"Express $\\dfrac{1}{1+\\cos x}$ in terms of $t=\\tan\\dfrac x2$.","answerType":"expression","answer":{"expr":"(1+t^2)/2"},"hints":["cos x in t.","Add 1.","Reciprocal."],"steps":[{"h":"Substitute","d":"$1+\\dfrac{1-t^{2}}{1+t^{2}}=\\dfrac{2}{1+t^{2}}$"}],"traps":[{"expr":"2/(1+t^2)","why":"Take the reciprocal."}],"criteria":[{"marks":1,"point":"Correct expression","answer":true}]},{"id":"X11-T2-098","group":"X11-T2-098","dp":"T2.1d","authored":5,"level":4,"marks":2,"title":"Maximum of a squared auxiliary expression","prompt":"Find the maximum value of $(\\sin x+2\\cos x)^{2}+3$.","answerType":"numeric","answer":{"value":8},"hints":["Max of |a sin + b cos| is √(a² + b²).","Square it.","Add 3."],"steps":[{"h":"R","d":"$\\sqrt5$"},{"h":"Max","d":"$5+3$"}],"traps":[{"value":12,"why":"R = √5, not 3."}],"criteria":[{"marks":1,"point":"R = √5","line":"sqrt(5)"},{"marks":1,"point":"8","answer":true}]},{"id":"X11-T2-099","group":"X11-T2-099","dp":"T2.1d","authored":3,"level":3,"marks":2,"title":"Auxiliary angle equation with exact solutions","prompt":"Solve $\\cos x-\\sin x=\\tfrac{1}{\\sqrt2}$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.26179938779914946,4.4505895925855405]},"answerPrefix":"x =","hints":["R = √2.","cos = ½.","Subtract π/4."],"steps":[{"h":"Form","d":"$\\sqrt2\\cos\\left(x+\\tfrac{\\pi}{4}\\right)=\\tfrac{1}{\\sqrt2}$"},{"h":"Solve","d":"$x+\\tfrac{\\pi}{4}=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$"}],"traps":[{"values":["pi/12"],"why":"Second solution 17π/12."}],"criteria":[{"marks":1,"point":"cos(x + π/4) = ½","line":"cos(x+pi/4) = 1/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"X11-T2-122","group":"X11-T2-122","dp":"T2.1a","authored":3,"level":3,"marks":2,"title":"Sine of a sum from two ratios","prompt":"$A$ and $B$ are acute with $\\sin A=\\tfrac35$ and $\\cos B=\\tfrac5{13}$. Find $\\sin(A+B)$.","answerType":"numeric","answer":{"value":0.9692307692307692},"hints":["Find cos A and sin B.","Expand sin(A + B).","Add."],"steps":[{"h":"Ratios","d":"$\\cos A=\\tfrac45$, $\\sin B=\\tfrac{12}{13}$"},{"h":"Expand","d":"$\\tfrac35\\cdot\\tfrac5{13}+\\tfrac45\\cdot\\tfrac{12}{13}$"}],"traps":[{"value":0.5076923076923077,"why":"sin(A + B) uses a plus sign.","expr":"33/65"}],"criteria":[{"marks":1,"point":"Missing ratios","manual":true},{"marks":1,"point":"63/65","answer":true}]},{"id":"X11-T2-123","group":"X11-T2-123","dp":"T2.1b","authored":2,"level":2,"marks":1,"title":"Double angle from a cosine","prompt":"If $\\cos x=\\tfrac13$, find $\\cos2x$.","answerType":"numeric","answer":{"value":-0.7777777777777778},"hints":["cos 2x = 2cos²x − 1.","Square ⅓.","Simplify."],"steps":[{"h":"Formula","d":"$2\\cos^{2}x-1$"}],"traps":[{"value":0.6666666666666666,"why":"cos 2x ≠ 2 cos x.","expr":"2/3"}],"criteria":[{"marks":1,"point":"−7/9","answer":true}]},{"id":"X11-T2-208","group":"X11-T2-208","dp":"T2.1a","authored":2,"level":2,"marks":1,"title":"Tangent of a difference giving seven","prompt":"Given $\\tan A=2$ and $\\tan B=-\\tfrac13$, find $\\tan(A-B)$.","answerType":"numeric","answer":{"value":7},"hints":["tan(A − B) formula.","Careful with signs.","Simplify."],"steps":[{"h":"Formula","d":"$\\dfrac{2+\\frac13}{1-\\frac23}$"}],"traps":[],"criteria":[{"marks":1,"point":"7","answer":true}]},{"id":"X11-T2-E01","group":"X11-T2-E01","dp":"T2.1e","authored":6,"level":4,"marks":4,"title":"Product of three tangents","prompt":"Prove that $\\tan\\theta\\tan(60^\\circ-\\theta)\\tan(60^\\circ+\\theta)=\\tan3\\theta$, and hence evaluate $\\tan20^\\circ\\tan40^\\circ\\tan80^\\circ$.","answerType":"numeric","answer":{"value":1.7320508075688772},"hints":["Expand each compound tangent with tan 60° = √3.","Multiply them; it is a difference of squares.","Compare with tan 3θ = (3t − t³)/(1 − 3t²)."],"steps":[{"h":"Product of two","d":"$\\tan(60^\\circ-\\theta)\\tan(60^\\circ+\\theta)=\\dfrac{3-\\tan^{2}\\theta}{1-3\\tan^{2}\\theta}$"},{"h":"Multiply","d":"$\\dfrac{3t-t^{3}}{1-3t^{2}}=\\tan3\\theta$"},{"h":"Apply","d":"$\\theta=20^\\circ$: $\\tan60^\\circ=\\sqrt3$"}],"traps":[{"value":1,"why":"The product is tan 60°, not tan 45°."}],"criteria":[{"marks":1,"point":"Product of the two compound tangents","manual":true},{"marks":1,"point":"Recognises tan 3θ formula","manual":true},{"marks":1,"point":"Chooses θ = 20°","manual":true},{"marks":1,"point":"√3","answer":true}]}]}
