{"family":"qb-a12-ma-t3","course":"ADV","year":12,"topic":"MA-T3","questions":[{"id":"A12-T3-013","group":"A12-T3-013","dp":"T3.1c","authored":1,"level":1,"marks":2,"title":"Tangent equation in two quadrants","prompt":"Solve $3\\tan x=\\sqrt3$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[0.5235987755982989,3.6651914291880923]},"answerPrefix":"x =","hints":["Divide by 3.","√3/3 = 1/√3."],"ladder":{"nudge":"Divide by 3.","method":"√3/3 = 1/√3."},"steps":[{"h":"Isolate","d":"$\\tan x=\\tfrac{1}{\\sqrt3}$"},{"h":"Solve","d":"$\\tfrac{\\pi}{6}$, $\\pi+\\tfrac{\\pi}{6}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Tangent is negative in quadrant 2."}],"criteria":[{"marks":1,"point":"tan x = 1/√3","line":"tan(x) = 1/sqrt(3)"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A12-T3-014","group":"A12-T3-014","dp":"T3.1c","authored":2,"level":2,"marks":1,"title":"Counting solutions of a double-angle equation","prompt":"How many solutions does $\\sin2x=0.5$ have for $0\\le x\\le2\\pi$?","answerType":"numeric","answer":{"value":4},"hints":["What is the period of sin 2x?","How many cycles fit in [0, 2π]?","Each cycle crosses y = 0.5 twice."],"ladder":{"nudge":"What is the period of sin 2x?","method":"How many cycles fit in [0, 2π]?","worked":"Each cycle crosses y = 0.5 twice."},"steps":[{"h":"Two cycles","d":"$\\sin2x$ completes two cycles, each giving two solutions."}],"traps":[{"value":2,"why":"2x runs over [0, 4π]."}],"criteria":[{"marks":1,"point":"4","answer":true}]},{"id":"A12-T3-016","group":"A12-T3-016","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Zeros of a shifted cosine","prompt":"Solve $\\cos\\left(x-\\dfrac{\\pi}{3}\\right)=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[2.6179938779914944,5.759586531581288]},"answerPrefix":"x =","hints":["Let u = x − π/3.","Cosine is zero at π/2 and 3π/2.","Add π/3 back."],"ladder":{"nudge":"Let u = x − π/3.","method":"Cosine is zero at π/2 and 3π/2.","worked":"Add π/3 back."},"steps":[{"h":"Shifted angle","d":"$x-\\tfrac{\\pi}{3}\\in\\left[-\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}\\right]$: $\\tfrac{\\pi}{2},\\tfrac{3\\pi}{2}$"},{"h":"Solve","d":"Add $\\tfrac{\\pi}{3}$"}],"traps":[{"values":["pi/6","7*pi/6"],"why":"Subtracted π/3 instead of adding."}],"criteria":[{"marks":1,"point":"Values of the shifted angle","line":"x-pi/3 = pi/2"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A12-T3-017","group":"A12-T3-017","dp":"T3.1a","authored":2,"level":2,"marks":2,"title":"A slow cosine","prompt":"For $y=2\\cos\\dfrac x2$, state the period, and find the $x$-intercepts in $0\\le x\\le4\\pi$.","answerType":"set","answer":{"values":[3.141592653589793,9.42477796076938]},"answerPrefix":"x =","hints":["Period is 2π/b.","Solve cos(x/2) = 0."],"ladder":{"nudge":"Period is 2π/b.","method":"Solve cos(x/2) = 0."},"steps":[{"h":"Period","d":"$\\dfrac{2\\pi}{1/2}=4\\pi$"},{"h":"Zeros","d":"$\\tfrac x2=\\tfrac{\\pi}{2},\\tfrac{3\\pi}{2}\\Rightarrow x=\\pi,3\\pi$"}],"traps":[{"values":["pi/4","3*pi/4"],"why":"Halved instead of doubling."}],"criteria":[{"marks":1,"point":"Period 4π","manual":true},{"marks":1,"point":"x = π, 3π","answer":true}]},{"id":"A12-T3-019","group":"A12-T3-019","dp":"T3.1d","authored":3,"level":3,"marks":2,"title":"Ferris wheel heights","prompt":"The height of a Ferris wheel seat is $h=20-18\\cos\\dfrac{\\pi t}{15}$ metres, $t$ seconds after it is at the bottom. Find the times in the first revolution when the seat is $29$ m high.","answerType":"set","answer":{"values":[10,20]},"answerPrefix":"t =","hints":["Set h = 29.","One revolution takes 30 s."],"ladder":{"nudge":"Set h = 29.","method":"One revolution takes 30 s."},"steps":[{"h":"Equation","d":"$\\cos\\tfrac{\\pi t}{15}=-\\tfrac12$"},{"h":"Solve","d":"$\\tfrac{\\pi t}{15}=\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3}\\Rightarrow t=10,20$"}],"traps":[{"values":[5,25],"why":"Solved cos = +½."}],"criteria":[{"marks":1,"point":"cos = −½","line":"cos(pi*t/15) = -1/2"},{"marks":1,"point":"Both times","answer":true}]},{"id":"A12-T3-021","group":"A12-T3-021","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Double angle sine equation","prompt":"Solve $2\\sin2x=1$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[0.26179938779914946,1.3089969389957472]},"answerPrefix":"x =","hints":["sin 2x = ½.","2x runs over [0, 2π]."],"ladder":{"nudge":"sin 2x = ½.","method":"2x runs over [0, 2π]."},"steps":[{"h":"Solve for 2x","d":"$2x=\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}$ in $[0,2\\pi]$"},{"h":"Halve","d":"$\\tfrac{\\pi}{12},\\tfrac{5\\pi}{12}$"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"Forgot to halve."}],"criteria":[{"marks":1,"point":"Values of 2x","line":"2*x = pi/6"},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-024","group":"A12-T3-024","dp":"T3.1c","authored":2,"level":2,"marks":1,"title":"A half-angle tangent equation","prompt":"Solve $\\tan\\dfrac x2=1$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":1.5707963267948966},"answerPrefix":"x =","hints":["x/2 lies in [0, π].","tan(π/4) = 1."],"ladder":{"nudge":"x/2 lies in [0, π].","method":"tan(π/4) = 1."},"steps":[{"h":"Range","d":"$\\tfrac x2\\in[0,\\pi]$: $\\tfrac x2=\\tfrac{\\pi}{4}$"}],"traps":[{"value":0.39269908169872414,"why":"Halved instead of doubling.","expr":"pi/8"}],"criteria":[{"marks":1,"point":"π/2","answer":true}]},{"id":"A12-T3-026","group":"A12-T3-026","dp":"T3.1c","authored":1,"level":1,"marks":1,"title":"Cosine of 2x equals minus one","prompt":"Solve $\\cos2x=-1$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[1.5707963267948966,4.71238898038469]},"answerPrefix":"x =","hints":["cos θ = −1 at θ = π.","2x ∈ [0, 4π]."],"ladder":{"nudge":"cos θ = −1 at θ = π.","method":"2x ∈ [0, 4π]."},"steps":[{"h":"Solve","d":"$2x=\\pi,3\\pi$"}],"traps":[{"values":["pi/2"],"why":"2x runs to 4π."}],"criteria":[{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-030","group":"A12-T3-030","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Factorising a tangent equation","prompt":"Solve $\\tan^{2}x-\\tan x=0$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[0,0.7853981633974483,3.141592653589793]},"answerPrefix":"x =","hints":["Factor out tan x."],"ladder":{"nudge":"Factor out tan x."},"steps":[{"h":"Factor","d":"$\\tan x(\\tan x-1)=0$"},{"h":"Solve","d":"$\\tan x=0$: $0,\\pi$; $\\tan x=1$: $\\tfrac{\\pi}{4}$"}],"traps":[{"values":["pi/4"],"why":"Divided by tan x."}],"criteria":[{"marks":1,"point":"Factorises","line":"tan(x)*(tan(x)-1) = 0"},{"marks":1,"point":"All three","answer":true}]},{"id":"A12-T3-032","group":"A12-T3-032","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Solutions of a shifted sine","prompt":"Solve $2\\sin x+1=0$ for $0\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[3.6651914291880923,5.759586531581288]},"answerPrefix":"x =","hints":["Related angle π/6."],"ladder":{"nudge":"Related angle π/6."},"steps":[{"h":"Isolate","d":"$\\sin x=-\\tfrac12$"},{"h":"Quadrants","d":"Third and fourth"}],"traps":[{"values":["pi/6","5*pi/6"],"why":"sin x is negative."}],"criteria":[{"marks":1,"point":"sin x = −½","line":"sin(x) = -1/2"},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A12-T3-035","group":"A12-T3-035","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Sine squared from a graph","prompt":"Solve $\\sin^{2}x=\\tfrac34$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,2.0943951023931957]},"answerPrefix":"x =","hints":["Square root both sides.","sin x ≥ 0 on [0, π]."],"ladder":{"nudge":"Square root both sides.","method":"sin x ≥ 0 on [0, π]."},"steps":[{"h":"Root","d":"$\\sin x=\\pm\\tfrac{\\sqrt3}{2}$, only positive in range"}],"traps":[{"values":["pi/3"],"why":"Second quadrant too."}],"criteria":[{"marks":1,"point":"sin x = √3/2","manual":true},{"marks":1,"point":"Both solutions","answer":true}]},{"id":"A12-T3-039","group":"A12-T3-039","dp":"T3.1c","authored":2,"level":2,"marks":1,"title":"Number of solutions of a triple angle","prompt":"How many solutions does $\\cos3x=0$ have for $0\\le x\\le2\\pi$?","answerType":"numeric","answer":{"value":6},"hints":["Period 2π/3.","Three periods in 2π.","Two zeros per period."],"ladder":{"nudge":"Period 2π/3.","method":"Three periods in 2π.","worked":"Two zeros per period."},"steps":[{"h":"Count","d":"Three periods, two zeros each"}],"traps":[{"value":2,"why":"Period is 2π/3."}],"criteria":[{"marks":1,"point":"6","answer":true}]},{"id":"A12-T3-042","group":"A12-T3-042","dp":"T3.1c","authored":2,"level":2,"marks":1,"title":"Solving with a horizontal shift","prompt":"Solve $\\sin\\left(x+\\tfrac{\\pi}{4}\\right)=1$ for $0\\le x\\le2\\pi$.","answerType":"numeric","answer":{"value":0.7853981633974483},"answerPrefix":"x =","hints":["sin θ = 1 at π/2.","Range of θ is [π/4, 9π/4]."],"ladder":{"nudge":"sin θ = 1 at π/2.","method":"Range of θ is [π/4, 9π/4]."},"steps":[{"h":"Angle","d":"$x+\\tfrac{\\pi}{4}=\\tfrac{\\pi}{2}$"}],"traps":[{"value":1.5707963267948966,"why":"Subtract π/4.","expr":"pi/2"}],"criteria":[{"marks":1,"point":"π/4","answer":true}]},{"id":"A12-T3-043","group":"A12-T3-043","dp":"T3.1a","authored":1,"level":1,"marks":1,"title":"Period of a tangent function","prompt":"State the period of $y=3\\tan\\dfrac{x}{2}$.","answerType":"numeric","answer":{"value":6.283185307179586},"hints":["Tangent period π/b."],"ladder":{"nudge":"Tangent period π/b."},"steps":[{"h":"Period","d":"$\\dfrac{\\pi}{1/2}$"}],"traps":[{"value":12.566370614359172,"why":"Tangent period is π/b.","expr":"4*pi"}],"criteria":[{"marks":1,"point":"2π","answer":true}]},{"id":"A12-T3-044","group":"A12-T3-044","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Solving with a vertical shift","prompt":"Solve $2\\cos x+\\sqrt3=0$ for $-\\pi\\le x\\le\\pi$.","answerType":"set","answer":{"values":[2.6179938779914944,-2.6179938779914944]},"answerPrefix":"x =","hints":["Related angle π/6.","Second and third quadrants."],"ladder":{"nudge":"Related angle π/6.","method":"Second and third quadrants."},"steps":[{"h":"Isolate","d":"$\\cos x=-\\tfrac{\\sqrt3}{2}$"},{"h":"Angles","d":"$\\pm\\left(\\pi-\\tfrac{\\pi}{6}\\right)$"}],"traps":[{"values":["pi/6","-pi/6"],"why":"cos x is negative."}],"criteria":[{"marks":1,"point":"cos x = −√3/2","line":"cos(x) = -sqrt(3)/2"},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-049","group":"A12-T3-049","dp":"T3.1d","authored":2,"level":2,"marks":1,"title":"Ferris wheel minimum time","prompt":"A Ferris wheel height is $h=12-10\\cos\\dfrac{\\pi t}{15}$ m. Find the first time after $t=0$ that $h=17$.","answerType":"numeric","answer":{"value":10},"answerPrefix":"t =","hints":["Smallest positive angle 2π/3."],"ladder":{"nudge":"Smallest positive angle 2π/3."},"steps":[{"h":"Solve","d":"$\\cos\\dfrac{\\pi t}{15}=-\\tfrac12\\Rightarrow\\dfrac{\\pi t}{15}=\\dfrac{2\\pi}{3}$"}],"traps":[{"value":5,"why":"cos is negative."}],"criteria":[{"marks":1,"point":"t = 10","answer":true}]},{"id":"A12-T3-050","group":"A12-T3-050","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Cosine double angle graph solutions","prompt":"Solve $\\cos2x=-\\tfrac12$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[1.0471975511965979,2.0943951023931957]},"answerPrefix":"x =","hints":["2x in [0, 2π].","cos = −½ in Q2 and Q3."],"ladder":{"nudge":"2x in [0, 2π].","method":"cos = −½ in Q2 and Q3."},"steps":[{"h":"Angles","d":"$2x=\\tfrac{2\\pi}{3},\\tfrac{4\\pi}{3}$"}],"traps":[{"values":["pi/3"],"why":"Second solution 2π/3."}],"criteria":[{"marks":1,"point":"2x values","manual":true},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-052","group":"A12-T3-052","dp":"T3.1c","authored":2,"level":2,"marks":1,"title":"Solutions of a sine equation in a wider domain","prompt":"Solve $\\sin x=-1$ for $-2\\pi\\le x\\le2\\pi$.","answerType":"set","answer":{"values":[-1.5707963267948966,4.71238898038469]},"answerPrefix":"x =","hints":["sin = −1 at 3π/2.","Subtract 2π."],"ladder":{"nudge":"sin = −1 at 3π/2.","method":"Subtract 2π."},"steps":[{"h":"Minimum","d":"$\\tfrac{3\\pi}{2}+2k\\pi$"}],"traps":[{"values":["3*pi/2"],"why":"Include the negative angle."}],"criteria":[{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-054","group":"A12-T3-054","dp":"T3.1c","authored":3,"level":3,"marks":1,"title":"Tangent inequality","prompt":"Solve $\\tan x\\ge1$ for $0\\le x<\\pi$, excluding where tangent is undefined.","answerType":"interval","answer":{"region":"pi/4 <= x < pi/2","variable":"x"},"hints":["Increases to the asymptote.","Negative in Q2."],"ladder":{"nudge":"Increases to the asymptote.","method":"Negative in Q2."},"steps":[{"h":"Read","d":"Increasing from $1$ at $\\tfrac{\\pi}{4}$ to the asymptote"}],"traps":[{"region":"pi/4 <= x < pi","why":"tan is negative after π/2."}],"criteria":[{"marks":1,"point":"Correct interval","answer":true}]},{"id":"A12-T3-056","group":"A12-T3-056","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Solving with a cosine graph and an intercept","prompt":"Solve $\\cos\\left(2x-\\tfrac{\\pi}{3}\\right)=0$ for $0\\le x\\le\\pi$.","answerType":"set","answer":{"values":[1.3089969389957472,2.879793265790644]},"answerPrefix":"x =","hints":["u = 2x − π/3 in [−π/3, 5π/3].","cos u = 0 at π/2, 3π/2."],"ladder":{"nudge":"u = 2x − π/3 in [−π/3, 5π/3].","method":"cos u = 0 at π/2, 3π/2."},"steps":[{"h":"Angle","d":"$2x-\\tfrac{\\pi}{3}=\\tfrac{\\pi}{2},\\tfrac{3\\pi}{2}$"}],"traps":[{"values":["5*pi/12"],"why":"Second solution 11π/12."}],"criteria":[{"marks":1,"point":"Angle values","manual":true},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-059","group":"A12-T3-059","dp":"T3.1c","authored":2,"level":2,"marks":2,"title":"Solve a cosine equation with a coefficient on x","prompt":"Solve $\\cos3x=\\tfrac{\\sqrt2}{2}$ for $0\\le x\\le\\tfrac{2\\pi}{3}$.","answerType":"set","answer":{"values":[0.26179938779914946,1.8325957145940461]},"answerPrefix":"x =","hints":["3x in [0, 2π].","cos = √2/2 in Q1 and Q4.","Divide by 3."],"ladder":{"nudge":"3x in [0, 2π].","method":"cos = √2/2 in Q1 and Q4.","worked":"Divide by 3."},"steps":[{"h":"Angles","d":"$3x=\\tfrac{\\pi}{4},\\tfrac{7\\pi}{4}$"}],"traps":[{"values":["pi/12"],"why":"3x ranges over [0, 2π]."}],"criteria":[{"marks":1,"point":"3x values","manual":true},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-T3-068","group":"A12-T3-068","dp":"T3.1a","authored":4,"level":4,"marks":1,"title":"Number of cycles and maxima count","prompt":"How many maximum points does $y=\\sin4x$ have for $0\\le x\\le2\\pi$?","answerType":"numeric","answer":{"value":4},"hints":["Period π/2."],"ladder":{"nudge":"Period π/2."},"steps":[{"h":"Cycles","d":"Period $\\tfrac{\\pi}{2}$, four cycles"}],"traps":[{"value":8,"why":"One maximum per cycle."}],"criteria":[{"marks":1,"point":"4","answer":true}]},{"id":"A12-T3-080","group":"A12-T3-080","dp":"T3.1c","authored":4,"level":4,"marks":2,"title":"Equation with a squared tangent in degrees","prompt":"Solve $\\tan^{2}2\\theta=1$ for $0^\\circ\\le\\theta\\le180^\\circ$.","answerType":"set","answer":{"values":[22.5,67.5,112.5,157.5]},"answerPrefix":"θ =","hints":["2θ in [0°, 360°]."],"ladder":{"nudge":"2θ in [0°, 360°]."},"steps":[{"h":"Root","d":"$\\tan2\\theta=\\pm1$"},{"h":"Angles","d":"$2\\theta=45^\\circ,135^\\circ,225^\\circ,315^\\circ$"}],"traps":[{"values":[22.5,112.5],"why":"Negative root too."}],"criteria":[{"marks":1,"point":"tan 2θ = ±1","manual":true},{"marks":1,"point":"All four","answer":true}]},{"id":"A12-T3-081","group":"A12-T3-081","dp":"T3.1c","authored":4,"level":4,"marks":2,"title":"Equation with a shifted cosine and two periods","prompt":"Solve $2\\cos\\left(x-\\tfrac{\\pi}{4}\\right)=\\sqrt2$ for $0\\le x\\le4\\pi$.","answerType":"set","answer":{"values":[0,1.5707963267948966,6.283185307179586,7.853981633974483,12.566370614359172]},"answerPrefix":"x =","hints":["cos u = √2/2.","u = ±π/4 + 2kπ.","Add π/4 and list."],"ladder":{"nudge":"cos u = √2/2.","method":"u = ±π/4 + 2kπ.","worked":"Add π/4 and list."},"steps":[{"h":"Basic","d":"$x-\\tfrac{\\pi}{4}=\\pm\\tfrac{\\pi}{4}+2k\\pi$"}],"traps":[{"values":[0,"pi/2","2*pi","5*pi/2"],"why":"4π also works."}],"criteria":[{"marks":1,"point":"General angles","manual":true},{"marks":1,"point":"All five","answer":true}]},{"id":"A12-T3-086","group":"A12-T3-086","dp":"T3.1d","authored":3,"level":3,"marks":2,"title":"Daylight model inequality","prompt":"Daylight hours are $L=12+2.5\\sin\\dfrac{2\\pi(t-80)}{365}$, $t$ the day number. For how many days of the year is $L>13.25$, to the nearest day?","answerType":"numeric","answer":{"value":122},"hints":["Set L > 13.25.","sin > ½ for a third of a period.","Times 365."],"ladder":{"nudge":"Set L > 13.25.","method":"sin > ½ for a third of a period.","worked":"Times 365."},"steps":[{"h":"Solve","d":"$\\sin u>\\tfrac12$ for $u\\in\\left(\\tfrac{\\pi}{6},\\tfrac{5\\pi}{6}\\right)$"},{"h":"Days","d":"$\\tfrac{2\\pi/3}{2\\pi}\\times365\\approx121.7$"}],"traps":[{"value":183,"why":"Only a third of the cycle."}],"criteria":[{"marks":1,"point":"Angle interval","manual":true},{"marks":1,"point":"122","answer":true}]},{"id":"A12-T3-088","group":"A12-T3-088","dp":"T3.1d","authored":3,"level":3,"marks":2,"title":"Pendulum angle crossing time","prompt":"A pendulum angle is $\\theta=0.3\\cos(2t)$ radians. Find the first two times it is at $\\theta=0.15$.","answerType":"set","answer":{"values":[0.5235987755982989,2.6179938779914944]},"answerPrefix":"t =","hints":["cos 2t = ½.","2t = π/3, 5π/3."],"ladder":{"nudge":"cos 2t = ½.","method":"2t = π/3, 5π/3."},"steps":[{"h":"Solve","d":"$\\cos2t=\\tfrac12\\Rightarrow2t=\\tfrac{\\pi}{3},\\tfrac{5\\pi}{3}$"}],"traps":[{"values":["pi/6"],"why":"Second time too."}],"criteria":[{"marks":1,"point":"2t values","manual":true},{"marks":1,"point":"Both","answer":true}]}]}
