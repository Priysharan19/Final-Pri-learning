arks":1,"point":"Area function","manual":true},{"marks":1,"point":"r ≈ 1.40","answer":true}],"diagram":{"alt":"Diagram for this question; the measurements are given in the question text.","w":99.9,"h":121.97,"sha256":"1f9aa5fde6cb03095be4dbe0fd5f2a8319fdd715c2193b2ee4b1758cb5f2f1d0","bytes":4056}},{"id":"A12-C3-095","group":"A12-C3-095","dp":"C3.1a","authored":3,"level":3,"marks":2,"title":"Turning point of a cosine and line sum from a graph","prompt":"The graph of $y=2\\cos x+x$ for $0\\le x\\le\\pi$ is shown. Find the exact maximum value.","answerType":"numeric","answer":{"value":2.2556495831671763},"hints":["sin x = ½.","Compare with endpoints."],"ladder":{"nudge":"sin x = ½.","method":"Compare with endpoints."},"steps":[{"h":"Stationary","d":"$1-2\\sin x=0\\Rightarrow x=\\tfrac{\\pi}{6}$"},{"h":"Value","d":"$2\\cdot\\tfrac{\\sqrt3}{2}+\\tfrac{\\pi}{6}$"}],"traps":[{"value":2,"why":"That is the value at x = 0."}],"criteria":[{"marks":1,"point":"x = π/6","line":"x = pi/6"},{"marks":1,"point":"Maximum","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 1 plotted line, curve or set of points is drawn. Labels shown: (pi over 6). Marked on the horizontal axis: (pi over 6); vertical axis: 2. Read the question for what it asks.","w":198.31,"h":131,"sha256":"2d26751b557d91f60422147d9a8631d179379c6d4635be730323215e8f7705af","bytes":7043}},{"id":"A12-C3-096","group":"A12-C3-096","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Minimum of a sum of a line and reciprocal on a graph","prompt":"The graph of $y=4x+\\dfrac{1}{x}$ for $x>0$ is shown. Find the minimum value.","answerType":"numeric","answer":{"value":4},"hints":[],"ladder":{},"steps":[{"h":"Stationary","d":"$4-\\tfrac{1}{x^{2}}=0$"},{"h":"Value","d":"$2+2$"}],"traps":[{"value":0.5,"why":"That is the x-value."}],"criteria":[{"marks":1,"point":"x = ½","line":"x = 1/2"},{"marks":1,"point":"4","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 1 plotted line, curve or set of points is drawn. Marked on the horizontal axis: 0.5; vertical axis: 4. Read the question for what it asks.","w":179.41,"h":126.32,"sha256":"9c6c2a3b9e036b510fcc6811f88704e22a663eaae5497760f3d58384f683270c","bytes":6749}},{"id":"A12-C3-117","group":"A12-C3-117","dp":"C3.2a","authored":4,"level":4,"marks":3,"title":"Largest rectangle under a parabola","prompt":"A rectangle has its base on the $x$-axis and upper corners on $y=12-x^{2}$, as shown. Find the maximum area.","answerType":"numeric","answer":{"value":32},"hints":["Width 2x, height 12 − x².","Check it is a max."],"ladder":{"nudge":"Width 2x, height 12 − x².","method":"Check it is a max."},"steps":[{"h":"Area","d":"$A=2x(12-x^{2})=24x-2x^{3}$"},{"h":"Derivative","d":"$A'=24-6x^{2}=0\\Rightarrow x=2$"},{"h":"Max","d":"$A=4\\times8$"}],"traps":[{"value":16,"why":"The width is 2x."}],"criteria":[{"marks":1,"point":"Area function","manual":true},{"marks":1,"point":"x = 2 with justification","manual":true},{"marks":1,"point":"32","answer":true}],"diagram":{"alt":"Graph drawn on x and y axes; 1 plotted line, curve or set of points is drawn. Marked on the horizontal axis: minus 2, 2; vertical axis: 8, 12. Read the question for what it asks.","w":165.91,"h":141.95,"sha256":"755574d7c4fe16b12e7e5175955b47843edeec5e9761a70f5b0634f7dbd949ac","bytes":7018}},{"id":"A12-C3-118","group":"A12-C3-118","dp":"C3.2a","authored":5,"level":4,"marks":4,"title":"Open box from a square sheet","prompt":"Squares of side $x$ cm are cut from the corners of a $12$ cm by $12$ cm sheet, and the sides folded up to make an open box. Find the maximum volume, justifying it is a maximum.","answerType":"numeric","answer":{"value":128},"hints":["Base side 12 − 2x.","Product rule.","Reject x = 6."],"ladder":{"nudge":"Base side 12 − 2x.","method":"Product rule.","worked":"Reject x = 6."},"steps":[{"h":"Volume","d":"$V=x(12-2x)^{2}$"},{"h":"Derivative","d":"$V'=(12-2x)(12-6x)$"},{"h":"Domain","d":"$0<x<6$ so $x=2$"},{"h":"Evaluate","d":"$2\\times64$"}],"traps":[{"value":0,"why":"x = 6 gives zero volume."}],"criteria":[{"marks":1,"point":"Volume","manual":true},{"marks":1,"point":"Derivative","manual":true},{"marks":1,"point":"x = 2 with justification","manual":true},{"marks":1,"point":"128","answer":true}]},{"id":"A12-C3-122","group":"A12-C3-122","dp":"C3.2a","authored":4,"level":4,"marks":3,"title":"Fencing along a river","prompt":"A rectangular paddock uses a river as one side and $400$ m of fencing for the other three. Find the maximum area.","answerType":"numeric","answer":{"value":20000},"hints":["x + 2y = 400.","Write A in y."],"ladder":{"nudge":"x + 2y = 400.","method":"Write A in y."},"steps":[{"h":"Area","d":"$A=y(400-2y)$"},{"h":"Derivative","d":"$400-4y=0$"},{"h":"Max","d":"$100\\times200$"}],"traps":[{"value":10000,"why":"The river side needs no fence."}],"criteria":[{"marks":1,"point":"Area function","manual":true},{"marks":1,"point":"y = 100","manual":true},{"marks":1,"point":"20 000","answer":true}],"diagram":{"alt":"Diagram. Labels shown: y, x. Read the question for what it asks.","w":169.97,"h":85.31,"sha256":"48ad50646cc68c52e5f52391f3253510dc386ddcb08354c27b92a2a4e5f4f92b","bytes":4267}},{"id":"A12-C3-151","group":"A12-C3-151","dp":"C3.1a","authored":4,"level":4,"marks":3,"title":"Turning points of a cubic with a parameter","prompt":"The curve $y=x^{3}-3kx$ ($k>0$) has a local minimum of $-16$. Find $k$.","answerType":"numeric","answer":{"value":4},"answerPrefix":"k =","hints":["y′ = 3x² − 3k.","Min at positive root."],"ladder":{"nudge":"y′ = 3x² − 3k.","method":"Min at positive root."},"steps":[{"h":"Stationary","d":"$x=\\pm\\sqrt k$"},{"h":"Minimum","d":"At $x=\\sqrt k$: $k\\sqrt k-3k\\sqrt k=-2k^{3/2}$"},{"h":"Solve","d":"$k^{3/2}=8$"}],"traps":[],"criteria":[{"marks":1,"point":"Stationary points","manual":true},{"marks":1,"point":"Min value","manual":true},{"marks":1,"point":"k = 4","answer":true}]},{"id":"A12-C3-E02","group":"A12-C3-E02","dp":"C3.1a","authored":6,"level":4,"marks":4,"title":"Lowest value of x to the power x","prompt":"Find the minimum value of $f(x)=x^{x}$ for $x>0$, justifying that it is a global minimum.","answerType":"expression","answer":{"expr":"exp(-exp(-1))"},"hints":["Write xˣ as a power of e.","Differentiate using the chain rule.","x^x > 0, so the sign of f′ is the sign of ln x + 1."],"ladder":{"nudge":"Write xˣ as a power of e.","method":"Differentiate using the chain rule.","worked":"x^x > 0, so the sign of f′ is the sign of ln x + 1."},"steps":[{"h":"Rewrite","d":"$f(x)=e^{x\\ln x}$"},{"h":"Derivative","d":"$f'(x)=x^{x}(\\ln x+1)=0\\Rightarrow x=\\tfrac1e$"},{"h":"Global","d":"$f'<0$ for $x<\\tfrac1e$ and $f'>0$ for $x>\\tfrac1e$"},{"h":"Value","d":"$f\\left(\\tfrac1e\\right)=e^{-1/e}$"}],"traps":[{"expr":"exp(-1)","why":"That is (1/e)¹, not (1/e)^{1/e}."}],"criteria":[{"marks":1,"point":"Writes e^{x ln x}","manual":true},{"marks":1,"point":"x = 1/e","manual":true},{"marks":1,"point":"Sign argument for global min","manual":true},{"marks":1,"point":"e^{−1/e}","answer":true}]}]}
