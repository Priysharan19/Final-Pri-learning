{"family":"qb-a12-ma-c3","course":"ADV","year":12,"topic":"MA-C3","questions":[{"id":"A12-C3-007","group":"A12-C3-007","dp":"C3.1b","authored":2,"level":2,"marks":2,"title":"Concave down interval","prompt":"For which values of $x$ is the curve $y=x^{4}-6x^{2}$ concave down?","answerType":"interval","answer":{"region":"-1 < x < 1","variable":"x"},"hints":["Concave down means y″ < 0."],"ladder":{"nudge":"Concave down means y″ < 0."},"steps":[{"h":"Second derivative","d":"$y''=12x^{2}-12<0\\Rightarrow x^{2}<1$"}],"traps":[{"region":"x < -1 or x > 1","why":"That is concave up."}],"criteria":[{"marks":1,"point":"y″ = 12x² − 12","line":"12*x^2-12"},{"marks":1,"point":"Correct interval","answer":true}]},{"id":"A12-C3-029","group":"A12-C3-029","dp":"C3.1b","authored":2,"level":2,"marks":2,"title":"Concave up regions of a quartic","prompt":"Find the values of $x$ for which $y=x^{4}-6x^{2}$ is concave up.","answerType":"interval","answer":{"region":"x < -1 or x > 1","variable":"x"},"hints":["Concave up means y″ > 0."],"ladder":{"nudge":"Concave up means y″ > 0."},"steps":[{"h":"Second derivative","d":"$y''=12x^{2}-12>0$"},{"h":"Solve","d":"$x^{2}>1$"}],"traps":[{"region":"-1 < x < 1","why":"That is concave down."}],"criteria":[{"marks":1,"point":"y″ = 12x² − 12","line":"12*x^2-12"},{"marks":1,"point":"Correct region","answer":true}]},{"id":"A12-C3-030","group":"A12-C3-030","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Open box with least surface area","prompt":"An open box with a square base of side $x$ cm has volume $32\\text{ cm}^3$. Show that its surface area is $S=x^{2}+\\dfrac{128}{x}$ and find the minimum surface area.","answerType":"numeric","answer":{"value":48},"hints":["Open means no top face.","Check it is a minimum."],"ladder":{"nudge":"Open means no top face.","method":"Check it is a minimum."},"steps":[{"h":"Height","d":"$h=\\tfrac{32}{x^{2}}$; $S=x^{2}+4xh=x^{2}+\\tfrac{128}{x}$"},{"h":"Minimise","d":"$S'=2x-\\tfrac{128}{x^{2}}=0\\Rightarrow x=4$"},{"h":"Value","d":"$16+32=48$; $S''>0$"}],"traps":[{"value":64,"why":"Included a lid."}],"criteria":[{"marks":1,"point":"Shows S","manual":true},{"marks":1,"point":"x = 4","line":"x = 4"},{"marks":1,"point":"48 cm²","answer":true}],"stepcheck":{"kind":"equation","variable":"x","solutions":[4]}},{"id":"A12-C3-031","group":"A12-C3-031","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Closest point on a root curve","prompt":"Find the point on $y=\\sqrt x$ that is closest to $(3,0)$.","answerType":"point","answer":{"x":2.5,"y":1.5811388300841898},"hints":["Minimise D² instead of D.","y² = x."],"ladder":{"nudge":"Minimise D² instead of D.","method":"y² = x."},"steps":[{"h":"Square distance","d":"$D^{2}=(x-3)^{2}+x$"},{"h":"Minimise","d":"$2(x-3)+1=0\\Rightarrow x=\\tfrac52$"},{"h":"Point","d":"$\\left(\\tfrac52,\\sqrt{\\tfrac52}\\right)$"}],"traps":[{"point":[3,"sqrt(3)"],"why":"That is directly above (3, 0), not closest."}],"criteria":[{"marks":1,"point":"D² = (x − 3)² + x","line":"D^2 = (x-3)^2+x"},{"marks":1,"point":"x = 5/2","line":"x = 5/2"},{"marks":1,"point":"Correct point","answer":true}]},{"id":"A12-C3-032","group":"A12-C3-032","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Lowest point of x ln x","prompt":"Find the minimum turning point of $y=x\\ln x$ for $x>0$.","answerType":"point","answer":{"x":0.36787944117144233,"y":-0.36787944117144233},"hints":["Solve ln x = −1."],"ladder":{"nudge":"Solve ln x = −1."},"steps":[{"h":"Derivative","d":"$y'=\\ln x+1=0\\Rightarrow x=\\tfrac1e$"},{"h":"Value","d":"$\\tfrac1e\\ln\\tfrac1e=-\\tfrac1e$; $y''=\\tfrac1x>0$"}],"traps":[{"point":["exp(-1)","exp(-1)"],"why":"ln(1/e) = −1."}],"criteria":[{"marks":1,"point":"x = 1/e","line":"x = 1/e"},{"marks":1,"point":"Correct point","answer":true}]},{"id":"A12-C3-034","group":"A12-C3-034","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Fencing beside a river","prompt":"A rectangular field of area $800\\text{ m}^2$ has one side along a straight river, which needs no fence. Find the least length of fencing needed.","answerType":"numeric","answer":{"value":80},"hints":["Only three sides need fencing.","Write F in one variable."],"ladder":{"nudge":"Only three sides need fencing.","method":"Write F in one variable."},"steps":[{"h":"Length","d":"Sides $x$, $x$ and $\\tfrac{800}{x}$: $F=2x+\\tfrac{800}{x}$"},{"h":"Minimise","d":"$F'=2-\\tfrac{800}{x^{2}}=0\\Rightarrow x=20$"},{"h":"Value","d":"$40+40=80$"}],"traps":[{"value":113.14,"why":"Fenced all four sides."}],"criteria":[{"marks":1,"point":"F = 2x + 800/x","manual":true},{"marks":1,"point":"x = 20","line":"x = 20"},{"marks":1,"point":"80 m","answer":true}],"stepcheck":{"kind":"equation","variable":"x","solutions":[20],"rejected":[-20]}},{"id":"A12-C3-036","group":"A12-C3-036","dp":"C3.1b","authored":2,"level":2,"marks":2,"title":"Point of inflection","prompt":"Find the point of inflection of $y=x^{3}-3x^{2}+2$.","answerType":"point","answer":{"x":1,"y":0},"hints":["Check the concavity changes."],"ladder":{"nudge":"Check the concavity changes."},"steps":[{"h":"Second derivative","d":"$y''=6x-6=0\\Rightarrow x=1$, sign changes"},{"h":"Point","d":"$y=1-3+2=0$"}],"traps":[{"point":[0,2],"why":"That is a stationary point (y′ = 0)."}],"criteria":[{"marks":1,"point":"x = 1 with sign change","line":"x = 1"},{"marks":1,"point":"(1, 0)","answer":true}]},{"id":"A12-C3-040","group":"A12-C3-040","dp":"C3.2a","authored":2,"level":2,"marks":2,"title":"Cheapest batch size","prompt":"The average cost per item is $C(x)=x+\\dfrac{100}{x}$ dollars for $x>0$. Find the minimum average cost.","answerType":"numeric","answer":{"value":20},"hints":["Solve C′ = 0."],"ladder":{"nudge":"Solve C′ = 0."},"steps":[{"h":"Derivative","d":"$C'=1-\\tfrac{100}{x^{2}}=0\\Rightarrow x=10$"},{"h":"Value","d":"$C(10)=20$; $C''>0$"}],"traps":[{"value":10,"why":"Gave x, not C."}],"criteria":[{"marks":1,"point":"x = 10","line":"x = 10"},{"marks":1,"point":"20 dollars","answer":true}]},{"id":"A12-C3-044","group":"A12-C3-044","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Least velocity","prompt":"A particle has displacement $x=t^{3}-6t^{2}$. Find its least velocity for $t\\ge0$.","answerType":"numeric","answer":{"value":-12},"hints":["Differentiate x for v.","Substitute t = 2 into v."],"ladder":{"nudge":"Differentiate x for v.","method":"Substitute t = 2 into v."},"steps":[{"h":"Velocity","d":"$v=3t^{2}-12t$"},{"h":"Minimum","d":"$v'=6t-12=0\\Rightarrow t=2$, $v=-12$"}],"traps":[{"value":-16,"why":"Gave the displacement at t = 2."}],"criteria":[{"marks":1,"point":"t = 2","line":"t = 2"},{"marks":1,"point":"−12","answer":true}]},{"id":"A12-C3-045","group":"A12-C3-045","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Maximum on a closed interval","prompt":"Find the maximum value of $f(x)=xe^{-x}$ on $0\\le x\\le3$.","answerType":"expression","answer":{"expr":"exp(-1)"},"hints":[],"ladder":{},"steps":[{"h":"Stationary","d":"$f'=(1-x)e^{-x}=0\\Rightarrow x=1$"},{"h":"Compare","d":"$f(0)=0$, $f(1)=e^{-1}$, $f(3)=3e^{-3}\\approx0.15$"}],"traps":[{"expr":"3*exp(-3)","why":"Took the right endpoint."}],"criteria":[{"marks":1,"point":"Compares endpoints","manual":true},{"marks":1,"point":"1/e","answer":true}]},{"id":"A12-C3-046","group":"A12-C3-046","dp":"C3.1a","authored":3,"level":3,"marks":2,"title":"A cubic with no turning points","prompt":"Find the values of $k$ for which $y=x^{3}+kx^{2}+3x$ has no stationary points.","answerType":"interval","answer":{"region":"-3 < k < 3","variable":"k"},"hints":["Stationary points need y′ = 0.","No real roots means Δ < 0."],"ladder":{"nudge":"Stationary points need y′ = 0.","method":"No real roots means Δ < 0."},"steps":[{"h":"Derivative","d":"$y'=3x^{2}+2kx+3$"},{"h":"No roots","d":"$4k^{2}-36<0$"}],"traps":[{"region":"k < -3 or k > 3","why":"That gives two stationary points."}],"criteria":[{"marks":1,"point":"Δ < 0","line":"4*k^2-36 < 0"},{"marks":1,"point":"−3 < k < 3","answer":true}]},{"id":"A12-C3-047","group":"A12-C3-047","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Turning point of x times an exponential","prompt":"Find the stationary point of $y=xe^{2x}$.","answerType":"point","answer":{"x":-0.5,"y":-0.18393972058572117},"hints":["e^{2x} ≠ 0."],"ladder":{"nudge":"e^{2x} ≠ 0."},"steps":[{"h":"Derivative","d":"$e^{2x}(1+2x)=0\\Rightarrow x=-\\tfrac12$"},{"h":"Value","d":"$-\\tfrac12e^{-1}$"}],"traps":[{"point":["-1/2","-exp(-1)"],"why":"Forgot the ½ in front."}],"criteria":[{"marks":1,"point":"x = −½","line":"x = -1/2"},{"marks":1,"point":"Correct point","answer":true}]},{"id":"A12-C3-048","group":"A12-C3-048","dp":"C3.1b","authored":3,"level":3,"marks":3,"title":"Where a bell curve bends down","prompt":"Find where $y=e^{-x^{2}}$ is concave down.","answerType":"interval","answer":{"region":"-sqrt(2)/2 < x < sqrt(2)/2","variable":"x"},"hints":["Product rule for y″.","e^{−x²} > 0.","Solve the quadratic inequality."],"ladder":{"nudge":"Product rule for y″.","method":"e^{−x²} > 0.","worked":"Solve the quadratic inequality."},"steps":[{"h":"First","d":"$y'=-2xe^{-x^{2}}$"},{"h":"Second","d":"$y''=(4x^{2}-2)e^{-x^{2}}$"},{"h":"Solve","d":"$4x^{2}-2<0$"}],"traps":[{"region":"x < -sqrt(2)/2 or x > sqrt(2)/2","why":"That is concave up."}],"criteria":[{"marks":1,"point":"Correct y″","line":"(4*x^2-2)*exp(-x^2)"},{"marks":1,"point":"4x² − 2 < 0","manual":true},{"marks":1,"point":"Correct interval","answer":true}]},{"id":"A12-C3-049","group":"A12-C3-049","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Box from a square sheet","prompt":"Squares of side $x$ cm are cut from the corners of a $20$ cm square sheet, and the sides folded up to make an open box. Find the maximum volume.","answerType":"numeric","answer":{"value":592.5925925925926},"hints":["Base side 20 − 2x.","Reject x = 10."],"ladder":{"nudge":"Base side 20 − 2x.","method":"Reject x = 10."},"steps":[{"h":"Volume","d":"$V=x(20-2x)^{2}$"},{"h":"Derivative","d":"$V'=(20-2x)(20-6x)=0\\Rightarrow x=\\tfrac{10}{3}$"},{"h":"Value","d":"$\\tfrac{10}{3}\\left(\\tfrac{40}{3}\\right)^{2}=\\tfrac{16000}{27}$"}],"traps":[{"value":0,"why":"x = 10 gives no box."}],"criteria":[{"marks":1,"point":"V = x(20 − 2x)²","manual":true},{"marks":1,"point":"x = 10/3","line":"x = 10/3"},{"marks":1,"point":"16000/27","answer":true}],"stepcheck":{"kind":"equation","variable":"x","solutions":[3.3333333333333335],"rejected":[10]}},{"id":"A12-C3-050","group":"A12-C3-050","dp":"C3.1a","authored":3,"level":3,"marks":3,"title":"Product of one number and the square of another","prompt":"Two positive numbers have sum $20$. Find the greatest value of the product of the first and the square of the second.","answerType":"numeric","answer":{"value":1185.1851851851852},"hints":["Write the first as 20 − y.","Check it is a maximum."],"ladder":{"nudge":"Write the first as 20 − y.","method":"Check it is a maximum."},"steps":[{"h":"Product","d":"$P=(20-y)y^{2}$"},{"h":"Derivative","d":"$P'=40y-3y^{2}=0\\Rightarrow y=\\tfrac{40}{3}$"},{"h":"Value","d":"$\\tfrac{20}{3}\\cdot\\tfrac{1600}{9}$"}],"traps":[{"value":1000,"why":"Took y = 10."}],"criteria":[{"marks":1,"point":"P = (20 − y)y²","manual":true},{"marks":1,"point":"y = 40/3","line":"y = 40/3"},{"marks":1,"point":"32000/27","answer":true}]},{"id":"A12-C3-052","group":"A12-C3-052","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Closest point on a line","prompt":"Use calculus to find the shortest distance from the origin to the line $x+2y=10$.","answerType":"numeric","answer":{"value":4.47213595499958},"hints":["Express y in x.","Point (2, 4)."],"ladder":{"nudge":"Express y in x.","method":"Point (2, 4)."},"steps":[{"h":"Square distance","d":"$D^{2}=x^{2}+\\left(\\tfrac{10-x}{2}\\right)^{2}$"},{"h":"Minimise","d":"$2x-\\tfrac{10-x}{2}=0\\Rightarrow x=2$"},{"h":"Distance","d":"$\\sqrt{4+16}$"}],"traps":[{"value":10,"why":"That is the x-intercept."}],"criteria":[{"marks":1,"point":"D² in one variable","manual":true},{"marks":1,"point":"x = 2","line":"x = 2"},{"marks":1,"point":"2√5","answer":true}]},{"id":"A12-C3-053","group":"A12-C3-053","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Cheapest open cylinder","prompt":"An open cylindrical tank (no lid) must hold $1000\\text{ cm}^3$. Find the radius that minimises its surface area, to two decimal places.","answerType":"numeric","answer":{"value":6.83,"tol":0.005},"hints":["Only one circular end.","Use the volume to remove h."],"ladder":{"nudge":"Only one circular end.","method":"Use the volume to remove h."},"steps":[{"h":"Area","d":"$S=\\pi r^{2}+\\dfrac{2000}{r}$"},{"h":"Derivative","d":"$2\\pi r-\\dfrac{2000}{r^{2}}=0\\Rightarrow r^{3}=\\dfrac{1000}{\\pi}$"},{"h":"Value","d":"$r\\approx6.83$"}],"traps":[{"value":5.42,"why":"Included a lid."}],"criteria":[{"marks":1,"point":"S in r","manual":true},{"marks":1,"point":"r³ = 1000/π","line":"r^3 = 1000/pi"},{"marks":1,"point":"6.83 cm","answer":true}]},{"id":"A12-C3-054","group":"A12-C3-054","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Minimum on a closed interval","prompt":"Find the least value of $f(x)=x+\\dfrac1x$ for $\\tfrac12\\le x\\le3$.","answerType":"numeric","answer":{"value":2},"hints":[],"ladder":{},"steps":[{"h":"Stationary","d":"$1-\\tfrac{1}{x^{2}}=0\\Rightarrow x=1$"},{"h":"Compare","d":"$f(\\tfrac12)=2.5$, $f(1)=2$, $f(3)=\\tfrac{10}{3}$"}],"traps":[{"value":2.5,"why":"That is an endpoint value."}],"criteria":[{"marks":1,"point":"Checks endpoints","manual":true},{"marks":1,"point":"2","answer":true}]},{"id":"A12-C3-056","group":"A12-C3-056","dp":"C3.1b","authored":2,"level":2,"marks":2,"title":"Inflection of a wave plus a line","prompt":"Find the point of inflection of $y=\\sin x+\\dfrac x2$ for $0<x<2\\pi$.","answerType":"point","answer":{"x":3.141592653589793,"y":1.5707963267948966},"hints":["Solve y″ = 0."],"ladder":{"nudge":"Solve y″ = 0."},"steps":[{"h":"Second derivative","d":"$y''=-\\sin x=0\\Rightarrow x=\\pi$, sign changes"},{"h":"Point","d":"$y=0+\\tfrac{\\pi}{2}$"}],"traps":[{"point":["pi/2","1+pi/4"],"why":"Solved y′ = 0 instead."}],"criteria":[{"marks":1,"point":"x = π with sign change","line":"x = pi"},{"marks":1,"point":"(π, π/2)","answer":true}]},{"id":"A12-C3-058","group":"A12-C3-058","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Minimum of a sum of exponentials","prompt":"Find the minimum value of $y=e^{x}+e^{-x}$.","answerType":"numeric","answer":{"value":2},"hints":["eˣ = e^{−x} means x = 0."],"ladder":{"nudge":"eˣ = e^{−x} means x = 0."},"steps":[{"h":"Stationary","d":"$e^{x}-e^{-x}=0\\Rightarrow x=0$"},{"h":"Value","d":"$y(0)=2$, $y''>0$"}],"traps":[{"value":0,"why":"That is the x-value."}],"criteria":[{"marks":1,"point":"x = 0","line":"x = 0"},{"marks":1,"point":"2","answer":true}]},{"id":"A12-C3-060","group":"A12-C3-060","dp":"C3.1b","authored":1,"level":1,"marks":1,"title":"Where a cubic bends upwards","prompt":"Find where $y=x^{3}-6x^{2}+9x+1$ is concave up.","answerType":"interval","answer":{"region":"x > 2","variable":"x"},"hints":["Concave up means y″ > 0."],"ladder":{"nudge":"Concave up means y″ > 0."},"steps":[{"h":"Second derivative","d":"$6x-12>0$"}],"traps":[{"region":"x < 2","why":"That is concave down."}],"criteria":[{"marks":1,"point":"x > 2","answer":true}]},{"id":"A12-C3-064","group":"A12-C3-064","dp":"C3.1b","authored":2,"level":2,"marks":1,"title":"Placing an inflection","prompt":"The curve $y=x^{3}+ax^{2}+5$ has a point of inflection at $x=2$. Find $a$.","answerType":"numeric","answer":{"value":-6},"answerPrefix":"a =","hints":["y″ = 6x + 2a.","Set y″(2) = 0."],"ladder":{"nudge":"y″ = 6x + 2a.","method":"Set y″(2) = 0."},"steps":[{"h":"Second derivative","d":"$6x+2a=0$ at $x=2$"}],"traps":[{"value":-3,"why":"y″ = 6x + 2a, not 6x + a."}],"criteria":[{"marks":1,"point":"a = −6","answer":true}]},{"id":"A12-C3-069","group":"A12-C3-069","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Stationary point of x minus log x","prompt":"Find the minimum value of $y=x-\\ln x$ for $x>0$.","answerType":"numeric","answer":{"value":1},