< k < 3","answer":true}]},{"id":"A12-C3-047","group":"A12-C3-047","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Turning point of x times an exponential","prompt":"Find the stationary point of $y=xe^{2x}$.","answerType":"point","answer":{"x":-0.5,"y":-0.18393972058572117},"hints":["Product rule.","e^{2x} ≠ 0.","Substitute back."],"ladder":{"nudge":"Product rule.","method":"e^{2x} ≠ 0.","worked":"Substitute back."},"steps":[{"h":"Derivative","d":"$e^{2x}(1+2x)=0\\Rightarrow x=-\\tfrac12$"},{"h":"Value","d":"$-\\tfrac12e^{-1}$"}],"traps":[{"point":["-1/2","-exp(-1)"],"why":"Forgot the ½ in front."}],"criteria":[{"marks":1,"point":"x = −½","line":"x = -1/2"},{"marks":1,"point":"Correct point","answer":true}]},{"id":"A12-C3-048","group":"A12-C3-048","dp":"C3.1b","authored":3,"level":3,"marks":3,"title":"Where a bell curve bends down","prompt":"Find where $y=e^{-x^{2}}$ is concave down.","answerType":"interval","answer":{"region":"-sqrt(2)/2 < x < sqrt(2)/2","variable":"x"},"hints":["Product rule for y″.","e^{−x²} > 0.","Solve the quadratic inequality."],"ladder":{"nudge":"Product rule for y″.","method":"e^{−x²} > 0.","worked":"Solve the quadratic inequality."},"steps":[{"h":"First","d":"$y'=-2xe^{-x^{2}}$"},{"h":"Second","d":"$y''=(4x^{2}-2)e^{-x^{2}}$"},{"h":"Solve","d":"$4x^{2}-2<0$"}],"traps":[{"region":"x < -sqrt(2)/2 or x > sqrt(2)/2","why":"That is concave up."}],"criteria":[{"marks":1,"point":"Correct y″","line":"(4*x^2-2)*exp(-x^2)"},{"marks":1,"point":"4x² − 2 < 0","manual":true},{"marks":1,"point":"Correct interval","answer":true}]},{"id":"A12-C3-049","group":"A12-C3-049","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Box from a square sheet","prompt":"Squares of side $x$ cm are cut from the corners of a $20$ cm square sheet, and the sides folded up to make an open box. Find the maximum volume.","answerType":"numeric","answer":{"value":592.5925925925926},"hints":["Base side 20 − 2x.","Reject x = 10."],"ladder":{"nudge":"Base side 20 − 2x.","method":"Reject x = 10."},"steps":[{"h":"Volume","d":"$V=x(20-2x)^{2}$"},{"h":"Derivative","d":"$V'=(20-2x)(20-6x)=0\\Rightarrow x=\\tfrac{10}{3}$"},{"h":"Value","d":"$\\tfrac{10}{3}\\left(\\tfrac{40}{3}\\right)^{2}=\\tfrac{16000}{27}$"}],"traps":[{"value":0,"why":"x = 10 gives no box."}],"criteria":[{"marks":1,"point":"V = x(20 − 2x)²","manual":true},{"marks":1,"point":"x = 10/3","line":"x = 10/3"},{"marks":1,"point":"16000/27","answer":true}],"stepcheck":{"kind":"equation","variable":"x","solutions":[3.3333333333333335],"rejected":[10]}},{"id":"A12-C3-050","group":"A12-C3-050","dp":"C3.1a","authored":3,"level":3,"marks":3,"title":"Product of one number and the square of another","prompt":"Two positive numbers have sum $20$. Find the greatest value of the product of the first and the square of the second.","answerType":"numeric","answer":{"value":1185.1851851851852},"hints":["Write the first as 20 − y.","Check it is a maximum."],"ladder":{"nudge":"Write the first as 20 − y.","method":"Check it is a maximum."},"steps":[{"h":"Product","d":"$P=(20-y)y^{2}$"},{"h":"Derivative","d":"$P'=40y-3y^{2}=0\\Rightarrow y=\\tfrac{40}{3}$"},{"h":"Value","d":"$\\tfrac{20}{3}\\cdot\\tfrac{1600}{9}$"}],"traps":[{"value":1000,"why":"Took y = 10."}],"criteria":[{"marks":1,"point":"P = (20 − y)y²","manual":true},{"marks":1,"point":"y = 40/3","line":"y = 40/3"},{"marks":1,"point":"32000/27","answer":true}]},{"id":"A12-C3-052","group":"A12-C3-052","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Closest point on a line","prompt":"Use calculus to find the shortest distance from the origin to the line $x+2y=10$.","answerType":"numeric","answer":{"value":4.47213595499958},"hints":["Express y in x.","Minimise D².","Point (2, 4)."],"ladder":{"nudge":"Express y in x.","method":"Minimise D².","worked":"Point (2, 4)."},"steps":[{"h":"Square distance","d":"$D^{2}=x^{2}+\\left(\\tfrac{10-x}{2}\\right)^{2}$"},{"h":"Minimise","d":"$2x-\\tfrac{10-x}{2}=0\\Rightarrow x=2$"},{"h":"Distance","d":"$\\