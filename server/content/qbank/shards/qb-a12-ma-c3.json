589793,"y":1.5707963267948966},"hints":["Differentiate twice.","Solve y″ = 0.","Check concavity changes."],"ladder":{"nudge":"Differentiate twice.","method":"Solve y″ = 0.","worked":"Check concavity changes."},"steps":[{"h":"Second derivative","d":"$y''=-\\sin x=0\\Rightarrow x=\\pi$, sign changes"},{"h":"Point","d":"$y=0+\\tfrac{\\pi}{2}$"}],"traps":[{"point":["pi/2","1+pi/4"],"why":"Solved y′ = 0 instead."}],"criteria":[{"marks":1,"point":"x = π with sign change","line":"x = pi"},{"marks":1,"point":"(π, π/2)","answer":true}]},{"id":"A12-C3-058","group":"A12-C3-058","dp":"C3.1a","authored":2,"level":2,"marks":2,"title":"Minimum of a sum of exponentials","prompt":"Find the minimum value of $y=e^{x}+e^{-x}$.","answerType":"numeric","answer":{"value":2},"hints":["eˣ = e^{−x} means x = 0."],"ladder":{"nudge":"eˣ = e^{−x} means x = 0."},"steps":[{"h":"Stationary","d":"$e^{x}-e^{-x}=0\\Rightarrow x=0$"},{"h":"Value","d":"$y(0)=2$, $y''>0$"}],"traps":[{"value":0,"why":"That is the x-value."}],"criteria":[{"marks":1,"point":"x = 0","line":"x = 0"},{"marks":1,"point":"2","answer":true}]},{"id":"A12-C3-059","group":"A12-C3-059","dp":"C3.2a","authored":3,"level":3,"marks":3,"title":"Rectangle in a semicircle","prompt":"A rectangle is inscribed in a semicircle of radius $5$ with one side on the diameter, as shown. Find its maximum area.","answerType":"numeric","answer":{"value":25},"hints":["Maximise A²."],"ladder":{"nudge":"Maximise A²."},"steps":[{"h":"Area","d":"$A=2x\\sqrt{25-x^{2}}$"},{"h":"Maximise","d":"$A^{2}=4x^{2}(25-x^{2})$ is largest at $x^{2}=\\tfrac{25}{2}$"},{"h":"Value","d":"$2\\cdot\\tfrac{5}{\\sqrt2}\\cdot\\tfrac{5}{\\sqrt2}$"}],"traps":[{"value":50,"why":"That is the full circle case."}],"criteria":[{"marks":1,"point":"Area function","manual":true},{"marks":1,"point":"x² = 25/2","line":"x^2 = 25/2"},{"marks":1,"point":"25","answer":true}],"diagram":{"alt":"Diagram for this question; the measurements are given in the question text.","w":170.61,"h":100.99,"sha