{"family":"qb-a12-ma-f2","course":"ADV","year":12,"topic":"MA-F2","questions":[{"id":"A12-F2-003","group":"A12-F2-003","dp":"F2.1d","authored":3,"level":3,"marks":2,"title":"Order matters inside the bracket","prompt":"The point $(4,1)$ lies on $y=f(x)$. Describe the transformations that map $y=f(x)$ onto $y=f(2x+6)$, in order, and find the image of $(4,1)$.","answerType":"point","answer":{"x":-1,"y":1},"hints":["Factor 2 out of 2x + 6.","Solve 2x + 6 = 4 for the new x.","y is unchanged."],"ladder":{"nudge":"Factor 2 out of 2x + 6.","method":"Solve 2x + 6 = 4 for the new x.","worked":"$f(2x+6)=f(2(x+3))$: dilate by $\\tfrac12$ horizontally, then shift left 3."},"steps":[{"h":"Factorise inside","d":"$f(2x+6)=f(2(x+3))$: dilate by $\\tfrac12$ horizontally, then shift left 3."},{"h":"Image","d":"$4\\mapsto2\\mapsto-1$, so $(-1,1)$"}],"traps":[{"point":[-4,1],"why":"Shifted left 6 before halving; factorise as 2(x + 3) first."}],"criteria":[{"marks":1,"point":"Correct order of transformations","manual":true},{"marks":1,"point":"Image (−1, 1)","answer":true}]},{"id":"A12-F2-008","group":"A12-F2-008","dp":"F2.1a","authored":3,"level":3,"marks":2,"title":"Tracking a single point","prompt":"The point $(2,5)$ lies on $y=f(x)$. Find a point that must lie on $y=3-f(4-x)$.","answerType":"point","answer":{"x":2,"y":-2},"hints":["Then evaluate 3 − f(2).","f(2) = 5."],"ladder":{"nudge":"Match the input","method":"Then evaluate 3 − f(2).","worked":"f(2) = 5."},"steps":[{"h":"Match the input","d":"$4-x=2\\Rightarrow x=2$"},{"h":"Output","d":"$y=3-f(2)=3-5=-2$"}],"traps":[{"point":[2,8],"why":"Added f(2) instead of subtracting it."}],"criteria":[{"marks":1,"point":"x = 2","line":"x = 2"},{"marks":1,"point":"Point (2, −2)","answer":true}]},{"id":"A12-F2-013","group":"A12-F2-013","dp":"F2.1a","authored":3,"level":3,"marks":2,"title":"Moving the roots","prompt":"The equation $f(x)=0$ has roots $-3$, $1$ and $4$ only. Find the roots of $f(2x-2)=0$.","answerType":"set","answer":{"values":[-0.5,1.5,3]},"answerPrefix":"x =","hints":["f(2x − 2) = 0 when 2x − 2 is a root of f.","Solve three linear equations.","Check one answer."],"ladder":{"nudge":"f(2x − 2) = 0 when 2x − 2 is a root of f.","method":"Solve three linear equations.","worked":"Check one answer."},"steps":[{"h":"Solve 2x − 2 = root","d":"$2x-2\\in\\{-3,1,4\\}\\Rightarrow x=-\\tfrac12,\\tfrac32,3$"}],"traps":[{"values":[-2.5,0.5,2],"why":"Halved then subtracted 1 in the wrong order."}],"criteria":[{"marks":1,"point":"Sets 2x − 2 equal to each root","line":"2*x-2 = -3"},{"marks":1,"point":"All three roots","answer":true}]},{"id":"A12-F2-017","group":"A12-F2-017","dp":"F2.1d","authored":2,"level":2,"marks":2,"title":"Following a point","prompt":"The point $(2,5)$ lies on $y=f(x)$. Find its image on $y=2f(x-1)+3$.","answerType":"point","answer":{"x":3,"y":13},"hints":["Choose x so that x − 1 = 2.","Double then add 3.","Order matters for y."],"ladder":{"nudge":"Choose x so that x − 1 = 2.","method":"Double then add 3.","worked":"Order matters for y."},"steps":[{"h":"Input","d":"$x-1=2\\Rightarrow x=3$"},{"h":"Output","d":"$2(5)+3=13$"}],"traps":[{"point":[1,13],"why":"x − 1 shifts right, not left."}],"criteria":[{"marks":1,"point":"x = 3","line":"x = 3"},{"marks":1,"point":"(3, 13)","answer":true}]},{"id":"A12-F2-022","group":"A12-F2-022","dp":"F2.1d","authored":2,"level":2,"marks":3,"title":"A transformed reciprocal","prompt":"The graph of $y=\\dfrac1x$ is transformed to $y=\\dfrac{2}{x-3}+1$. State the asymptotes and find the image of the point $(1,1)$.","answerType":"point","answer":{"x":4,"y":3},"hints":["Find where the denominator is zero.","Shift right 3.","Double the height and add 1."],"ladder":{"nudge":"Find where the denominator is zero.","method":"Shift right 3.","worked":"Double the height and add 1."},"steps":[{"h":"Asymptotes","d":"$x=3$, $y=1$"},{"h":"Image","d":"$x=1+3=4$, $y=2(1)+1=3$"}],"traps":[{"point":[-2,3],"why":"x − 3 shifts right 3."}],"criteria":[{"marks":1,"point":"Asymptotes","manual":true},{"marks":1,"point":"x-coordinate 4","line":"x = 4"},{"marks":1,"point":"(4, 3)","answer":true}]},{"id":"A12-F2-023","group":"A12-F2-023","dp":"F2.1a","authored":2,"level":2,"marks":2,"title":"Parabola from its vertex","prompt":"A parabola has vertex $(2,-3)$ and passes through $(0,5)$. Find its equation in the form $y=a(x-h)^{2}+k$.","answerType":"numeric","answer":{"value":2},"answerPrefix":"a =","hints":["Write the vertex form.","Substitute (0, 5).","Solve for a."],"ladder":{"nudge":"Write the vertex form.","method":"Substitute (0, 5).","worked":"$y=a(x-2)^{2}-3$"},"steps":[{"h":"Form","d":"$y=a(x-2)^{2}-3$"},{"h":"Point","d":"$5=4a-3\\Rightarrow a=2$"}],"traps":[{"value":0.5,"why":"Divided the wrong way: 4a = 8."}],"criteria":[{"marks":1,"point":"Uses vertex form","line":"y = a*(x-2)^2-3"},{"marks":1,"point":"a = 2","answer":true}]},{"id":"A12-F2-024","group":"A12-F2-024","dp":"F2.1b","authored":1,"level":1,"marks":1,"title":"Root after a horizontal dilation","prompt":"The graph of $y=f(x)$ cuts the $x$-axis only at $x=6$. Where does $y=f(3x)$ cut the $x$-axis?","answerType":"numeric","answer":{"value":2},"answerPrefix":"x =","hints":["f(3x) = 0 when 3x = 6.","Solve.","Horizontal dilation by ⅓."],"ladder":{"nudge":"f(3x) = 0 when 3x = 6.","method":"Solve.","worked":"Horizontal dilation by ⅓."},"steps":[{"h":"Solve","d":"$3x=6\\Rightarrow x=2$"}],"traps":[{"value":18,"why":"f(3x) compresses towards the y-axis."}],"criteria":[{"marks":1,"point":"x = 2","answer":true}]},{"id":"A12-F2-026","group":"A12-F2-026","dp":"F2.1a","authored":2,"level":2,"marks":2,"title":"Difference of shifted squares","prompt":"Let $f(x)=x^{2}$. Simplify $f(x+2)-f(x)$ and describe its graph.","answerType":"expression","answer":{"expr":"4*x+4"},"hints":["Write f(x + 2) = (x + 2)².","Expand.","The x² terms cancel."],"ladder":{"nudge":"Write f(x + 2) = (x + 2)².","method":"Expand.","worked":"The x² terms cancel."},"steps":[{"h":"Expand","d":"$(x+2)^{2}-x^{2}=4x+4$"}],"traps":[{"expr":"4","why":"(x + 2)² is not x² + 4."}],"criteria":[{"marks":1,"point":"Expands","line":"(x+2)^2-x^2"},{"marks":1,"point":"4x + 4","answer":true}]},{"id":"A12-F2-031","group":"A12-F2-031","dp":"F2.1a","authored":1,"level":1,"marks":1,"title":"Moving a maximum point","prompt":"The graph of $y=f(x)$ has a maximum at $(1,4)$. Find the maximum point of $y=f(x-2)+1$.","answerType":"point","answer":{"x":3,"y":5},"hints":["x − 2 shifts the graph right.","+1 shifts it up.","Apply to the point."],"ladder":{"nudge":"x − 2 shifts the graph right.","method":"+1 shifts it up.","worked":"Apply to the point."},"steps":[{"h":"Translate","d":"Right $2$, up $1$"}],"traps":[{"point":[-1,5],"why":"x − 2 shifts right."}],"criteria":[{"marks":1,"point":"(3, 5)","answer":true}]},{"id":"A12-F2-034","group":"A12-F2-034","dp":"F2.1e","authored":1,"level":1,"marks":2,"title":"Absolute value at most five","prompt":"Solve $|2x-3|\\le5$.","answerType":"interval","answer":{"region":"-1 <= x <= 4","variable":"x"},"hints":["|u| ≤ 5 means −5 ≤ u ≤ 5.","Add 3.","Divide by 2."],"ladder":{"nudge":"|u| ≤ 5 means −5 ≤ u ≤ 5.","method":"Add 3.","worked":"$-5\\le2x-3\\le5$"},"steps":[{"h":"Unwrap","d":"$-5\\le2x-3\\le5$"},{"h":"Solve","d":"$-1\\le x\\le4$"}],"traps":[{"region":"x <= -1 or x >= 4","why":"That is |2x − 3| ≥ 5."}],"criteria":[{"marks":1,"point":"Double inequality","manual":true},{"marks":1,"point":"−1 ≤ x ≤ 4","answer":true}]},{"id":"A12-F2-036","group":"A12-F2-036","dp":"F2.1c","authored":1,"level":1,"marks":1,"title":"Reflect and lift a point","prompt":"The point $(3,-2)$ lies on $y=f(x)$. Find the corresponding point on $y=-f(x)+1$.","answerType":"point","answer":{"x":3,"y":3},"hints":["x is unchanged.","Negate y.","Add 1."],"ladder":{"nudge":"x is unchanged.","method":"Negate y.","worked":"Add 1."},"steps":[{"h":"Map","d":"$y\\mapsto-y+1$: $2+1=3$"}],"traps":[{"point":[3,-1],"why":"Reflect first, then add 1."}],"criteria":[{"marks":1,"point":"(3, 3)","answer":true}]},{"id":"A12-F2-040","group":"A12-F2-040","dp":"F2.1e","authored":1,"level":1,"marks":1,"title":"Exponential above a constant","prompt":"Solve $e^{x}>2$.","answerType":"interval","answer":{"region":"x > ln(2)","variable":"x"},"hints":["Take natural logs.","ln is increasing.","Keep the sign."],"ladder":{"nudge":"Take natural logs.","method":"ln is increasing.","worked":"Keep the sign."},"steps":[{"h":"Logs","d":"ln is increasing: $x>\\ln2$"}],"traps":[{"region":"x < ln(2)","why":"eˣ increases, so the inequality keeps its direction."}],"criteria":[{"marks":1,"point":"x > ln 2","answer":true}]},{"id":"A12-F2-041","group":"A12-F2-041","dp":"F2.1a","authored":1,"level":1,"marks":2,"title":"Roots of a translated parabola","prompt":"Solve $(x-1)^{2}-4=0$, and describe the graph of $y=(x-1)^{2}-4$ as a transformation of $y=x^{2}$.","answerType":"set","answer":{"values":[-1,3]},"answerPrefix":"x =","hints":["Add 4.","Take ± roots.","Read h and k."],"ladder":{"nudge":"Add 4.","method":"Take ± roots.","worked":"$x-1=\\pm2$"},"steps":[{"h":"Solve","d":"$x-1=\\pm2$"},{"h":"Transformation","d":"Right $1$, down $4$"}],"traps":[{"values":[3],"why":"Use both square roots."}],"criteria":[{"marks":1,"point":"Transformation","manual":true},{"marks":1,"point":"Both roots","answer":true}]},{"id":"A12-F2-044","group":"A12-F2-044","dp":"F2.1d","authored":1,"level":1,"marks":1,"title":"Image of the y-intercept","prompt":"Find the image of the point $(0,1)$ on $y=e^{x}$ under the transformation to $y=3e^{x-2}$.","answerType":"point","answer":{"x":2,"y":3},"hints":["x − 2 moves right 2.","Multiply y by 3.","Apply to (0, 1)."],"ladder":{"nudge":"x − 2 moves right 2.","method":"Multiply y by 3.","worked":"Apply to (0, 1)."},"steps":[{"h":"Map","d":"Right $2$, triple heights"}],"traps":[{"point":[-2,3],"why":"x − 2 shifts right."}],"criteria":[{"marks":1,"point":"(2, 3)","answer":true}]},{"id":"A12-F2-045","group":"A12-F2-045","dp":"F2.1a","authored":2,"level":2,"marks":2,"title":"New intercept after a shift","prompt":"The parabola $y=2x^{2}$ is translated so its vertex is $(1,-3)$. Find the $y$-intercept of the new parabola.","answerType":"numeric","answer":{"value":-1},"hints":["Write vertex form.","Put x = 0.","Simplify."],"ladder":{"nudge":"Write vertex form.","method":"Put x = 0.","worked":"$y=2(x-1)^{2}-3$"},"steps":[{"h":"Equation","d":"$y=2(x-1)^{2}-3$"},{"h":"Intercept","d":"$2-3=-1$"}],"traps":[{"value":-3,"why":"That is the vertex height."}],"criteria":[{"marks":1,"point":"Vertex form","line":"y = 2*(x-1)^2-3"},{"marks":1,"point":"−1","answer":true}]},{"id":"A12-F2-046","group":"A12-F2-046","dp":"F2.1e","authored":3,"level":3,"marks":2,"title":"Absolute value equal to a line","prompt":"Solve $2|x-1|=x+1$.","answerType":"set","answer":{"values":[0.3333333333333333,3]},"answerPrefix":"x =","hints":["Split into cases.","Solve each.","Check x + 1 ≥ 0."],"ladder":{"nudge":"Split into cases.","method":"Solve each.","worked":"Check x + 1 ≥ 0."},"steps":[{"h":"Positive","d":"$2x-2=x+1\\Rightarrow x=3$"},{"h":"Negative","d":"$2-2x=x+1\\Rightarrow x=\\tfrac13$"}],"traps":[{"values":[3],"why":"Missed the negative case."}],"criteria":[{"marks":1,"point":"One solution","line":"x = 3"},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-F2-047","group":"A12-F2-047","dp":"F2.1a","authored":2,"level":2,"marks":1,"title":"Area under a lifted graph","prompt":"The area between $y=f(x)$ and the $x$-axis for $0\\le x\\le2$ is $6$, with $f(x)\\ge0$. Find the area between $y=f(x)+2$ and the $x$-axis for $0\\le x\\le2$.","answerType":"numeric","answer":{"value":10},"hints":["Lifting adds a rectangle.","Width 2, height 2.","Add."],"ladder":{"nudge":"Lifting adds a rectangle.","method":"Width 2, height 2.","worked":"Add."},"steps":[{"h":"Add a rectangle","d":"$6+2\\times2$"}],"traps":[{"value":8,"why":"The added strip is 2 by 2."}],"criteria":[{"marks":1,"point":"10","answer":true}]},{"id":"A12-F2-050","group":"A12-F2-050","dp":"F2.1e","authored":2,"level":2,"marks":1,"title":"Counting sine crossings over two periods","prompt":"How many solutions does $\\sin x=0.3$ have for $0\\le x\\le4\\pi$?","answerType":"numeric","answer":{"value":4},"hints":["Period 2π.","Two solutions per period.","Two periods."],"ladder":{"nudge":"Period 2π.","method":"Two solutions per period.","worked":"Two periods."},"steps":[{"h":"Count","d":"Two per period, two periods"}],"traps":[{"value":2,"why":"The domain covers two periods."}],"criteria":[{"marks":1,"point":"4","answer":true}]},{"id":"A12-F2-051","group":"A12-F2-051","dp":"F2.1a","authored":2,"level":2,"marks":1,"title":"Intercept of a shifted hyperbola","prompt":"Find the $x$-intercept of $y=\\dfrac{1}{x-2}+3$.","answerType":"numeric","answer":{"value":1.6666666666666667},"answerPrefix":"x =","hints":["Set y = 0.","Isolate the fraction.","Invert."],"ladder":{"nudge":"Set y = 0.","method":"Isolate the fraction.","worked":"Invert."},"steps":[{"h":"Solve","d":"$\\tfrac{1}{x-2}=-3\\Rightarrow x-2=-\\tfrac13$"}],"traps":[{"value":2.3333333333333335,"why":"Sign error.","expr":"7/3"}],"criteria":[{"marks":1,"point":"5/3","answer":true}]},{"id":"A12-F2-056","group":"A12-F2-056","dp":"F2.1d","authored":2,"level":2,"marks":1,"title":"Image point after a dilation and translation","prompt":"The point $(2,5)$ lies on $y=f(x)$. Find the corresponding point on $y=3f(x-1)+2$.","answerType":"point","answer":{"x":3,"y":17},"hints":["Horizontal shift right 1.","Multiply y by 3.","Add 2."],"ladder":{"nudge":"Horizontal shift right 1.","method":"Multiply y by 3.","worked":"Add 2."},"steps":[{"h":"Transform","d":"$x\\to x+1$, $y\\to3y+2$"}],"traps":[{"point":[1,17],"why":"x − 1 shifts right."}],"criteria":[{"marks":1,"point":"(3, 17)","answer":true}]},{"id":"A12-F2-060","group":"A12-F2-060","dp":"F2.1b","authored":1,"level":1,"marks":1,"title":"Vertical dilation of a log graph","prompt":"The graph of $y=\\ln x$ is dilated vertically by factor $2$. Find the $y$-value at $x=e^{3}$ on the new graph.","answerType":"numeric","answer":{"value":6},"hints":["y = 2 ln x.","ln e³ = 3.","Double."],"ladder":{"nudge":"y = 2 ln x.","method":"ln e³ = 3.","worked":"Double."},"steps":[{"h":"New graph","d":"$y=2\\ln x$"}],"traps":[{"value":3,"why":"Multiply by 2."}],"criteria":[{"marks":1,"point":"6","answer":true}]},{"id":"A12-F2-064","group":"A12-F2-064","dp":"F2.1c","authored":2,"level":2,"marks":2,"title":"Equation with a reflected exponential","prompt":"Solve $e^{x}=e^{-x}+\\tfrac32$.","answerType":"numeric","answer":{"value":0.6931471805599453},"answerPrefix":"x =","hints":["Multiply by eˣ.","Let u = eˣ.","u > 0."],"ladder":{"nudge":"Multiply by eˣ.","method":"Let u = eˣ.","worked":"$2u^{2}-3u-2=0$ with $u=e^{x}$"},"steps":[{"h":"Quadratic","d":"$2u^{2}-3u-2=0$ with $u=e^{x}$"},{"h":"Solve","d":"$u=2$ (reject $-\\tfrac12$)"}],"traps":[{"value":2,"why":"That is eˣ."}],"criteria":[{"marks":1,"point":"Quadratic in u","line":"2*u^2-3*u-2 = 0"},{"marks":1,"point":"x = ln 2","answer":true}]},{"id":"A12-F2-067","group":"A12-F2-067","dp":"F2.1e","authored":3,"level":3,"marks":2,"title":"Number of solutions with a reciprocal and a line","prompt":"How many solutions does $\\dfrac{1}{x}=x-1$ have? Find them exactly.","answerType":"set","answer":{"values":[1.618033988749895,-0.6180339887498949]},"answerPrefix":"x =","hints":["Multiply by x.","Quadratic formula.","Two solutions."],"ladder":{"nudge":"Multiply by x.","method":"Quadratic formula.","worked":"Two solutions."},"steps":[{"h":"Quadratic","d":"$x^{2}-x-1=0$"}],"traps":[{"values":["(1+sqrt(5))/2"],"why":"There are two branches."}],"criteria":[{"marks":1,"point":"Quadratic","line":"x^2-x-1 = 0"},{"marks":1,"point":"Both","answer":true}]},{"id":"A12-F2-068","group":"A12-F2-068","dp":"F2.1d","authored":1,"level":1,"marks":1,"title":"Range of a transformed exponential","prompt":"State the range of $y=3-2e^{x}$.","answerType":"interval","answer":{"region":"y < 3","variable":"y"},"hints":["eˣ > 0.","So −2eˣ < 0.","Add 3."],"ladder":{"nudge":"eˣ > 0.","method":"So −2eˣ < 0.","worked":"Add 3."},"steps":[{"h":"Exponential positive","d":"$2e^{x}>0$"}],"traps":[{"region":"y > 3","why":"Subtracting a positive."}],"criteria":[{"marks":1,"point":"y < 3","answer":true}]},{"id":"A12-F2-070","group":"A12-F2-070","dp":"F2.1e","authored":3,"level":3,"marks":2,"title":"Intersections of a circle and a parabola","prompt":"Find the number of intersections of $x^{2}+y^{2}=4$ and $y=x^{2}-2$.","answerType":"numeric","answer":{"value":3},"hints":["x² = y + 2.","Substitute.","Count points for each y."],"ladder":{"nudge":"x² = y + 2.","method":"Substitute.","worked":"$y+2+y^{2}=4\\Rightarrow y^{2}+y-2=0$"},"steps":[{"h":"Substitute","d":"$y+2+y^{2}=4\\Rightarrow y^{2}+y-2=0$"},{"h":"Solve","d":"$y=1$ (two points) or $y=-2$ (one point)"}],"traps":[{"value":4,"why":"y = −2 gives only x = 0."}],"criteria":[{"marks":1,"point":"Quadratic in y","line":"y^2+y-2 = 0"},{"marks":1,"point":"3","answer":true}]},{"id":"A12-F2-081","group":"A12-F2-081","dp":"F2.1a","authored":2,"level":2,"marks":1,"title":"Domain of a log with a quadratic argument","prompt":"Find the domain of $y=\\ln(9-x^{2})$.","answerType":"interval","answer":{"region":"-3 < x < 3","variable":"x"},"hints":["Argument positive.","x² < 9.","Open interval."],"ladder":{"nudge":"Argument positive.","method":"x² < 9.","worked":"Open interval."},"steps":[{"h":"Positive","d":"$9-x^{2}>0$"}],"traps":[{"region":"-3 <= x <= 3","why":"Strict: ln 0 is undefined."}],"criteria":[{"marks":1,"point":"−3 < x < 3","answer":true}]},{"id":"A12-F2-089","group":"A12-F2-089","dp":"F2.1c","authored":3,"level":3,"marks":1,"title":"Function equal to its reflection","prompt":"Find the values of $k$ for which $y=x^{2}+kx+1$ is unchanged by reflection in the $y$-axis.","answerType":"numeric","answer":{"value":0},"answerPrefix":"k =","hints":["Replace x by −x.","Compare."],"ladder":{"nudge":"Replace x by −x.","method":"Compare.","worked":"Even"},"steps":[{"h":"Even","d":"$x^{2}-kx+1=x^{2}+kx+1$"}],"traps":[{"value":1,"why":"The x term must vanish."}],"criteria":[{"marks":1,"point":"k = 0","answer":true}]},{"id":"A12-F2-099","group":"A12-F2-099","dp":"F2.1b","authored":4,"level":4,"marks":2,"title":"Dilation preserving an area relationship","prompt":"The region under $y=f(x)$ from $0$ to $2$ has area $5$. Find the area under $y=3f(2x)$ from $0$ to $1$.","answerType":"numeric","answer":{"value":7.5},"hints":["x → 2x halves widths.","×3 heights.","5 × 3 ÷ 2."],"ladder":{"nudge":"x → 2x halves widths.","method":"×3 heights.","worked":"Compress by $\\tfrac12$: area halves"},"steps":[{"h":"Horizontal","d":"Compress by $\\tfrac12$: area halves"},{"h":"Vertical","d":"Stretch by $3$: area triples"}],"traps":[{"value":30,"why":"Horizontal compression halves the area."}],"criteria":[{"marks":1,"point":"Both effects","manual":true},{"marks":1,"point":"15/2","answer":true}]},{"id":"A12-F2-101","group":"A12-F2-101","dp":"F2.1b","authored":1,"level":1,"marks":1,"title":"Dilations on a sketch of a cubic","prompt":"The graph of $y=x^{3}$ is dilated vertically by $\\tfrac12$. Find the image of $(2,8)$.","answerType":"point","answer":{"x":2,"y":4},"hints":["Vertical dilation changes y.","Halve.","x unchanged."],"ladder":{"nudge":"Vertical dilation changes y.","method":"Halve.","worked":"x unchanged."},"steps":[{"h":"Halve y","d":"$8\\to4$"}],"traps":[{"point":[1,8],"why":"That is horizontal."}],"criteria":[{"marks":1,"point":"(2, 4)","answer":true}]},{"id":"A12-F2-102","group":"A12-F2-102","dp":"F2.1c","authored":2,"level":2,"marks":1,"title":"Reflection of a cubic in the y-axis","prompt":"The graph of $y=x^{3}-2x^{2}$ is reflected in the $y$-axis. Write the new equation.","answerType":"equation","answer":{"lhs":"y","rhs":"-x^3-2*x^2"},"hints":["Replace x by −x.","(−x)³ = −x³.","(−x)² = x²."],"ladder":{"nudge":"Replace x by −x.","method":"(−x)³ = −x³.","worked":"(−x)² = x²."},"steps":[{"h":"Replace","d":"$x\\to-x$"}],"traps":[{"eq":"y = -x^3+2*x^2","why":"That is reflection in the x-axis."}],"criteria":[{"marks":1,"point":"Equation","answer":true}]},{"id":"A12-F2-109","group":"A12-F2-109","dp":"F2.1d","authored":3,"level":3,"marks":1,"title":"Order of transformations on a point","prompt":"The point $(4,-2)$ is on $y=f(x)$. Find its image on $y=-2f\\left(\\tfrac x2\\right)+1$.","answerType":"point","answer":{"x":8,"y":5},"hints":["x doubles.","y multiplied by −2.","Add 1."],"ladder":{"nudge":"x doubles.","method":"y multiplied by −2.","worked":"Add 1."},"steps":[{"h":"Transform","d":"$x\\to2x$, $y\\to-2y+1$"}],"traps":[{"point":[2,5],"why":"x/2 stretches horizontally by 2."}],"criteria":[{"marks":1,"point":"(8, 5)","answer":true}]}]}
