# Pri Learning builds and the generated native web bundles must be byte-stable across OSes.
* text=auto

*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.swift text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary

# The CI check-count manifest merges one pin at a time when the local driver is
# configured (docs/release/ci-lanes.md):
#   git config merge.pri-check-counts.driver 'node tools/ci-check-counts.mjs merge %O %A %B'
# Without that config git falls back to its ordinary text merge.
ci/check-counts.json merge=pri-check-counts
