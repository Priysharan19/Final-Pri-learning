# Pri Learning builds and tracked native web bundles must be byte-stable across OSes.
* text=auto

*.html text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.jsx text eol=lf
*.css text eol=lf
*.json text eol=lf
*.webmanifest text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.swift text eol=lf
*.svg text eol=lf

*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
